{#
  Segment selection is a plain list, so `PID[0]` is the first PID segment.
  Fields, components and subcomponents use HL7 numbering: `PID[0][5][1]` is
  PID-5.1, the family name, and `PID[0][3][1]` is PID-3.1, the MRN.
#}
{
  "resourceType": "Bundle",
  "type": "transaction",
  "entry": [
    {
      "request": {
        "method": "POST",
        "url": "MessageHeader"
      },
      "resource": {% with hl7v2=hl7v2 %}{% include 'partial/MSH' %}{% endwith %}
    },
    {
      "request": {
        "method": "POST",
        "url": "Patient"
      },
      "resource": {
        "resourceType": "Patient",
            "name" : [
                {
                    "family" : "{{ hl7v2.PID[0][5][1] }}",
                    "given" : [ "{{ hl7v2.PID[0][5][2] }}" ]
                }
            ],
            "identifier": [
                {
                    "use": "usual",
                    "type": {
                        "coding": [
                            {
                                "system": "http://terminology.hl7.org/CodeSystem/v2-0203",
                                "code": "MR"
                            }
                        ]
                    },
                    "value": "{{ hl7v2.PID[0][3][1] }}"
                }
            ]
        }
    }]
}
