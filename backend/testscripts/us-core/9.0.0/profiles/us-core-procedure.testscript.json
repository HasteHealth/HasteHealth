        },
        {
            "id": "02-required-missing-code",
            "name": "Refuses Procedure without code",
            "description": "US Core Procedure Profile requires Procedure.code (at least 1); base FHIR leaves it optional. Without it the resource is refused.",
            "action": [
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "create"
                        },
                        "encodeRequestUrl": false,
                        "extension": [
                            {
