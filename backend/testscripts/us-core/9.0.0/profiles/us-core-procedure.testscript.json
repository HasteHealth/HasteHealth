                                "url": "https://haste.health/fhir/StructureDefinition/testscript-category",
                                "extension": [
                                    {
                                        "url": "group",
                                        "valueCode": "create"
                                    }
                                ]
                            }
                        ]
                    }
                },
                {
                    "assert": {
                        "expression": "OperationOutcome.issue.where(severity = 'error').where(diagnostics.contains('Procedure.code')).where(diagnostics.contains('Minimum number of required values')).exists()",
