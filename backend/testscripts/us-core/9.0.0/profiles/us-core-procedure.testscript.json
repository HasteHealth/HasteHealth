                    "assert": {
                        "label": "refused-422",
                        "responseCode": "422",
                        "warningOnly": false,
                        "extension": [
                            {
                                "url": "https://haste.health/fhir/StructureDefinition/testscript-category",
                                "extension": [
                                    {
                                        "url": "group",
                                        "valueCode": "create"
                                    }
