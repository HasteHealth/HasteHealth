                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "create"
                        },
                        "encodeRequestUrl": false,
                        "extension": [
                            {
                                "url": "https://haste.health/fhir/StructureDefinition/testscript-category",
                                "extension": [
                                    {
                                        "url": "group",
                                        "valueCode": "create"
                                    }
                                ]
                            }
                        ],
                        "resource": "Procedure",
                        "sourceId": "fixture-uscore-create-1",
                        "responseId": "create-response"
                    }
                },
                {
                    "assert": {
                        "resource": "Procedure",
                        "direction": "response",
                        "warningOnly": false,
                        "label": "create-ok",
                        "extension": [
                            {
                                "url": "https://haste.health/fhir/StructureDefinition/testscript-category",
                                "extension": [
                                    {
                                        "url": "group",
                                        "valueCode": "create"
                                    }
                                ]
                            }
                        ]
                    }
                },
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "read"
                        },
                        "encodeRequestUrl": false,
                        "extension": [
                            {
                                "url": "https://haste.health/fhir/StructureDefinition/testscript-category",
                                "extension": [
                                    {
                                        "url": "group",
                                        "valueCode": "read"
                                    }
                                ]
                            }
                        ],
                        "targetId": "create-response",
                        "responseId": "read-response"
                    }
                },
                {
                    "assert": {
                        "expression": "Procedure.status.exists()",
                        "warningOnly": false,
                        "label": "has-status",
                        "operator": "equals",
                        "value": "true",
                        "extension": [
                            {
                                "url": "https://haste.health/fhir/StructureDefinition/testscript-category",
                                "extension": [
                                    {
                                        "url": "group",
                                        "valueCode": "read"
                                    }
                                ]
                            }
                        ]
                    }
                },
                {
                    "assert": {
                        "expression": "Procedure.code.exists()",
                        "warningOnly": false,
                        "label": "has-code",
                        "operator": "equals",
                        "value": "true",
                        "extension": [
                            {
                                "url": "https://haste.health/fhir/StructureDefinition/testscript-category",
                                "extension": [
                                    {
                                        "url": "group",
                                        "valueCode": "read"
                                    }
                                ]
                            }
                        ]
                    }
                },
                {
                    "assert": {
                        "expression": "Procedure.subject.exists()",
                        "warningOnly": false,
                        "label": "has-subject",
                        "operator": "equals",
                        "value": "true",
                        "extension": [
                            {
                                "url": "https://haste.health/fhir/StructureDefinition/testscript-category",
                                "extension": [
                                    {
                                        "url": "group",
                                        "valueCode": "read"
                                    }
                                ]
                            }
                        ]
                    }
                },
                {
                    "assert": {
                        "expression": "Procedure.encounter.exists()",
                        "warningOnly": false,
                        "label": "has-encounter",
                        "operator": "equals",
                        "value": "true",
                        "extension": [
                            {
                                "url": "https://haste.health/fhir/StructureDefinition/testscript-category",
                                "extension": [
                                    {
                                        "url": "group",
                                        "valueCode": "read"
                                    }
                                ]
                            }
                        ]
                    }
                },
                {
                    "assert": {
                        "expression": "Procedure.meta.profile.exists($this = 'http://hl7.org/fhir/us/core/StructureDefinition/us-core-procedure')",
                        "warningOnly": false,
