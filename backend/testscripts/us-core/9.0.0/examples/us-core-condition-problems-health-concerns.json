    "test": [
        {
            "id": "problem-list-item",
            "name": "Problem list item",
            "description": "A Condition whose category is problem-list-item (THO CodeSystem) is created.",
            "action": [
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "create"
                        },
                        "resource": "Condition",
                        "sourceId": "problem-list-item",
                        "responseId": "problem-list-item-response",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "label": "Created",
                        "responseCode": "201",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "label": "A Condition is returned",
                        "direction": "response",
                        "resource": "Condition",
                        "warningOnly": false
                    }
                }
            ]
        },
        {
            "id": "health-concern",
            "name": "Health concern",
            "description": "A Condition whose category is health-concern (US Core CodeSystem) is created.",
            "action": [
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "create"
                        },
                        "resource": "Condition",
                        "sourceId": "health-concern",
                        "responseId": "health-concern-response",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "label": "Created",
                        "responseCode": "201",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "label": "A Condition is returned",
                        "direction": "response",
                        "resource": "Condition",
                        "warningOnly": false
                    }
                }
            ]
        },
        {
            "id": "encounter-diagnosis",
            "name": "Encounter diagnosis is refused",
            "description": "A Condition whose only category is encounter-diagnosis does not fill Condition.category:us-core and is refused.",
            "action": [
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "create"
                        },
                        "resource": "Condition",
                        "sourceId": "encounter-diagnosis",
                        "responseId": "encounter-diagnosis-response",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "label": "Profile violation is 422",
                        "responseCode": "422",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "label": "The issue names the slice",
                        "expression": "OperationOutcome.issue.where(diagnostics.contains('Condition.category:us-core')).exists()",
                        "operator": "equals",
                        "value": "true",
                        "warningOnly": false
                    }
                }
            ]
        }
