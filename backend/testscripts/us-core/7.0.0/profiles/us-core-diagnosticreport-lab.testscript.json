        {
            "id": "02-required-missing-category",
            "name": "Refuses DiagnosticReport without category",
            "description": "US Core DiagnosticReport Profile for Laboratory Results Reporting requires DiagnosticReport.category (at least 1); base FHIR leaves it optional. Without it the resource is refused.",
            "action": [
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "create"
                        },
                        "encodeRequestUrl": false,
                        "extension": [
                            {
                                "url": "https://haste.health/fhir/StructureDefinition/testscript-category",
                                "extension": [
                                    {
                                        "url": "group",
                                        "valueCode": "create"
                                    }
                                ]
                            }
                        ],
                        "resource": "DiagnosticReport",
                        "sourceId": "fixture-profile-reject-2",
                        "responseId": "profile-reject-2-response"
                    }
                },
                {
                    "assert": {
                        "label": "refused-422",
                        "responseCode": "422",
                        "warningOnly": false,
                        "extension": [
                            {
                                "url": "https://haste.health/fhir/StructureDefinition/testscript-category",
                                "extension": [
                                    {
                                        "url": "group",
                                        "valueCode": "create"
                                    }
                                ]
                            }
                        ]
                    }
                },
                {
                    "assert": {
                        "resource": "OperationOutcome",
                        "direction": "response",
                        "warningOnly": false,
                        "label": "outcome-returned",
                        "extension": [
                            {
                                "url": "https://haste.health/fhir/StructureDefinition/testscript-category",
                                "extension": [
                                    {
                                        "url": "group",
                                        "valueCode": "create"
                                    }
                                ]
                            }
                        ]
                    }
                },
                {
                    "assert": {
                        "expression": "OperationOutcome.issue.where(severity = 'error').where(diagnostics.contains('DiagnosticReport.category')).where(diagnostics.contains('Minimum number of required values')).exists()",
                        "warningOnly": false,
                        "label": "issue-names-rule",
                        "operator": "equals",
                        "value": "true",
                        "extension": [
                            {
                                "url": "https://haste.health/fhir/StructureDefinition/testscript-category",
                                "extension": [
                                    {
                                        "url": "group",
