                                        "url": "group",
                                        "valueCode": "create"
                                    }
                                ]
                            }
                        ],
                        "resource": "CarePlan",
                        "sourceId": "fixture-profile-reject-2",
                        "responseId": "profile-reject-2-response"
                    }
                },
                {
                    "assert": {
                        "label": "refused-422",
                        "responseCode": "422",
                        "warningOnly": false,
                        "extension": [
                            {
                                "url": "https://haste.health/fhir/StructureDefinition/testscript-category",
                                "extension": [
                                    {
                                        "url": "group",
                                        "valueCode": "create"
                                    }
                                ]
                            }
                        ]
                    }
                },
                {
                    "assert": {
                        "resource": "OperationOutcome",
                        "direction": "response",
                        "warningOnly": false,
                        "label": "outcome-returned",
                        "extension": [
                            {
                                "url": "https://haste.health/fhir/StructureDefinition/testscript-category",
                                "extension": [
