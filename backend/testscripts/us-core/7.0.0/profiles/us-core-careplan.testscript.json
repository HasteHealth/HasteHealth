        {
            "id": "02-required-missing-category",
            "name": "Refuses CarePlan without category",
            "description": "US Core CarePlan Profile requires CarePlan.category (at least 1); base FHIR leaves it optional. Without it the resource is refused.",
            "action": [
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "create"
                        },
                        "encodeRequestUrl": false,
                        "extension": [
                            {
                                "url": "https://haste.health/fhir/StructureDefinition/testscript-category",
                                "extension": [
