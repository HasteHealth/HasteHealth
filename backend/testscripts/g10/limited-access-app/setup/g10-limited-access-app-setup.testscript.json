{
    "id": "g10-limited-access-app-setup",
    "url": "https://haste.health/fhir/TestScript/g10-limited-access-app-setup",
    "name": "g10 limited-access-app setup",
    "title": "g10 limited-access-app: login",
    "status": "active",
    "description": "Run as admin. The login for g10 scenario 2: a second member User linked to Patient/g10-example, a full-access policy, and a public client allowed only patient/Patient.rs, patient/Condition.rs and patient/Observation.rs.",
    "resourceType": "TestScript",
    "contained": [
        {
            "id": "g10-limited-user",
            "resourceType": "User",
            "meta": {
                "tag": [
                    {
                        "system": "https://haste.health/fhir/testscript",
                        "code": "g10"
                    }
                ]
            },
            "role": "member",
            "email": "g10-limited@example.org"
        },
        {
            "id": "g10-limited-user-membership",
            "resourceType": "Membership",
            "meta": {
                "tag": [
                    {
                        "system": "https://haste.health/fhir/testscript",
                        "code": "g10"
                    }
                ]
            },
            "user": {
                "reference": "User/g10-limited-user"
            },
            "link": {
                "reference": "Patient/g10-example"
            }
        },
        {
            "id": "g10-limited-user-policy",
            "resourceType": "AccessPolicyV2",
            "meta": {
                "tag": [
                    {
                        "system": "https://haste.health/fhir/testscript",
                        "code": "g10"
                    }
                ]
            },
            "name": "g10: limited-access-app",
            "description": "Full access, so only the SMART scopes limit this login.",
            "engine": "full-access"
        },
        {
            "id": "g10-limited-user-policy-assignment",
            "resourceType": "AccessPolicyV2Assignment",
            "meta": {
                "tag": [
                    {
                        "system": "https://haste.health/fhir/testscript",
                        "code": "g10"
                    }
                ]
            },
            "accessPolicy": {
                "reference": "AccessPolicyV2/g10-limited-user-policy"
            },
            "link": {
                "reference": "Membership/g10-limited-user-membership"
            }
        },
        {
            "id": "g10-limited-app",
            "resourceType": "ClientApplication",
            "meta": {
                "tag": [
                    {
                        "system": "https://haste.health/fhir/testscript",
                        "code": "g10"
                    }
                ]
            },
            "name": "g10: limited access app",
            "grantType": [
                "authorization_code",
                "refresh_token"
            ],
            "responseTypes": "code",
            "redirectUri": [
                "http://127.0.0.1:8976/callback"
            ],
            "scope": "launch/patient openid fhirUser offline_access patient/Patient.rs patient/Condition.rs patient/Observation.rs"
        }
    ],
    "fixture": [
        {
            "id": "fixture-g10-limited-user",
            "resource": {
                "reference": "#g10-limited-user"
            },
            "autocreate": false,
            "autodelete": false
        },
        {
            "id": "fixture-g10-limited-user-membership",
            "resource": {
                "reference": "#g10-limited-user-membership"
            },
            "autocreate": false,
            "autodelete": false
        },
        {
            "id": "fixture-g10-limited-user-policy",
            "resource": {
                "reference": "#g10-limited-user-policy"
            },
            "autocreate": false,
            "autodelete": false
        },
        {
            "id": "fixture-g10-limited-user-policy-assignment",
            "resource": {
                "reference": "#g10-limited-user-policy-assignment"
            },
            "autocreate": false,
            "autodelete": false
        },
        {
            "id": "fixture-g10-limited-app",
            "resource": {
                "reference": "#g10-limited-app"
