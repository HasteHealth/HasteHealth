                            "code": "update"
                        },
                        "resource": "User",
                        "targetId": "fixture-g10-limited-user",
                        "sourceId": "fixture-g10-limited-user",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "description": "User/g10-limited-user is written",
                        "resource": "User",
                        "warningOnly": false
                    }
                },
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "update"
                        },
                        "resource": "Membership",
                        "targetId": "fixture-g10-limited-user-membership",
