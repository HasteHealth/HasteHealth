                    }
                },
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "update"
                        },
                        "resource": "ClientApplication",
                        "targetId": "fixture-g10-limited-app",
                        "sourceId": "fixture-g10-limited-app",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "description": "ClientApplication/g10-limited-app is written",
