                        "warningOnly": false
                    }
                },
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "update"
                        },
                        "resource": "AccessPolicyV2",
                        "targetId": "fixture-g10-limited-user-policy",
                        "sourceId": "fixture-g10-limited-user-policy",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "description": "AccessPolicyV2/g10-limited-user-policy is written",
                        "resource": "AccessPolicyV2",
                        "warningOnly": false
                    }
                },
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "update"
                        },
                        "resource": "AccessPolicyV2Assignment",
                        "targetId": "fixture-g10-limited-user-policy-assignment",
                        "sourceId": "fixture-g10-limited-user-policy-assignment",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "description": "AccessPolicyV2Assignment/g10-limited-user-policy-assignment is written",
