{
    "id": "g10-2.3.02-allergyintolerance-restricted",
    "url": "https://haste.health/fhir/TestScript/g10-2.3.02-allergyintolerance-restricted",
    "name": "g10-2.3.02-allergyintolerance-restricted",
    "title": "2.3.02 Access to AllergyIntolerance restricted to the granted scopes",
    "status": "active",
    "description": "g10 2.3.02 (AUT-PAT-10, AUT-PAT-12, AUT-PAT-18, AUT-PAT-33, AUT-PAT-34, DAT-PAT-9). The app requested every US Core type and the user granted only Patient, Condition and Observation at consent. GET AllergyIntolerance?patient=g10-example is refused with 401 or 403.",
    "resourceType": "TestScript",
    "test": [
        {
            "id": "01",
            "name": "2.3.02 Access to AllergyIntolerance restricted to the granted scopes",
            "action": [
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "search"
                        },
                        "resource": "AllergyIntolerance",
                        "params": "patient=g10-example",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "description": "The AllergyIntolerance search is refused",
                        "responseCode": "401,403",
                        "operator": "in",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "The refusal is forbidden",
                        "expression": "OperationOutcome.issue.where(code = 'forbidden').exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                }
            ]
        }
    ]
}
