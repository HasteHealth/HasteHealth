{
    "id": "g10-2.3.01-patient-restricted",
    "url": "https://haste.health/fhir/TestScript/g10-2.3.01-patient-restricted",
    "name": "g10-2.3.01-patient-restricted",
    "title": "2.3.01 Access to Patient restricted to the granted scopes",
    "status": "active",
    "description": "g10 2.3.01 (AUT-PAT-10, AUT-PAT-12, AUT-PAT-18, AUT-PAT-33, AUT-PAT-34, DAT-PAT-9). The app requested every US Core type and the user granted only Patient, Condition and Observation at consent. GET Patient?_id=g10-example answers 200, with only the launch patient's data.",
    "resourceType": "TestScript",
    "test": [
        {
            "id": "01",
            "name": "2.3.01 Access to Patient restricted to the granted scopes",
            "action": [
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "search"
                        },
                        "resource": "Patient",
                        "params": "_id=g10-example",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "description": "Patient search is allowed",
                        "responseCode": "200",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "A searchset Bundle is returned",
                        "resource": "Bundle",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Every Patient returned is the launch patient's",
                        "expression": "Bundle.entry.resource.ofType(Patient).all(id = 'g10-example')",
                        "value": "true",
                        "warningOnly": false
                    }
                }
            ]
        }
    ]
}
