{
    "id": "g10-2.3.05-condition-restricted",
    "url": "https://haste.health/fhir/TestScript/g10-2.3.05-condition-restricted",
    "name": "g10-2.3.05-condition-restricted",
    "title": "2.3.05 Access to Condition restricted to the granted scopes",
    "status": "active",
    "description": "g10 2.3.05 (AUT-PAT-10, AUT-PAT-12, AUT-PAT-18, AUT-PAT-33, AUT-PAT-34, DAT-PAT-9). The user granted only Patient, Condition and Observation (the scenario requests just those scopes; a TestScript cannot use the consent screen). GET Condition?patient=g10-example answers 200, with only the launch patient's data.",
    "resourceType": "TestScript",
    "test": [
        {
            "id": "01",
            "name": "2.3.05 Access to Condition restricted to the granted scopes",
            "action": [
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "search"
                        },
                        "resource": "Condition",
                        "params": "patient=g10-example",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "description": "Condition search is allowed",
                        "responseCode": "200",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "A searchset Bundle is returned",
                        "resource": "Bundle",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Every Condition returned is the launch patient's",
                        "expression": "Bundle.entry.resource.ofType(Condition).all(subject.reference = 'Patient/g10-example')",
                        "value": "true",
                        "warningOnly": false
                    }
                }
            ]
        }
    ]
}
