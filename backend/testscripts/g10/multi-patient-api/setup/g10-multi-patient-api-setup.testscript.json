{
    "id": "g10-multi-patient-api-setup",
    "url": "https://haste.health/fhir/TestScript/g10-multi-patient-api-setup",
    "name": "g10 Multi-Patient API Setup",
    "title": "g10 Multi-Patient API: data and client",
    "status": "active",
    "description": "Run as admin. Writes the Group the bulk export runs over (three patients from the shared g10 record) and the bulk data client: a client-credentials ClientApplication allowed system/*.rs with a full-access policy. Its secret is set in the sign-in phase.",
    "resourceType": "TestScript",
    "contained": [
        {
            "id": "g10-bulk-group",
            "resourceType": "Group",
            "meta": {
                "tag": [
                    {
                        "system": "https://haste.health/fhir/testscript",
                        "code": "g10"
                    }
                ]
            },
            "type": "person",
            "actual": true,
            "name": "g10 bulk export cohort",
            "member": [
                {
                    "entity": {
                        "reference": "Patient/g10-example"
                    }
                },
                {
                    "entity": {
                        "reference": "Patient/g10-child-example"
                    }
                },
                {
                    "entity": {
                        "reference": "Patient/g10-infant-example"
                    }
                }
            ]
        },
        {
            "id": "g10-bulk-policy",
            "resourceType": "AccessPolicyV2",
            "meta": {
                "tag": [
                    {
                        "system": "https://haste.health/fhir/testscript",
                        "code": "g10"
                    }
                ]
            },
            "name": "g10: bulk data client",
            "description": "Full access, so only the system scopes limit this client.",
            "engine": "full-access"
        },
        {
            "id": "g10-bulk-policy-assignment",
            "resourceType": "AccessPolicyV2Assignment",
            "meta": {
                "tag": [
                    {
                        "system": "https://haste.health/fhir/testscript",
                        "code": "g10"
                    }
                ]
            },
            "accessPolicy": {
                "reference": "AccessPolicyV2/g10-bulk-policy"
            },
            "link": {
                "reference": "ClientApplication/g10-bulk-client"
            }
        },
        {
            "id": "g10-bulk-client",
            "resourceType": "ClientApplication",
            "meta": {
                "tag": [
                    {
                        "system": "https://haste.health/fhir/testscript",
                        "code": "g10"
                    }
                ]
            },
            "name": "g10: bulk data client",
            "grantType": [
                "client_credentials"
            ],
            "responseTypes": "token",
            "scope": "system/*.rs"
        }
    ],
    "fixture": [
        {
            "id": "fixture-g10-bulk-group",
            "resource": {
                "reference": "#g10-bulk-group"
            },
            "autocreate": false,
            "autodelete": false
        },
        {
            "id": "fixture-g10-bulk-policy",
            "resource": {
                "reference": "#g10-bulk-policy"
            },
            "autocreate": false,
            "autodelete": false
        },
        {
            "id": "fixture-g10-bulk-policy-assignment",
            "resource": {
                "reference": "#g10-bulk-policy-assignment"
            },
            "autocreate": false,
            "autodelete": false
        },
        {
            "id": "fixture-g10-bulk-client",
            "resource": {
                "reference": "#g10-bulk-client"
            },
            "autocreate": false,
            "autodelete": false
        }
    ],
    "test": [
        {
            "id": "01-group-and-client",
            "name": "The export Group and the bulk data client",
            "action": [
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "update"
                        },
                        "resource": "Group",
                        "targetId": "fixture-g10-bulk-group",
                        "sourceId": "fixture-g10-bulk-group",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "description": "Group/g10-bulk-group is written",
                        "resource": "Group",
                        "warningOnly": false
                    }
                },
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "update"
                        },
                        "resource": "AccessPolicyV2",
                        "targetId": "fixture-g10-bulk-policy",
                        "sourceId": "fixture-g10-bulk-policy",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "description": "AccessPolicyV2/g10-bulk-policy is written",
                        "resource": "AccessPolicyV2",
                        "warningOnly": false
                    }
                },
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "update"
                        },
                        "resource": "AccessPolicyV2Assignment",
                        "targetId": "fixture-g10-bulk-policy-assignment",
                        "sourceId": "fixture-g10-bulk-policy-assignment",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "description": "AccessPolicyV2Assignment/g10-bulk-policy-assignment is written",
                        "resource": "AccessPolicyV2Assignment",
                        "warningOnly": false
                    }
                },
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "update"
                        },
                        "resource": "ClientApplication",
                        "targetId": "fixture-g10-bulk-client",
                        "sourceId": "fixture-g10-bulk-client",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "description": "ClientApplication/g10-bulk-client is written",
                        "resource": "ClientApplication",
                        "warningOnly": false
                    }
                }
            ]
        }
    ]
}
