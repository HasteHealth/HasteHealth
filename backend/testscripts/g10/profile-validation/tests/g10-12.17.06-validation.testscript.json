{
    "id": "g10-12.17.06-validation",
    "url": "https://haste.health/fhir/TestScript/g10-12.17.06-validation",
    "name": "g10-12.17.06-validation",
    "title": "12.17.06 Medication conforms to US Core Medication Profile",
    "status": "active",
    "description": "g10 12.17.06 (DAT-PAT-2, DAT-PAT-5). Inferno validates the Medication resources the server returns against the US Core 7.0.0 profile with the HL7 validator. The closest server-side check: the server has the profile, and a copy of the record's Medication/g10-uscore-med1 that claims it is accepted, which the server allows only after validating it against the profile (US Core 9.0.0 is the version loaded; a profile the server does not have would not be checked). The copy is deleted afterwards.",
    "resourceType": "TestScript",
    "contained": [
        {
            "resourceType": "Medication",
            "id": "g10-val-12-17-06",
            "meta": {
                "profile": [
                    "http://hl7.org/fhir/us/core/StructureDefinition/us-core-medication"
                ],
                "tag": [
                    {
                        "system": "https://haste.health/fhir/testscript",
                        "code": "g10"
                    }
                ]
            },
            "code": {
                "coding": [
                    {
                        "system": "http://www.nlm.nih.gov/research/umls/rxnorm",
                        "code": "206765",
                        "display": "lisinopril 10 MG Oral Tablet [Prinivil]"
                    }
                ],
                "text": "Prinivil (lisinopril) oral 10 mg"
            }
        }
    ],
    "fixture": [
        {
            "id": "fixture-g10-val-12-17-06",
            "resource": {
                "reference": "#g10-val-12-17-06"
            },
            "autocreate": false,
            "autodelete": false
        }
    ],
    "test": [
        {
            "id": "01-profile-loaded",
            "name": "StructureDefinition http://hl7.org/fhir/us/core/StructureDefinition/us-core-medication",
            "action": [
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "search"
                        },
                        "resource": "StructureDefinition",
                        "params": "url=http://hl7.org/fhir/us/core/StructureDefinition/us-core-medication",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "description": "The search answers 200",
                        "responseCode": "200",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "The server has the profile",
                        "expression": "Bundle.entry.resource.ofType(StructureDefinition).exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                }
            ]
        },
        {
            "id": "02-validate",
            "name": "PUT Medication/g10-val-12-17-06 with meta.profile",
            "action": [
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "update"
                        },
                        "resource": "Medication",
                        "targetId": "fixture-g10-val-12-17-06",
                        "sourceId": "fixture-g10-val-12-17-06",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "description": "The resource is accepted",
                        "responseCode": "200,201",
                        "operator": "in",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "A Medication is returned",
                        "resource": "Medication",
                        "warningOnly": false
                    }
                }
            ]
        }
    ],
    "teardown": {
        "action": [
            {
                "operation": {
                    "type": {
                        "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                        "code": "delete"
                    },
                    "resource": "Medication",
                    "targetId": "fixture-g10-val-12-17-06",
                    "encodeRequestUrl": false
                }
            }
        ]
    }
}
