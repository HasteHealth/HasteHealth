{
    "id": "g10-9.25.2.2.02-condition-granular",
    "url": "https://haste.health/fhir/TestScript/g10-9.25.2.2.02-condition-granular",
    "name": "g10-9.25.2.2.02-condition-granular",
    "title": "9.25.2.2.02 Condition search by patient is filtered by granular scopes",
    "status": "active",
    "description": "g10 9.25.2.2.02 (AUT-PAT-28). Condition?patient returns no Condition outside the granted categories (and, here, every one inside them).",
    "resourceType": "TestScript",
    "test": [
        {
            "id": "01",
            "name": "9.25.2.2.02 Condition search by patient is filtered by granular scopes",
            "action": [
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "search"
                        },
                        "resource": "Condition",
                        "params": "patient=g10-granular-patient",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "description": "The search answers 200",
                        "responseCode": "200",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Condition/g10-cond-encdx is not returned",
                        "expression": "Bundle.entry.resource.ofType(Condition).where(id = 'g10-cond-encdx').exists().not()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Condition/g10-cond-concern is not returned",
                        "expression": "Bundle.entry.resource.ofType(Condition).where(id = 'g10-cond-concern').exists().not()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Condition/g10-cond-problem is returned",
                        "expression": "Bundle.entry.resource.ofType(Condition).where(id = 'g10-cond-problem').exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                }
            ]
        }
    ]
}
