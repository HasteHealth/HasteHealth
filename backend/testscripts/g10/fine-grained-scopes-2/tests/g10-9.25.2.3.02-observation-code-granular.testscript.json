{
    "id": "g10-9.25.2.3.02-observation-code-granular",
    "url": "https://haste.health/fhir/TestScript/g10-9.25.2.3.02-observation-code-granular",
    "name": "g10-9.25.2.3.02-observation-code-granular",
    "title": "9.25.2.3.02 Observation search by patient and code is filtered by granular scopes",
    "status": "active",
    "description": "g10 9.25.2.3.02 (AUT-PAT-28). An Observation code search returns no Observation outside the granted categories.",
    "resourceType": "TestScript",
    "test": [
        {
            "id": "01",
            "name": "9.25.2.3.02 Observation search by patient and code is filtered by granular scopes",
            "action": [
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "search"
                        },
                        "resource": "Observation",
                        "params": "patient=g10-granular-patient&code=http://loinc.org|2093-3",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "description": "code 2093-3 answers 200",
                        "responseCode": "200",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Observation/g10-obs-lab is not returned",
                        "expression": "Bundle.entry.resource.ofType(Observation).where(id = 'g10-obs-lab').exists().not()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Observation/g10-obs-social is not returned",
                        "expression": "Bundle.entry.resource.ofType(Observation).where(id = 'g10-obs-social').exists().not()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Observation/g10-obs-clinical is not returned",
