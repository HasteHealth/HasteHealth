{
    "id": "g10-9.22.5.18-servicerequest-v1-access",
    "url": "https://haste.health/fhir/TestScript/g10-9.22.5.18-servicerequest-v1-access",
    "name": "g10-9.22.5.18-servicerequest-v1-access",
    "title": "9.22.5.18 Access to ServiceRequest resources granted by a v1 scope",
    "status": "active",
    "description": "g10 9.22.5.18 / 9.13.3.18 (AUT-PAT-28). With patient/ServiceRequest.read (SMART v1), GET ServiceRequest?patient=g10-example answers 200 and returns only the launch patient's data. With US Core 7 the kit labels the Encounter, ServiceRequest, Coverage and MedicationDispense tests of this group 1.7.21-1.7.24.",
    "resourceType": "TestScript",
    "test": [
        {
            "id": "01",
            "name": "9.22.5.18 Access to ServiceRequest resources granted by a v1 scope",
            "action": [
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "search"
                        },
                        "resource": "ServiceRequest",
                        "params": "patient=g10-example",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "description": "ServiceRequest search is allowed",
                        "responseCode": "200",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "A searchset Bundle is returned",
                        "resource": "Bundle",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Every ServiceRequest returned is the launch patient's",
                        "expression": "Bundle.entry.resource.ofType(ServiceRequest).all(subject.reference = 'Patient/g10-example')",
                        "value": "true",
                        "warningOnly": false
                    }
                }
            ]
        }
    ]
}
