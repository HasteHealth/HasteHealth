{
    "id": "g10-9.22.5.02-patient-v1-access",
    "url": "https://haste.health/fhir/TestScript/g10-9.22.5.02-patient-v1-access",
    "name": "g10-9.22.5.02-patient-v1-access",
    "title": "9.22.5.02 Access to Patient resources granted by a v1 scope",
    "status": "active",
    "description": "g10 9.22.5.02 / 9.13.3.02 (AUT-PAT-28). With patient/Patient.read (SMART v1), GET Patient?_id=g10-example answers 200 and returns only the launch patient's data.",
    "resourceType": "TestScript",
    "test": [
        {
            "id": "01",
            "name": "9.22.5.02 Access to Patient resources granted by a v1 scope",
            "action": [
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "search"
                        },
                        "resource": "Patient",
                        "params": "_id=g10-example",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "description": "Patient search is allowed",
                        "responseCode": "200",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "A searchset Bundle is returned",
                        "resource": "Bundle",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Every Patient returned is the launch patient's",
                        "expression": "Bundle.entry.resource.ofType(Patient).all(id = 'g10-example')",
                        "value": "true",
                        "warningOnly": false
                    }
                }
            ]
        }
    ]
}
