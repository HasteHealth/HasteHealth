{
    "id": "g10-9.22.5.03-allergyintolerance-v1-access",
    "url": "https://haste.health/fhir/TestScript/g10-9.22.5.03-allergyintolerance-v1-access",
    "name": "g10-9.22.5.03-allergyintolerance-v1-access",
    "title": "9.22.5.03 Access to AllergyIntolerance resources granted by a v1 scope",
    "status": "active",
    "description": "g10 9.22.5.03 / 9.13.3.03 (AUT-PAT-28). With patient/AllergyIntolerance.read (SMART v1), GET AllergyIntolerance?patient=g10-example answers 200 and returns only the launch patient's data.",
    "resourceType": "TestScript",
    "test": [
        {
            "id": "01",
            "name": "9.22.5.03 Access to AllergyIntolerance resources granted by a v1 scope",
            "action": [
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "search"
                        },
                        "resource": "AllergyIntolerance",
                        "params": "patient=g10-example",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "description": "AllergyIntolerance search is allowed",
                        "responseCode": "200",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "A searchset Bundle is returned",
                        "resource": "Bundle",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Every AllergyIntolerance returned is the launch patient's",
                        "expression": "Bundle.entry.resource.ofType(AllergyIntolerance).all(patient.reference = 'Patient/g10-example')",
                        "value": "true",
                        "warningOnly": false
                    }
                }
            ]
        }
    ]
}
