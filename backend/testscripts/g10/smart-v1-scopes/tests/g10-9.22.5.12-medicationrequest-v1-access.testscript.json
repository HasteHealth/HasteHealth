{
    "id": "g10-9.22.5.12-medicationrequest-v1-access",
    "url": "https://haste.health/fhir/TestScript/g10-9.22.5.12-medicationrequest-v1-access",
    "name": "g10-9.22.5.12-medicationrequest-v1-access",
    "title": "9.22.5.12 Access to MedicationRequest resources granted by a v1 scope",
    "status": "active",
    "description": "g10 9.22.5.12 / 9.13.3.12 (AUT-PAT-28). With patient/MedicationRequest.read (SMART v1), GET MedicationRequest?patient=g10-example&intent=proposal answers 200 and returns only the launch patient's data.",
    "resourceType": "TestScript",
    "test": [
        {
            "id": "01",
            "name": "9.22.5.12 Access to MedicationRequest resources granted by a v1 scope",
            "action": [
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "search"
                        },
                        "resource": "MedicationRequest",
                        "params": "patient=g10-example&intent=proposal",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "description": "MedicationRequest search is allowed",
                        "responseCode": "200",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "A searchset Bundle is returned",
                        "resource": "Bundle",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Every MedicationRequest returned is the launch patient's",
                        "expression": "Bundle.entry.resource.ofType(MedicationRequest).all(subject.reference = 'Patient/g10-example')",
                        "value": "true",
                        "warningOnly": false
                    }
                }
            ]
        }
    ]
}
