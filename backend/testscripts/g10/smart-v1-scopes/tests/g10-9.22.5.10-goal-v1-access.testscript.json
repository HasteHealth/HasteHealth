{
    "id": "g10-9.22.5.10-goal-v1-access",
    "url": "https://haste.health/fhir/TestScript/g10-9.22.5.10-goal-v1-access",
    "name": "g10-9.22.5.10-goal-v1-access",
    "title": "9.22.5.10 Access to Goal resources granted by a v1 scope",
    "status": "active",
    "description": "g10 9.22.5.10 / 9.13.3.10 (AUT-PAT-28). With patient/Goal.read (SMART v1), GET Goal?patient=g10-example answers 200 and returns only the launch patient's data.",
    "resourceType": "TestScript",
    "test": [
        {
            "id": "01",
            "name": "9.22.5.10 Access to Goal resources granted by a v1 scope",
            "action": [
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "search"
                        },
                        "resource": "Goal",
                        "params": "patient=g10-example",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "description": "Goal search is allowed",
                        "responseCode": "200",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "A searchset Bundle is returned",
                        "resource": "Bundle",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Every Goal returned is the launch patient's",
                        "expression": "Bundle.entry.resource.ofType(Goal).all(subject.reference = 'Patient/g10-example')",
                        "value": "true",
                        "warningOnly": false
                    }
                }
            ]
        }
    ]
}
