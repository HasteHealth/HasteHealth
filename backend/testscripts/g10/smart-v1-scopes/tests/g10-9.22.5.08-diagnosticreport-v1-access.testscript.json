{
    "id": "g10-9.22.5.08-diagnosticreport-v1-access",
    "url": "https://haste.health/fhir/TestScript/g10-9.22.5.08-diagnosticreport-v1-access",
    "name": "g10-9.22.5.08-diagnosticreport-v1-access",
    "title": "9.22.5.08 Access to DiagnosticReport resources granted by a v1 scope",
    "status": "active",
    "description": "g10 9.22.5.08 / 9.13.3.08 (AUT-PAT-28). With patient/DiagnosticReport.read (SMART v1), GET DiagnosticReport?patient=g10-example&category=LAB answers 200 and returns only the launch patient's data.",
    "resourceType": "TestScript",
    "test": [
        {
            "id": "01",
            "name": "9.22.5.08 Access to DiagnosticReport resources granted by a v1 scope",
            "action": [
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "search"
                        },
                        "resource": "DiagnosticReport",
                        "params": "patient=g10-example&category=LAB",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "description": "DiagnosticReport search is allowed",
                        "responseCode": "200",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "A searchset Bundle is returned",
                        "resource": "Bundle",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Every DiagnosticReport returned is the launch patient's",
                        "expression": "Bundle.entry.resource.ofType(DiagnosticReport).all(subject.reference = 'Patient/g10-example')",
                        "value": "true",
                        "warningOnly": false
                    }
                }
            ]
        }
    ]
}
