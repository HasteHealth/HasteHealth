{
    "id": "g10-1.7.02-patient-access",
    "url": "https://haste.health/fhir/TestScript/g10-1.7.02-patient-access",
    "name": "g10-1.7.02-patient-access",
    "title": "1.7.02 Access to Patient resources granted",
    "status": "active",
    "description": "g10 1.7.02 (AUT-PAT-10, AUT-PAT-12, AUT-PAT-33, AUT-PAT-34). With every US Core type granted, the first US Core search for Patient (GET Patient?_id=g10-example) answers 200, and every result belongs to the launch patient.",
    "resourceType": "TestScript",
    "test": [
        {
            "id": "01",
            "name": "1.7.02 Access to Patient resources granted",
            "action": [
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "search"
                        },
                        "resource": "Patient",
                        "params": "_id=g10-example",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "description": "Patient search is allowed",
                        "responseCode": "200",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "A searchset Bundle is returned",
                        "resource": "Bundle",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Every Patient returned is the launch patient's",
                        "expression": "Bundle.entry.resource.ofType(Patient).all(id = 'g10-example')",
                        "value": "true",
                        "warningOnly": false
                    }
                }
            ]
        }
    ]
}
