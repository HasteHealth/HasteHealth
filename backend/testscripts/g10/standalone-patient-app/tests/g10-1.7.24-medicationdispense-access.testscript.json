{
    "id": "g10-1.7.24-medicationdispense-access",
    "url": "https://haste.health/fhir/TestScript/g10-1.7.24-medicationdispense-access",
    "name": "g10-1.7.24-medicationdispense-access",
    "title": "1.7.24 Access to MedicationDispense resources granted",
    "status": "active",
    "description": "g10 1.7.24 / 1.7.20 (US Core 6) (AUT-PAT-10, AUT-PAT-12, AUT-PAT-33, AUT-PAT-34). With every US Core type granted, the first US Core search for MedicationDispense (GET MedicationDispense?patient=g10-example) answers 200, and every result belongs to the launch patient.",
    "resourceType": "TestScript",
    "test": [
        {
            "id": "01",
            "name": "1.7.24 Access to MedicationDispense resources granted",
            "action": [
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "search"
                        },
                        "resource": "MedicationDispense",
                        "params": "patient=g10-example",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "description": "MedicationDispense search is allowed",
                        "responseCode": "200",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "A searchset Bundle is returned",
                        "resource": "Bundle",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Every MedicationDispense returned is the launch patient's",
                        "expression": "Bundle.entry.resource.ofType(MedicationDispense).all(subject.reference = 'Patient/g10-example')",
                        "value": "true",
                        "warningOnly": false
                    }
                }
            ]
        }
    ]
}
