{
    "id": "g10-9.25.1.3.01-observation-category-granular",
    "url": "https://haste.health/fhir/TestScript/g10-9.25.1.3.01-observation-category-granular",
    "name": "g10-9.25.1.3.01-observation-category-granular",
    "title": "9.25.1.3.01 Observation search by patient and category is filtered by granular scopes",
    "status": "active",
    "description": "g10 9.25.1.3.01 (AUT-PAT-28). Granted patient/Observation.rs?category=http://terminology.hl7.org/CodeSystem/observation-category|laboratory, patient/Observation.rs?category=http://terminology.hl7.org/CodeSystem/observation-category|social-history: a category search the scope covers returns exactly the matching Observations; any other returns none of them.",
    "resourceType": "TestScript",
    "test": [
        {
            "id": "01",
            "name": "9.25.1.3.01 Observation search by patient and category is filtered by granular scopes",
            "action": [
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "search"
                        },
                        "resource": "Observation",
                        "params": "patient=g10-granular-patient&category=http://terminology.hl7.org/CodeSystem/observation-category|laboratory",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "description": "category laboratory answers 200",
                        "responseCode": "200",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Only g10-obs-lab returned",
                        "expression": "Bundle.entry.resource.ofType(Observation).all(id = 'g10-obs-lab')",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Observation/g10-obs-lab is returned",
                        "expression": "Bundle.entry.resource.ofType(Observation).where(id = 'g10-obs-lab').exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "search"
                        },
                        "resource": "Observation",
                        "params": "patient=g10-granular-patient&category=http://terminology.hl7.org/CodeSystem/observation-category|social-history",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "description": "category social-history answers 200",
                        "responseCode": "200",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Only g10-obs-social returned",
                        "expression": "Bundle.entry.resource.ofType(Observation).all(id = 'g10-obs-social')",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Observation/g10-obs-social is returned",
                        "expression": "Bundle.entry.resource.ofType(Observation).where(id = 'g10-obs-social').exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "search"
                        },
                        "resource": "Observation",
                        "params": "patient=g10-granular-patient&category=http://terminology.hl7.org/CodeSystem/observation-category|vital-signs",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "description": "Observation/g10-obs-vital is not returned",
                        "expression": "Bundle.entry.resource.ofType(Observation).where(id = 'g10-obs-vital').exists().not()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "search"
                        },
                        "resource": "Observation",
                        "params": "patient=g10-granular-patient&category=http://terminology.hl7.org/CodeSystem/observation-category|survey",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "description": "Observation/g10-obs-survey is not returned",
                        "expression": "Bundle.entry.resource.ofType(Observation).where(id = 'g10-obs-survey').exists().not()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "search"
                        },
                        "resource": "Observation",
                        "params": "patient=g10-granular-patient&category=http://hl7.org/fhir/us/core/CodeSystem/us-core-category|sdoh",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "description": "Observation/g10-obs-sdoh is not returned",
                        "expression": "Bundle.entry.resource.ofType(Observation).where(id = 'g10-obs-sdoh').exists().not()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "search"
                        },
                        "resource": "Observation",
                        "params": "patient=g10-granular-patient&category=http://terminology.hl7.org/CodeSystem/observation-category|procedure",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "description": "Observation/g10-obs-clinical is not returned",
                        "expression": "Bundle.entry.resource.ofType(Observation).where(id = 'g10-obs-clinical').exists().not()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "search"
                        },
                        "resource": "Observation",
                        "params": "patient=g10-granular-patient&category=http://terminology.hl7.org/CodeSystem/observation-category|exam",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "description": "Observation/g10-obs-exam is not returned",
                        "expression": "Bundle.entry.resource.ofType(Observation).where(id = 'g10-obs-exam').exists().not()",
                        "value": "true",
                        "warningOnly": false
                    }
                }
            ]
        }
    ]
}
