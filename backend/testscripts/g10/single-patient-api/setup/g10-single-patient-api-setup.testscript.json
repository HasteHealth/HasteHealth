{
    "id": "g10-single-patient-api-setup",
    "url": "https://haste.health/fhir/TestScript/g10-single-patient-api-setup",
    "name": "g10 single-patient-api setup",
    "title": "g10 single-patient-api: login",
    "status": "active",
    "description": "Run as admin. The login the Single Patient API tests use: a member User linked to Practitioner/g10-practitioner-2, a full-access policy, and a public client allowed user scopes for every US Core type (and Media, which a DiagnosticReport's must support media.link names), so the tests reach all of the record's patients (Inferno's patient id plus additional patient ids).",
    "resourceType": "TestScript",
    "contained": [
        {
            "id": "g10-api-user",
            "resourceType": "User",
            "meta": {
                "tag": [
                    {
                        "system": "https://haste.health/fhir/testscript",
                        "code": "g10"
                    }
                ]
            },
            "role": "member",
            "email": "g10-api@example.org"
        },
        {
            "id": "g10-api-user-membership",
            "resourceType": "Membership",
            "meta": {
                "tag": [
                    {
                        "system": "https://haste.health/fhir/testscript",
                        "code": "g10"
                    }
                ]
            },
            "user": {
                "reference": "User/g10-api-user"
            },
            "link": {
                "reference": "Practitioner/g10-practitioner-2"
            }
        },
        {
            "id": "g10-api-user-policy",
            "resourceType": "AccessPolicyV2",
            "meta": {
                "tag": [
                    {
                        "system": "https://haste.health/fhir/testscript",
                        "code": "g10"
                    }
                ]
            },
            "name": "g10: single-patient-api",
            "description": "Full access, so only the SMART scopes limit this login.",
            "engine": "full-access"
        },
        {
            "id": "g10-api-user-policy-assignment",
            "resourceType": "AccessPolicyV2Assignment",
            "meta": {
                "tag": [
                    {
                        "system": "https://haste.health/fhir/testscript",
                        "code": "g10"
                    }
                ]
            },
            "accessPolicy": {
                "reference": "AccessPolicyV2/g10-api-user-policy"
            },
            "link": {
                "reference": "Membership/g10-api-user-membership"
            }
        },
        {
            "id": "g10-api-app",
            "resourceType": "ClientApplication",
            "meta": {
                "tag": [
                    {
                        "system": "https://haste.health/fhir/testscript",
                        "code": "g10"
                    }
                ]
            },
            "name": "g10: single patient API app",
            "grantType": [
                "authorization_code",
                "refresh_token"
            ],
            "responseTypes": "code",
            "redirectUri": [
                "http://127.0.0.1:8976/callback"
            ],
            "scope": "openid fhirUser offline_access user/Medication.rs user/AllergyIntolerance.rs user/CarePlan.rs user/CareTeam.rs user/Condition.rs user/Coverage.rs user/Device.rs user/DiagnosticReport.rs user/DocumentReference.rs user/Encounter.rs user/Goal.rs user/Immunization.rs user/Location.rs user/MedicationDispense.rs user/MedicationRequest.rs user/Observation.rs user/Organization.rs user/Patient.rs user/Practitioner.rs user/PractitionerRole.rs user/Procedure.rs user/Provenance.rs user/QuestionnaireResponse.rs user/RelatedPerson.rs user/ServiceRequest.rs user/Specimen.rs user/Media.rs"
        }
    ],
    "fixture": [
        {
            "id": "fixture-g10-api-user",
            "resource": {
                "reference": "#g10-api-user"
            },
            "autocreate": false,
            "autodelete": false
        },
        {
            "id": "fixture-g10-api-user-membership",
            "resource": {
                "reference": "#g10-api-user-membership"
            },
            "autocreate": false,
            "autodelete": false
        },
        {
            "id": "fixture-g10-api-user-policy",
            "resource": {
                "reference": "#g10-api-user-policy"
            },
            "autocreate": false,
            "autodelete": false
        },
        {
            "id": "fixture-g10-api-user-policy-assignment",
            "resource": {
                "reference": "#g10-api-user-policy-assignment"
            },
            "autocreate": false,
            "autodelete": false
        },
        {
            "id": "fixture-g10-api-app",
            "resource": {
                "reference": "#g10-api-app"
            },
            "autocreate": false,
            "autodelete": false
        }
    ],
    "test": [
        {
            "id": "01-login",
            "name": "The user, its membership and policy, and the app",
            "action": [
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "update"
                        },
                        "resource": "User",
                        "targetId": "fixture-g10-api-user",
                        "sourceId": "fixture-g10-api-user",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "description": "User/g10-api-user is written",
                        "resource": "User",
                        "warningOnly": false
                    }
                },
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "update"
                        },
                        "resource": "Membership",
                        "targetId": "fixture-g10-api-user-membership",
                        "sourceId": "fixture-g10-api-user-membership",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "description": "Membership/g10-api-user-membership is written",
                        "resource": "Membership",
                        "warningOnly": false
                    }
                },
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "update"
                        },
                        "resource": "AccessPolicyV2",
                        "targetId": "fixture-g10-api-user-policy",
                        "sourceId": "fixture-g10-api-user-policy",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "description": "AccessPolicyV2/g10-api-user-policy is written",
                        "resource": "AccessPolicyV2",
                        "warningOnly": false
                    }
                },
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "update"
                        },
                        "resource": "AccessPolicyV2Assignment",
                        "targetId": "fixture-g10-api-user-policy-assignment",
                        "sourceId": "fixture-g10-api-user-policy-assignment",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "description": "AccessPolicyV2Assignment/g10-api-user-policy-assignment is written",
                        "resource": "AccessPolicyV2Assignment",
                        "warningOnly": false
                    }
                },
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "update"
                        },
                        "resource": "ClientApplication",
                        "targetId": "fixture-g10-api-app",
                        "sourceId": "fixture-g10-api-app",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "description": "ClientApplication/g10-api-app is written",
                        "resource": "ClientApplication",
                        "warningOnly": false
                    }
                }
            ]
        }
    ]
}
