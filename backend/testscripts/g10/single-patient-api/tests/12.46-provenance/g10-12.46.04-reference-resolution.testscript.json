                        "resource": "Practitioner",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "It is the referenced resource",
                        "expression": "Practitioner.id = 'g10-practitioner-1'",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "operation": {
                        "type": {
