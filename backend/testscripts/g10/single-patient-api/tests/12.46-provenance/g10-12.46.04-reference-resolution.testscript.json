    "test": [
        {
            "id": "01-references",
            "name": "Must support references",
            "action": [
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "read"
                        },
                        "resource": "AllergyIntolerance",
                        "targetId": "fixture-AllergyIntolerance-g10-79613",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "description": "AllergyIntolerance/g10-79613 resolves",
                        "responseCode": "200",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "A AllergyIntolerance is returned",
                        "resource": "AllergyIntolerance",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "It is the referenced resource",
                        "expression": "AllergyIntolerance.id = 'g10-79613'",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "read"
                        },
                        "resource": "Practitioner",
