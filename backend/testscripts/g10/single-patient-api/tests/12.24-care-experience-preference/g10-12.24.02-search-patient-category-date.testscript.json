{
    "id": "g10-12.24.02-search-patient-category-date",
    "url": "https://haste.health/fhir/TestScript/g10-12.24.02-search-patient-category-date",
    "name": "g10-12.24.02-search-patient-category-date",
    "title": "12.24.02 Server returns valid results for Observation search by patient + category + date",
    "status": "active",
    "description": "g10 12.24.02 (SH-PAT-2; US Core 6.1.0: group None). Server returns valid results for Observation search by patient + category + date. US Core SHALL search. Every result must match every parameter, and the record's Observation/g10-care-experience-preference must be among them.",
    "resourceType": "TestScript",
    "test": [
        {
            "id": "01-get-observation-patient-g10-example-category-care-experience-preference-date-2023-08-30",
            "name": "GET Observation?patient=g10-example&category=care-experience-preference&date=2023-08-30",
            "action": [
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "search"
                        },
                        "resource": "Observation",
                        "params": "patient=g10-example&category=care-experience-preference&date=2023-08-30",
                        "responseId": "main",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "description": "The search answers 200",
                        "responseCode": "200",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "A searchset Bundle is returned",
                        "resource": "Bundle",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Observation/g10-care-experience-preference is returned",
                        "expression": "Bundle.entry.resource.ofType(Observation).where(id = 'g10-care-experience-preference').exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Every Observation returned matches the search",
                        "expression": "Bundle.entry.resource.ofType(Observation).all((subject.reference.endsWith('Patient/g10-example')) and (category.coding.where(code = 'care-experience-preference').exists()))",
                        "value": "true",
                        "warningOnly": false
                    }
                }
            ]
        },
        {
            "id": "02-token-system-code-form-get-observation-patient-g10-example-category-http-hl7-org-fhir-us-core-codesystem-us-core-category-care-experience-preference-date-2023-08-30",
            "name": "Token system|code form: GET Observation?patient=g10-example&category=http://hl7.org/fhir/us/core/CodeSystem/us-core-category|care-experience-preference&date=2023-08-30",
            "action": [
