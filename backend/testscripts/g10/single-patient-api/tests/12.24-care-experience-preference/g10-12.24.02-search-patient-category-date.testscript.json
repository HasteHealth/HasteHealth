                        "expression": "Bundle.entry.resource.ofType(Observation).where(id = 'g10-care-experience-preference').exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Every Observation returned matches the search",
                        "expression": "Bundle.entry.resource.ofType(Observation).all((subject.reference.endsWith('Patient/g10-example')) and (category.coding.where(system = 'http://hl7.org/fhir/us/core/CodeSystem/us-core-category' and code = 'care-experience-preference').exists()))",
                        "value": "true",
                        "warningOnly": false
                    }
                }
            ]
        },
        {
            "id": "03-comparator-gt-get-observation-patient-g10-example-category-care-experience-preference-date-gt2023-08-29",
            "name": "Comparator gt: GET Observation?patient=g10-example&category=care-experience-preference&date=gt2023-08-29",
            "description": "Every result's date satisfies gt (compared by day). As in Inferno, no result is required.",
            "action": [
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "search"
                        },
                        "resource": "Observation",
                        "params": "patient=g10-example&category=care-experience-preference&date=gt2023-08-29",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "description": "The search answers 200",
                        "responseCode": "200",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "A searchset Bundle is returned",
                        "resource": "Bundle",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Every Observation returned matches the search",
                        "expression": "Bundle.entry.resource.ofType(Observation).all((subject.reference.endsWith('Patient/g10-example')) and (category.coding.where(code = 'care-experience-preference').exists()) and (effective.ofType(dateTime).where($this.toString().substring(0, 10) >= '2023-08-29').exists() or effective.ofType(instant).where($this.toString().substring(0, 10) >= '2023-08-29').exists() or effective.ofType(date).where($this.toString().substring(0, 10) >= '2023-08-29').exists() or effective.ofType(Period).where(end.empty() or end.where($this.toString().substring(0, 10) >= '2023-08-29').exists()).exists()))",
                        "value": "true",
                        "warningOnly": false
                    }
                }
            ]
        },
