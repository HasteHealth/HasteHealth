{
    "id": "g10-12.24.07-must-support",
    "url": "https://haste.health/fhir/TestScript/g10-12.24.07-must-support",
    "name": "g10-12.24.07-must-support",
    "title": "12.24.07 Must support elements are returned",
    "status": "active",
    "description": "g10 12.24.07 (DAT-PAT-2; US Core 6.1.0: group None). Every must support element of US Core Care Experience Preference Profile (including the USCDI ones) appears in at least one Observation the server returns. The record's instances of the profile are fetched together by _id.",
    "resourceType": "TestScript",
    "test": [
        {
            "id": "01-must-support",
            "name": "Must support elements",
            "action": [
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "search"
                        },
                        "resource": "Observation",
                        "params": "_id=g10-care-experience-preference,g10-care-experience-preference-coded",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "description": "The search answers 200",
                        "responseCode": "200",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "A searchset Bundle is returned",
                        "resource": "Bundle",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Observation.category is present",
                        "expression": "Bundle.entry.resource.ofType(Observation).category.exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Observation.category:us-core is present",
                        "expression": "Bundle.entry.resource.ofType(Observation).category.where(coding.where(system = 'http://hl7.org/fhir/us/core/CodeSystem/us-core-category' and code = 'care-experience-preference').exists()).exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Observation.code.coding.code is present",
                        "expression": "Bundle.entry.resource.ofType(Observation).code.coding.code.where($this = '95541-9').exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Observation.effectiveDateTime is present",
                        "expression": "Bundle.entry.resource.ofType(Observation).effective.ofType(dateTime).exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Observation.status is present",
                        "expression": "Bundle.entry.resource.ofType(Observation).status.exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Observation.subject is present",
                        "expression": "Bundle.entry.resource.ofType(Observation).subject.exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Observation.valueCodeableConcept is present",
                        "expression": "Bundle.entry.resource.ofType(Observation).value.ofType(CodeableConcept).exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Observation.valueString is present",
                        "expression": "Bundle.entry.resource.ofType(Observation).value.ofType(string).exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                }
            ]
        }
    ]
}
