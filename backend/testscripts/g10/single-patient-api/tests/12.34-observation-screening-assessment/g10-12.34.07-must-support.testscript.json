{
    "id": "g10-12.34.07-must-support",
    "url": "https://haste.health/fhir/TestScript/g10-12.34.07-must-support",
    "name": "g10-12.34.07-must-support",
    "title": "12.34.07 Must support elements are returned",
    "status": "active",
    "description": "g10 12.34.07 (DAT-PAT-2; US Core 6.1.0: group 10.32). Every must support element of US Core Observation Screening Assessment Profile (including the USCDI ones) appears in at least one Observation the server returns. The record's instances of the profile are fetched together by _id.",
    "resourceType": "TestScript",
    "test": [
        {
            "id": "01-must-support",
            "name": "Must support elements",
            "action": [
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "search"
                        },
                        "resource": "Observation",
                        "params": "_id=g10-10-minute-apgar-color,g10-10-minute-apgar-heart-rate,g10-10-minute-apgar-muscle-tone,g10-10-minute-apgar-reflex-irritability,g10-10-minute-apgar-respiratory-effort,g10-10-minute-apgar-score,g10-10-minute-apgar-score-panel,g10-AHC-HRSN-item-example-68517-2,g10-AUDIT-C-item-example-68517-2,g10-AUDIT-C-item-example-68519-8,g10-AUDIT-C-item-example-68520-6,g10-AUDIT-C-item-example-75626-2,g10-AUDIT-C-panel-example-72109-2,g10-EVS-item-example-68516-4,g10-EVS-item-example-89555-7,g10-EVS-panel-example-89574-8,g10-HVS-item-example-88122-7,g10-HVS-item-example-88123-5,g10-HVS-item-example-88124-3,g10-HVS-panel-example-88121-9,g10-PHQ9-item-example-44250-9,g10-PHQ9-item-example-44251-7,g10-PHQ9-item-example-44252-5,g10-PHQ9-item-example-44253-3,g10-PHQ9-item-example-44254-1,g10-PHQ9-item-example-44255-8,g10-PHQ9-item-example-44258-2,g10-PHQ9-item-example-44259-0,g10-PHQ9-item-example-44260-8,g10-PHQ9-item-example-44261-6,g10-PHQ9-item-example-69722-7,g10-PHQ9-panel-example-44249-1,g10-PRAPARE-item-example-54899-0,g10-PRAPARE-item-example-56051-6,g10-PRAPARE-item-example-56799-0,g10-PRAPARE-item-example-63512-8,g10-PRAPARE-item-example-63586-2,g10-PRAPARE-item-example-67875-5,g10-PRAPARE-item-example-71802-3,g10-PRAPARE-item-example-76437-3,g10-PRAPARE-item-example-76501-6,g10-PRAPARE-item-example-82589-3,g10-PRAPARE-item-example-93026-3,g10-PRAPARE-item-example-93027-1,g10-PRAPARE-item-example-93028-9,g10-PRAPARE-item-example-93029-7,g10-PRAPARE-item-example-93030-5,g10-PRAPARE-item-example-93033-9,g10-PRAPARE-item-example-93034-7,g10-PRAPARE-item-example-93035-4,g10-PRAPARE-item-example-93038-8,g10-PRAPARE-multiselect-item-example-32624-9-answer0,g10-PRAPARE-multiselect-item-example-32624-9-answer1,g10-PRAPARE-multiselect-item-example-93031-3-answer0,g10-PRAPARE-multiselect-item-example-93031-3-answer1,g10-PRAPARE-panel-example-93025-5,g10-PRAPARE-panel-example-93039-6,g10-PRAPARE-panel-example-93040-4,g10-PRAPARE-panel-example-93041-2,g10-PRAPARE-panel-example-93042-0,g10-PRAPARE-panel-example-93043-8,g10-TAPS-item-example-75889-6,g10-TAPS-item-example-88037-7,g10-TAPS-item-example-96842-0,g10-TAPS-item-example-96843-8,g10-TAPS-item-example-96844-6,g10-TAPS-panel-example-96841-2&_count=1000",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "description": "The search answers 200",
                        "responseCode": "200",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "A searchset Bundle is returned",
                        "resource": "Bundle",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Observation.category is present",
                        "expression": "Bundle.entry.resource.ofType(Observation).category.exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Observation.category:screening-assessment is present",
                        "expression": "Bundle.entry.resource.ofType(Observation).category.where(coding.where(system = 'http://hl7.org/fhir/us/core/CodeSystem/us-core-category' and (code = 'sdoh' or code = 'functional-status' or code = 'disability-status' or code = 'cognitive-status' or code = 'treatment-intervention-preference' or code = 'care-experience-preference')).exists()).exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Observation.category:survey is present",
                        "expression": "Bundle.entry.resource.ofType(Observation).category.where(coding.where(system = 'http://terminology.hl7.org/CodeSystem/observation-category' and code = 'survey').exists()).exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Observation.code is present",
                        "expression": "Bundle.entry.resource.ofType(Observation).code.exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Observation.derivedFrom is present",
                        "expression": "Bundle.entry.resource.ofType(Observation).derivedFrom.exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Observation.effectiveDateTime is present",
                        "expression": "Bundle.entry.resource.ofType(Observation).effective.ofType(dateTime).exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Observation.hasMember is present",
                        "expression": "Bundle.entry.resource.ofType(Observation).hasMember.exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Observation.performer is present",
                        "expression": "Bundle.entry.resource.ofType(Observation).performer.exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Observation.status is present",
                        "expression": "Bundle.entry.resource.ofType(Observation).status.exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Observation.subject is present",
                        "expression": "Bundle.entry.resource.ofType(Observation).subject.exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Observation.valueCodeableConcept is present",
                        "expression": "Bundle.entry.resource.ofType(Observation).value.ofType(CodeableConcept).exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Observation.valueQuantity is present",
                        "expression": "Bundle.entry.resource.ofType(Observation).value.ofType(Quantity).exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Observation.valueString is present",
                        "expression": "Bundle.entry.resource.ofType(Observation).value.ofType(string).exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                }
            ]
        }
    ]
}
