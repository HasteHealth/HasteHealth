{
    "id": "g10-12.34.03-search-patient-category-date",
    "url": "https://haste.health/fhir/TestScript/g10-12.34.03-search-patient-category-date",
    "name": "g10-12.34.03-search-patient-category-date",
    "title": "12.34.03 Server returns valid results for Observation search by patient + category + date",
    "status": "active",
    "description": "g10 12.34.03 (SH-PAT-2; US Core 6.1.0: group 10.32). Server returns valid results for Observation search by patient + category + date. US Core SHALL search. Every result must match every parameter, and the record's Observation/g10-AHC-HRSN-item-example-68517-2 must be among them.",
    "resourceType": "TestScript",
    "test": [
        {
            "id": "01-get-observation-patient-g10-example-category-sdoh-date-2022-03-29t22-38-59-084000-00-00",
            "name": "GET Observation?patient=g10-example&category=sdoh&date=2022-03-29T22:38:59.084000+00:00",
            "action": [
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "search"
                        },
                        "resource": "Observation",
                        "params": "patient=g10-example&category=sdoh&date=2022-03-29T22:38:59.084000+00:00",
                        "responseId": "main",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "description": "The search answers 200",
                        "responseCode": "200",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "A searchset Bundle is returned",
                        "resource": "Bundle",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Observation/g10-AHC-HRSN-item-example-68517-2 is returned",
                        "expression": "Bundle.entry.resource.ofType(Observation).where(id = 'g10-AHC-HRSN-item-example-68517-2').exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Every Observation returned matches the search",
                        "expression": "Bundle.entry.resource.ofType(Observation).all((subject.reference.endsWith('Patient/g10-example')) and (category.coding.where(code = 'sdoh').exists()))",
                        "value": "true",
                        "warningOnly": false
                    }
                }
            ]
        },
        {
            "id": "02-token-system-code-form-get-observation-patient-g10-example-category-http-hl7-org-fhir-us-core-codesystem-us-core-category-sdoh-date-2022-03-29t22-38-59-084000-00-00",
            "name": "Token system|code form: GET Observation?patient=g10-example&category=http://hl7.org/fhir/us/core/CodeSystem/us-core-category|sdoh&date=2022-03-29T22:38:59.084000+00:00",
            "action": [
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "search"
                        },
                        "resource": "Observation",
                        "params": "patient=g10-example&category=http://hl7.org/fhir/us/core/CodeSystem/us-core-category|sdoh&date=2022-03-29T22:38:59.084000+00:00",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "description": "The search answers 200",
                        "responseCode": "200",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "A searchset Bundle is returned",
                        "resource": "Bundle",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Observation/g10-AHC-HRSN-item-example-68517-2 is returned",
                        "expression": "Bundle.entry.resource.ofType(Observation).where(id = 'g10-AHC-HRSN-item-example-68517-2').exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Every Observation returned matches the search",
                        "expression": "Bundle.entry.resource.ofType(Observation).all((subject.reference.endsWith('Patient/g10-example')) and (category.coding.where(system = 'http://hl7.org/fhir/us/core/CodeSystem/us-core-category' and code = 'sdoh').exists()))",
                        "value": "true",
                        "warningOnly": false
                    }
                }
            ]
        },
        {
            "id": "03-comparator-gt-get-observation-patient-g10-example-category-sdoh-date-gt2022-03-28t22-38-59z",
            "name": "Comparator gt: GET Observation?patient=g10-example&category=sdoh&date=gt2022-03-28T22:38:59Z",
            "description": "Every result's date satisfies gt (compared by day). As in Inferno, no result is required.",
            "action": [
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "search"
                        },
                        "resource": "Observation",
                        "params": "patient=g10-example&category=sdoh&date=gt2022-03-28T22:38:59Z",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "description": "The search answers 200",
                        "responseCode": "200",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "A searchset Bundle is returned",
                        "resource": "Bundle",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Every Observation returned matches the search",
                        "expression": "Bundle.entry.resource.ofType(Observation).all((subject.reference.endsWith('Patient/g10-example')) and (category.coding.where(code = 'sdoh').exists()) and (effective.ofType(dateTime).where($this.toString().substring(0, 10) >= '2022-03-28').exists() or effective.ofType(instant).where($this.toString().substring(0, 10) >= '2022-03-28').exists() or effective.ofType(date).where($this.toString().substring(0, 10) >= '2022-03-28').exists() or effective.ofType(Period).where(end.empty() or end.where($this.toString().substring(0, 10) >= '2022-03-28').exists()).exists()))",
                        "value": "true",
                        "warningOnly": false
                    }
                }
            ]
        },
