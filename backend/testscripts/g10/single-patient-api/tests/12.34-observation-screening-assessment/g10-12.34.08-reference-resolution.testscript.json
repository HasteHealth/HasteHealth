    "test": [
        {
            "id": "01-references",
            "name": "Must support references",
            "action": [
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "read"
                        },
                        "resource": "Patient",
                        "targetId": "fixture-Patient-g10-infant-example",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "description": "Patient/g10-infant-example resolves",
                        "responseCode": "200",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "A Patient is returned",
                        "resource": "Patient",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "It is the referenced resource",
                        "expression": "Patient.id = 'g10-infant-example'",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
