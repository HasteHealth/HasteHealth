{
    "id": "g10-12.13.07-must-support",
    "url": "https://haste.health/fhir/TestScript/g10-12.13.07-must-support",
    "name": "g10-12.13.07-must-support",
    "title": "12.13.07 Must support elements are returned",
    "status": "active",
    "description": "g10 12.13.07 (DAT-PAT-2; US Core 6.1.0: group 10.13). Every must support element of US Core Encounter Profile (including the USCDI ones) appears in at least one Encounter the server returns. The record's instances of the profile are fetched together by _id.",
    "resourceType": "TestScript",
    "test": [
        {
            "id": "01-must-support",
            "name": "Must support elements",
            "action": [
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "search"
                        },
                        "resource": "Encounter",
                        "params": "_id=g10-1036,g10-delivery,g10-example-1",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "description": "The search answers 200",
                        "responseCode": "200",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "A searchset Bundle is returned",
                        "resource": "Bundle",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Encounter.class is present",
                        "expression": "Bundle.entry.resource.ofType(Encounter).class.exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Encounter.hospitalization is present",
                        "expression": "Bundle.entry.resource.ofType(Encounter).hospitalization.exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Encounter.hospitalization.dischargeDisposition is present",
                        "expression": "Bundle.entry.resource.ofType(Encounter).hospitalization.dischargeDisposition.exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Encounter.identifier is present",
                        "expression": "Bundle.entry.resource.ofType(Encounter).identifier.exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Encounter.identifier.system is present",
                        "expression": "Bundle.entry.resource.ofType(Encounter).identifier.system.exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Encounter.identifier.value is present",
                        "expression": "Bundle.entry.resource.ofType(Encounter).identifier.value.exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Encounter.location is present",
                        "expression": "Bundle.entry.resource.ofType(Encounter).location.exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Encounter.location.location or Encounter.serviceProvider is present",
                        "expression": "(Bundle.entry.resource.ofType(Encounter).location.location.exists() or Bundle.entry.resource.ofType(Encounter).serviceProvider.exists())",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Encounter.meta is present",
                        "expression": "Bundle.entry.resource.ofType(Encounter).meta.exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Encounter.meta.lastUpdated is present",
                        "expression": "Bundle.entry.resource.ofType(Encounter).meta.lastUpdated.exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Encounter.participant is present",
                        "expression": "Bundle.entry.resource.ofType(Encounter).participant.exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Encounter.participant.individual is present",
                        "expression": "Bundle.entry.resource.ofType(Encounter).participant.individual.exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Encounter.participant.period is present",
                        "expression": "Bundle.entry.resource.ofType(Encounter).participant.period.exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Encounter.participant.type is present",
                        "expression": "Bundle.entry.resource.ofType(Encounter).participant.type.exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Encounter.period is present",
                        "expression": "Bundle.entry.resource.ofType(Encounter).period.exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Encounter.reasonCode or Encounter.reasonReference is present",
                        "expression": "(Bundle.entry.resource.ofType(Encounter).reasonCode.exists() or Bundle.entry.resource.ofType(Encounter).reasonReference.exists())",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Encounter.status is present",
                        "expression": "Bundle.entry.resource.ofType(Encounter).status.exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Encounter.subject is present",
                        "expression": "Bundle.entry.resource.ofType(Encounter).subject.exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Encounter.type is present",
                        "expression": "Bundle.entry.resource.ofType(Encounter).type.exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                }
            ]
        }
    ]
}
