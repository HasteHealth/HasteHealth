{
    "id": "g10-12.13.05-provenance-revinclude",
    "url": "https://haste.health/fhir/TestScript/g10-12.13.05-provenance-revinclude",
    "name": "g10-12.13.05-provenance-revinclude",
    "title": "12.13.05 Provenance returned with _revinclude",
    "status": "active",
    "description": "g10 12.13.05 (SH-PAT-3, DAT-PAT-3; US Core 6.1.0: group 10.13). US Core Basic Provenance: a server SHALL support _revinclude=Provenance:target. The Encounter search returns the Provenance whose target is Encounter/g10-1036.",
    "resourceType": "TestScript",
    "test": [
        {
            "id": "01-revinclude",
            "name": "GET Encounter?patient=g10-example&_revinclude=Provenance:target",
            "action": [
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "search"
                        },
                        "resource": "Encounter",
                        "params": "patient=g10-example&_revinclude=Provenance:target",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "description": "The search answers 200",
                        "responseCode": "200",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "A searchset Bundle is returned",
                        "resource": "Bundle",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Encounter/g10-1036 is returned",
                        "expression": "Bundle.entry.resource.ofType(Encounter).where(id = 'g10-1036').exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Provenance/g10-prov-encounter-1036 is included",
                        "expression": "Bundle.entry.resource.ofType(Provenance).where(id = 'g10-prov-encounter-1036' and target.reference = 'Encounter/g10-1036').exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                }
            ]
        }
    ]
}
