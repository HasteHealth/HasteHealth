{
    "id": "g10-12.1.02-conformance-support",
    "url": "https://haste.health/fhir/TestScript/g10-12.1.02-conformance-support",
    "name": "g10-12.1.02-conformance-support",
    "title": "12.1.02 The server supports the conformance interaction",
    "status": "active",
    "description": "g10 12.1.02 (SH-PAT-1). GET [base]/metadata answers 200 with a CapabilityStatement. Inferno sends it without authorization; an invalid bearer token stands in (the runner cannot drop the header). Validating the response with the HL7 validator is not modelled.",
    "resourceType": "TestScript",
    "test": [
        {
            "id": "01-metadata",
            "name": "GET metadata",
            "action": [
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "capabilities"
                        },
                        "encodeRequestUrl": false,
                        "requestHeader": [
                            {
                                "field": "Authorization",
                                "value": "Bearer g10-invalid-token"
                            }
                        ]
                    }
                },
                {
                    "assert": {
                        "description": "The CapabilityStatement is served",
                        "responseCode": "200",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "The body is a CapabilityStatement",
                        "resource": "CapabilityStatement",
                        "warningOnly": false
                    }
                }
            ]
        }
    ]
}
