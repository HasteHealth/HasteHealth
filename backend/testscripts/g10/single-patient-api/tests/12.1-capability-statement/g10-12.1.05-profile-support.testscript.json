                        "description": "us-core-allergyintolerance is a supported profile",
                        "expression": "CapabilityStatement.rest.resource.supportedProfile.where($this = 'http://hl7.org/fhir/us/core/StructureDefinition/us-core-allergyintolerance' or $this.startsWith('http://hl7.org/fhir/us/core/StructureDefinition/us-core-allergyintolerance|')).exists()",
