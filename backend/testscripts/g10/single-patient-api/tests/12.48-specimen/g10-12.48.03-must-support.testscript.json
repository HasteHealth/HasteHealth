{
    "id": "g10-12.48.03-must-support",
    "url": "https://haste.health/fhir/TestScript/g10-12.48.03-must-support",
    "name": "g10-12.48.03-must-support",
    "title": "12.48.03 Must support elements are returned",
    "status": "active",
    "description": "g10 12.48.03 (DAT-PAT-2; US Core 6.1.0: group 10.44). Every must support element of US Core Specimen Profile (including the USCDI ones) appears in at least one Specimen the server returns. The record's instances of the profile are fetched together by _id.",
    "resourceType": "TestScript",
    "test": [
        {
            "id": "01-must-support",
            "name": "Must support elements",
            "action": [
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "search"
                        },
                        "resource": "Specimen",
                        "params": "_id=g10-example-serum-lipemic,g10-specimen-example-serum,g10-specimen-example-urine,g10-specimen-example-whole-blood",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "description": "The search answers 200",
                        "responseCode": "200",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "A searchset Bundle is returned",
                        "resource": "Bundle",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Specimen.accessionIdentifier is present",
                        "expression": "Bundle.entry.resource.ofType(Specimen).accessionIdentifier.exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Specimen.identifier is present",
                        "expression": "Bundle.entry.resource.ofType(Specimen).identifier.exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Specimen.subject is present",
                        "expression": "Bundle.entry.resource.ofType(Specimen).subject.exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Specimen.type is present",
                        "expression": "Bundle.entry.resource.ofType(Specimen).type.exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Specimen.collection is present",
                        "expression": "Bundle.entry.resource.ofType(Specimen).collection.exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Specimen.collection.bodySite is present",
                        "expression": "Bundle.entry.resource.ofType(Specimen).collection.bodySite.exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Specimen.condition is present",
                        "expression": "Bundle.entry.resource.ofType(Specimen).condition.exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                }
            ]
        }
    ]
}
