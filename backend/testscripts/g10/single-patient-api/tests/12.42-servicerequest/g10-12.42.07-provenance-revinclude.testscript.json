{
    "id": "g10-12.42.07-provenance-revinclude",
    "url": "https://haste.health/fhir/TestScript/g10-12.42.07-provenance-revinclude",
    "name": "g10-12.42.07-provenance-revinclude",
    "title": "12.42.07 Provenance returned with _revinclude",
    "status": "active",
    "description": "g10 12.42.07 (SH-PAT-3, DAT-PAT-3; US Core 6.1.0: group 10.39). US Core Basic Provenance: a server SHALL support _revinclude=Provenance:target. The ServiceRequest search returns the Provenance whose target is ServiceRequest/g10-bmp.",
    "resourceType": "TestScript",
    "test": [
        {
            "id": "01-revinclude",
            "name": "GET ServiceRequest?patient=g10-example&_revinclude=Provenance:target",
            "action": [
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "search"
                        },
                        "resource": "ServiceRequest",
                        "params": "patient=g10-example&_revinclude=Provenance:target",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "description": "The search answers 200",
                        "responseCode": "200",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "A searchset Bundle is returned",
                        "resource": "Bundle",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "ServiceRequest/g10-bmp is returned",
                        "expression": "Bundle.entry.resource.ofType(ServiceRequest).where(id = 'g10-bmp').exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Provenance/g10-prov-servicerequest-bmp is included",
                        "expression": "Bundle.entry.resource.ofType(Provenance).where(id = 'g10-prov-servicerequest-bmp' and target.reference = 'ServiceRequest/g10-bmp').exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                }
            ]
        }
    ]
}
