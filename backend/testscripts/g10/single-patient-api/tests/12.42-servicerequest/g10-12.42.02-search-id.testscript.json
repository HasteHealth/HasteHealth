{
    "id": "g10-12.42.02-search-id",
    "url": "https://haste.health/fhir/TestScript/g10-12.42.02-search-id",
    "name": "g10-12.42.02-search-id",
    "title": "12.42.02 Server returns valid results for ServiceRequest search by _id",
    "status": "active",
    "description": "g10 12.42.02 (SH-PAT-2; US Core 6.1.0: group 10.39). Server returns valid results for ServiceRequest search by _id. US Core SHALL search. Every result must match every parameter, and the record's ServiceRequest/g10-bmp must be among them.",
    "resourceType": "TestScript",
    "test": [
        {
            "id": "01-get-servicerequest-id-g10-bmp",
            "name": "GET ServiceRequest?_id=g10-bmp",
            "action": [
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "search"
                        },
                        "resource": "ServiceRequest",
                        "params": "_id=g10-bmp",
                        "responseId": "main",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "description": "The search answers 200",
                        "responseCode": "200",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "A searchset Bundle is returned",
                        "resource": "Bundle",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "ServiceRequest/g10-bmp is returned",
                        "expression": "Bundle.entry.resource.ofType(ServiceRequest).where(id = 'g10-bmp').exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Every ServiceRequest returned matches the search",
                        "expression": "Bundle.entry.resource.ofType(ServiceRequest).all((id = 'g10-bmp'))",
                        "value": "true",
                        "warningOnly": false
                    }
                }
            ]
        }
    ]
}
