{
    "id": "g10-12.42.04-search-patient-category-authored",
    "url": "https://haste.health/fhir/TestScript/g10-12.42.04-search-patient-category-authored",
    "name": "g10-12.42.04-search-patient-category-authored",
    "title": "12.42.04 Server returns valid results for ServiceRequest search by patient + category + authored",
    "status": "active",
    "description": "g10 12.42.04 (SH-PAT-2; US Core 6.1.0: group 10.39). Server returns valid results for ServiceRequest search by patient + category + authored. US Core SHALL search. Every result must match every parameter, and the record's ServiceRequest/g10-bmp must be among them.",
    "resourceType": "TestScript",
    "test": [
        {
            "id": "01-get-servicerequest-patient-g10-example-category-108252007-authored-2024-10-13t10-59-38-08-00",
            "name": "GET ServiceRequest?patient=g10-example&category=108252007&authored=2024-10-13T10:59:38-08:00",
            "action": [
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "search"
                        },
                        "resource": "ServiceRequest",
                        "params": "patient=g10-example&category=108252007&authored=2024-10-13T10:59:38-08:00",
                        "responseId": "main",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "description": "The search answers 200",
                        "responseCode": "200",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "A searchset Bundle is returned",
                        "resource": "Bundle",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "ServiceRequest/g10-bmp is returned",
                        "expression": "Bundle.entry.resource.ofType(ServiceRequest).where(id = 'g10-bmp').exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Every ServiceRequest returned matches the search",
                        "expression": "Bundle.entry.resource.ofType(ServiceRequest).all((subject.reference.endsWith('Patient/g10-example')) and (category.coding.where(code = '108252007').exists()))",
                        "value": "true",
                        "warningOnly": false
                    }
                }
            ]
        },
        {
            "id": "02-token-system-code-form-get-servicerequest-patient-g10-example-category-http-snomed-info-sct-108252007-authored-2024-10-13t10-59-38-08-00",
