{
    "id": "g10-12.29.01-search-patient-code",
    "url": "https://haste.health/fhir/TestScript/g10-12.29.01-search-patient-code",
    "name": "g10-12.29.01-search-patient-code",
    "title": "12.29.01 Server returns valid results for Observation search by patient + code",
    "status": "active",
    "description": "g10 12.29.01 (SH-PAT-2, DAT-PAT-7; US Core 6.1.0: group 10.27). Server returns valid results for Observation search by patient + code. US Core SHALL search. Every result must match every parameter, and the record's Observation/g10-pack-years-example must be among them.",
    "resourceType": "TestScript",
    "test": [
        {
            "id": "01-get-observation-patient-g10-example-code-401201003",
            "name": "GET Observation?patient=g10-example&code=401201003",
            "action": [
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "search"
                        },
                        "resource": "Observation",
                        "params": "patient=g10-example&code=401201003&_count=1000",
                        "responseId": "main",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "description": "The search answers 200",
                        "responseCode": "200",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "A searchset Bundle is returned",
                        "resource": "Bundle",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Observation/g10-pack-years-example is returned",
                        "expression": "Bundle.entry.resource.ofType(Observation).where(id = 'g10-pack-years-example').exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Every Observation returned matches the search",
                        "expression": "Bundle.entry.resource.ofType(Observation).all((subject.reference.endsWith('Patient/g10-example')) and (code.coding.where(code = '401201003').exists()))",
                        "value": "true",
                        "warningOnly": false
                    }
                }
            ]
        },
        {
            "id": "02-get-observation-patient-g10-example-code-72166-2",
            "name": "GET Observation?patient=g10-example&code=72166-2",
            "action": [
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "search"
                        },
                        "resource": "Observation",
                        "params": "patient=g10-example&code=72166-2&_count=1000",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "description": "The search answers 200",
                        "responseCode": "200",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "A searchset Bundle is returned",
                        "resource": "Bundle",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Observation/g10-some-day-smoker is returned",
                        "expression": "Bundle.entry.resource.ofType(Observation).where(id = 'g10-some-day-smoker').exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Every Observation returned matches the search",
                        "expression": "Bundle.entry.resource.ofType(Observation).all((subject.reference.endsWith('Patient/g10-example')) and (code.coding.where(code = '72166-2').exists()))",
                        "value": "true",
                        "warningOnly": false
                    }
                }
            ]
        },
        {
            "id": "03-reference-form-get-observation-patient-patient-g10-example-code-401201003",
            "name": "Reference form: GET Observation?patient=Patient/g10-example&code=401201003",
            "description": "patient=Patient/[id] returns what patient=[id] returns.",
            "action": [
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "search"
                        },
                        "resource": "Observation",
                        "params": "patient=Patient/g10-example&code=401201003&_count=1000",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "description": "The search answers 200",
                        "responseCode": "200",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "A searchset Bundle is returned",
                        "resource": "Bundle",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Observation/g10-pack-years-example is returned",
                        "expression": "Bundle.entry.resource.ofType(Observation).where(id = 'g10-pack-years-example').exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Every Observation returned matches the search",
                        "expression": "Bundle.entry.resource.ofType(Observation).all((subject.reference.endsWith('Patient/g10-example')) and (code.coding.where(code = '401201003').exists()))",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "It returns as many entries as patient=[id]",
                        "expression": "Bundle.entry.count()",
                        "compareToSourceId": "main",
                        "compareToSourceExpression": "Bundle.entry.count()",
                        "warningOnly": false
                    }
                }
            ]
        },
        {
            "id": "04-token-system-code-form-get-observation-patient-g10-example-code-http-snomed-info-sct-401201003",
            "name": "Token system|code form: GET Observation?patient=g10-example&code=http://snomed.info/sct|401201003",
            "action": [
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "search"
                        },
                        "resource": "Observation",
                        "params": "patient=g10-example&code=http://snomed.info/sct|401201003&_count=1000",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "description": "The search answers 200",
                        "responseCode": "200",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "A searchset Bundle is returned",
                        "resource": "Bundle",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Observation/g10-pack-years-example is returned",
                        "expression": "Bundle.entry.resource.ofType(Observation).where(id = 'g10-pack-years-example').exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Every Observation returned matches the search",
                        "expression": "Bundle.entry.resource.ofType(Observation).all((subject.reference.endsWith('Patient/g10-example')) and (code.coding.where(system = 'http://snomed.info/sct' and code = '401201003').exists()))",
                        "value": "true",
                        "warningOnly": false
                    }
                }
            ]
        },
        {
            "id": "05-post-observation-search-patient-g10-example-code-401201003",
            "name": "POST Observation/_search?patient=g10-example&code=401201003",
            "description": "Inferno posts the parameters as a form body, which a TestScript cannot send; this sends them in the query string of a POST with no body, which the server reads the same way.",
            "action": [
                {
                    "operation": {
                        "method": "post",
                        "url": "Observation/_search?patient=g10-example&code=401201003&_count=1000",
                        "requestHeader": [
                            {
                                "field": "Content-Type",
                                "value": "application/x-www-form-urlencoded"
                            }
                        ],
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "description": "The search answers 200",
                        "responseCode": "200",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "A searchset Bundle is returned",
                        "resource": "Bundle",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "It returns as many entries as the GET",
                        "expression": "Bundle.entry.count()",
                        "compareToSourceId": "main",
                        "compareToSourceExpression": "Bundle.entry.count()",
                        "warningOnly": false
                    }
                }
            ]
        }
    ]
}
