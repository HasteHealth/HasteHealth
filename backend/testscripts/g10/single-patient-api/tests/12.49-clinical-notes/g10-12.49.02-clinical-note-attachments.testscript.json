{
    "id": "g10-12.49.02-clinical-note-attachments",
    "url": "https://haste.health/fhir/TestScript/g10-12.49.02-clinical-note-attachments",
    "name": "g10-12.49.02-clinical-note-attachments",
    "title": "12.49.02 Reports and notes share their attachments",
    "status": "active",
    "description": "g10 12.49.02 (DAT-PAT-4; US Core 6.1.0: 10.45.02). Each presentedForm.url of the patient's Cardiology, Pathology and Radiology DiagnosticReports is also the attachment url of one of the patient's DocumentReferences.",
    "resourceType": "TestScript",
    "test": [
        {
            "id": "01-attachments",
            "name": "GET DocumentReference?patient=g10-example",
            "action": [
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "search"
                        },
                        "resource": "DocumentReference",
                        "params": "patient=g10-example",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "description": "The search answers 200",
                        "responseCode": "200",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "http://example.org/fhir/Binary/g10-pathology-note.pdf is a DocumentReference attachment",
                        "expression": "Bundle.entry.resource.ofType(DocumentReference).content.attachment.where(url = 'http://example.org/fhir/Binary/g10-pathology-note.pdf').exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "http://example.org/fhir/pdfdownloads/cardiopanel-report-123.pdf is a DocumentReference attachment",
                        "expression": "Bundle.entry.resource.ofType(DocumentReference).content.attachment.where(url = 'http://example.org/fhir/pdfdownloads/cardiopanel-report-123.pdf').exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                }
            ]
        },
        {
            "id": "02-report-urls",
            "name": "GET DiagnosticReport?patient=g10-example",
            "action": [
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "search"
                        },
                        "resource": "DiagnosticReport",
                        "params": "patient=g10-example",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "description": "The search answers 200",
                        "responseCode": "200",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "http://example.org/fhir/Binary/g10-pathology-note.pdf is a report's presentedForm",
                        "expression": "Bundle.entry.resource.ofType(DiagnosticReport).presentedForm.where(url = 'http://example.org/fhir/Binary/g10-pathology-note.pdf').exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "http://example.org/fhir/pdfdownloads/cardiopanel-report-123.pdf is a report's presentedForm",
                        "expression": "Bundle.entry.resource.ofType(DiagnosticReport).presentedForm.where(url = 'http://example.org/fhir/pdfdownloads/cardiopanel-report-123.pdf').exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                }
            ]
        }
    ]
}
