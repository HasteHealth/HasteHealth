{
    "id": "g10-12.5.01-search-patient-status",
    "url": "https://haste.health/fhir/TestScript/g10-12.5.01-search-patient-status",
    "name": "g10-12.5.01-search-patient-status",
    "title": "12.5.01 Server returns valid results for CareTeam search by patient + status",
    "status": "active",
    "description": "g10 12.5.01 (SH-PAT-2, DAT-PAT-7; US Core 6.1.0: group 10.5). Server returns valid results for CareTeam search by patient + status. US Core SHALL search. Every result must match every parameter, and the record's CareTeam/g10-example must be among them.",
    "resourceType": "TestScript",
    "test": [
        {
            "id": "01-get-careteam-patient-g10-example-status-active",
            "name": "GET CareTeam?patient=g10-example&status=active",
            "action": [
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "search"
                        },
                        "resource": "CareTeam",
                        "params": "patient=g10-example&status=active",
                        "responseId": "main",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "description": "The search answers 200",
                        "responseCode": "200",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "A searchset Bundle is returned",
                        "resource": "Bundle",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "CareTeam/g10-example is returned",
                        "expression": "Bundle.entry.resource.ofType(CareTeam).where(id = 'g10-example').exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Every CareTeam returned matches the search",
                        "expression": "Bundle.entry.resource.ofType(CareTeam).all((subject.reference.endsWith('Patient/g10-example')) and (status = 'active'))",
                        "value": "true",
                        "warningOnly": false
                    }
                }
            ]
        },
        {
            "id": "02-reference-form-get-careteam-patient-patient-g10-example-status-active",
            "name": "Reference form: GET CareTeam?patient=Patient/g10-example&status=active",
            "description": "patient=Patient/[id] returns what patient=[id] returns.",
            "action": [
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "search"
                        },
                        "resource": "CareTeam",
                        "params": "patient=Patient/g10-example&status=active",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "description": "The search answers 200",
                        "responseCode": "200",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "A searchset Bundle is returned",
                        "resource": "Bundle",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "CareTeam/g10-example is returned",
                        "expression": "Bundle.entry.resource.ofType(CareTeam).where(id = 'g10-example').exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Every CareTeam returned matches the search",
                        "expression": "Bundle.entry.resource.ofType(CareTeam).all((subject.reference.endsWith('Patient/g10-example')) and (status = 'active'))",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "It returns as many entries as patient=[id]",
                        "expression": "Bundle.entry.count()",
                        "compareToSourceId": "main",
                        "compareToSourceExpression": "Bundle.entry.count()",
                        "warningOnly": false
                    }
                }
            ]
        },
        {
            "id": "03-post-careteam-search-patient-g10-example-status-active",
            "name": "POST CareTeam/_search?patient=g10-example&status=active",
            "description": "Inferno posts the parameters as a form body, which a TestScript cannot send; this sends them in the query string of a POST with no body, which the server reads the same way.",
            "action": [
                {
                    "operation": {
                        "method": "post",
                        "url": "CareTeam/_search?patient=g10-example&status=active",
                        "requestHeader": [
                            {
                                "field": "Content-Type",
                                "value": "application/x-www-form-urlencoded"
                            }
                        ],
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "description": "The search answers 200",
                        "responseCode": "200",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "A searchset Bundle is returned",
                        "resource": "Bundle",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "It returns as many entries as the GET",
                        "expression": "Bundle.entry.count()",
                        "compareToSourceId": "main",
                        "compareToSourceExpression": "Bundle.entry.count()",
                        "warningOnly": false
                    }
                }
            ]
        }
    ]
}
