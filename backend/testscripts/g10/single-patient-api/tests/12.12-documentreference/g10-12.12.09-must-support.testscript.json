{
    "id": "g10-12.12.09-must-support",
    "url": "https://haste.health/fhir/TestScript/g10-12.12.09-must-support",
    "name": "g10-12.12.09-must-support",
    "title": "12.12.09 Must support elements are returned",
    "status": "active",
    "description": "g10 12.12.09 (DAT-PAT-2; US Core 6.1.0: group 10.12). Every must support element of US Core DocumentReference Profile (including the USCDI ones) appears in at least one DocumentReference the server returns. The record's instances of the profile are fetched together by _id.",
    "resourceType": "TestScript",
    "test": [
        {
            "id": "01-must-support",
            "name": "Must support elements",
            "action": [
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "search"
                        },
                        "resource": "DocumentReference",
                        "params": "_id=g10-cardiology-report-note,g10-ccd123,g10-consult-note,g10-discharge,g10-discharge-summary,g10-episode-summary,g10-history-physical-note,g10-imaging-note,g10-lab-report-note,g10-pathology-note,g10-procedure-note123,g10-procedure-note456,g10-progress-note",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "description": "The search answers 200",
                        "responseCode": "200",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "A searchset Bundle is returned",
                        "resource": "Bundle",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "DocumentReference.author is present",
                        "expression": "Bundle.entry.resource.ofType(DocumentReference).author.exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "DocumentReference.category is present",
                        "expression": "Bundle.entry.resource.ofType(DocumentReference).category.exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "DocumentReference.content is present",
                        "expression": "Bundle.entry.resource.ofType(DocumentReference).content.exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "DocumentReference.content.attachment is present",
                        "expression": "Bundle.entry.resource.ofType(DocumentReference).content.attachment.exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "DocumentReference.content.attachment.contentType is present",
                        "expression": "Bundle.entry.resource.ofType(DocumentReference).content.attachment.contentType.exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "DocumentReference.content.attachment.data or DocumentReference.content.attachment.url is present",
                        "expression": "(Bundle.entry.resource.ofType(DocumentReference).content.attachment.data.exists() or Bundle.entry.resource.ofType(DocumentReference).content.attachment.url.exists())",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "DocumentReference.content.format is present",
                        "expression": "Bundle.entry.resource.ofType(DocumentReference).content.format.exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "DocumentReference.context is present",
                        "expression": "Bundle.entry.resource.ofType(DocumentReference).context.exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "DocumentReference.context.encounter is present",
                        "expression": "Bundle.entry.resource.ofType(DocumentReference).context.encounter.exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "DocumentReference.context.period is present",
                        "expression": "Bundle.entry.resource.ofType(DocumentReference).context.period.exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "DocumentReference.date is present",
                        "expression": "Bundle.entry.resource.ofType(DocumentReference).date.exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "DocumentReference.identifier is present",
                        "expression": "Bundle.entry.resource.ofType(DocumentReference).identifier.exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "DocumentReference.status is present",
                        "expression": "Bundle.entry.resource.ofType(DocumentReference).status.exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "DocumentReference.subject is present",
                        "expression": "Bundle.entry.resource.ofType(DocumentReference).subject.exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "DocumentReference.type is present",
                        "expression": "Bundle.entry.resource.ofType(DocumentReference).type.exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "DocumentReference.category:uscore is present",
                        "expression": "Bundle.entry.resource.ofType(DocumentReference).category.where(coding.where(system = 'http://hl7.org/fhir/us/core/CodeSystem/us-core-documentreference-category' and (code = 'clinical-note')).exists()).exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                }
            ]
        }
    ]
}
