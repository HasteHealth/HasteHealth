{
    "id": "g10-12.12.04-search-patient-category-date",
    "url": "https://haste.health/fhir/TestScript/g10-12.12.04-search-patient-category-date",
    "name": "g10-12.12.04-search-patient-category-date",
    "title": "12.12.04 Server returns valid results for DocumentReference search by patient + category + date",
    "status": "active",
    "description": "g10 12.12.04 (SH-PAT-2; US Core 6.1.0: group 10.12). Server returns valid results for DocumentReference search by patient + category + date. US Core SHALL search. Every result must match every parameter, and the record's DocumentReference/g10-cardiology-report-note must be among them.",
    "resourceType": "TestScript",
    "test": [
        {
            "id": "01-get-documentreference-patient-g10-example-category-clinical-note-date-2022-11-18t20-45-05z",
            "name": "GET DocumentReference?patient=g10-example&category=clinical-note&date=2022-11-18T20:45:05Z",
            "action": [
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "search"
                        },
                        "resource": "DocumentReference",
                        "params": "patient=g10-example&category=clinical-note&date=2022-11-18T20:45:05Z",
                        "responseId": "main",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "description": "The search answers 200",
                        "responseCode": "200",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "A searchset Bundle is returned",
                        "resource": "Bundle",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "DocumentReference/g10-cardiology-report-note is returned",
                        "expression": "Bundle.entry.resource.ofType(DocumentReference).where(id = 'g10-cardiology-report-note').exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Every DocumentReference returned matches the search",
                        "expression": "Bundle.entry.resource.ofType(DocumentReference).all((subject.reference.endsWith('Patient/g10-example')) and (category.coding.where(code = 'clinical-note').exists()))",
                        "value": "true",
                        "warningOnly": false
                    }
                }
            ]
        },
        {
            "id": "02-token-system-code-form-get-documentreference-patient-g10-example-category-http-hl7-org-fhir-us-core-codesystem-us-core-documentreference-category-clinical-note-date-2022-11-18t20-45-05z",
            "name": "Token system|code form: GET DocumentReference?patient=g10-example&category=http://hl7.org/fhir/us/core/CodeSystem/us-core-documentreference-category|clinical-note&date=2022-11-18T20:45:05Z",
            "action": [
                {
                    "operation": {
                        "type": {
