                    }
                },
                {
                    "assert": {
                        "description": "The search answers 200",
                        "responseCode": "200",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "A searchset Bundle is returned",
                        "resource": "Bundle",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "DocumentReference/g10-cardiology-report-note is returned",
                        "expression": "Bundle.entry.resource.ofType(DocumentReference).where(id = 'g10-cardiology-report-note').exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Every DocumentReference returned matches the search",
                        "expression": "Bundle.entry.resource.ofType(DocumentReference).all((subject.reference.endsWith('Patient/g10-example')) and (category.coding.where(system = 'http://hl7.org/fhir/us/core/CodeSystem/us-core-documentreference-category' and code = 'clinical-note').exists()))",
                        "value": "true",
                        "warningOnly": false
                    }
                }
            ]
        },
        {
            "id": "03-comparator-gt-get-documentreference-patient-g10-example-category-clinical-note-date-gt2022-11-17t20-45-05z",
            "name": "Comparator gt: GET DocumentReference?patient=g10-example&category=clinical-note&date=gt2022-11-17T20:45:05Z",
            "description": "Every result's date satisfies gt (compared by day). As in Inferno, no result is required.",
            "action": [
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "search"
                        },
                        "resource": "DocumentReference",
                        "params": "patient=g10-example&category=clinical-note&date=gt2022-11-17T20:45:05Z",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "description": "The search answers 200",
                        "responseCode": "200",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "A searchset Bundle is returned",
                        "resource": "Bundle",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Every DocumentReference returned matches the search",
                        "expression": "Bundle.entry.resource.ofType(DocumentReference).all((subject.reference.endsWith('Patient/g10-example')) and (category.coding.where(code = 'clinical-note').exists()) and (date.where($this.toString().substring(0, 10) >= '2022-11-17').exists()))",
                        "value": "true",
                        "warningOnly": false
                    }
                }
            ]
        },
