{
    "id": "g10-12.12.07-provenance-revinclude",
    "url": "https://haste.health/fhir/TestScript/g10-12.12.07-provenance-revinclude",
    "name": "g10-12.12.07-provenance-revinclude",
    "title": "12.12.07 Provenance returned with _revinclude",
    "status": "active",
    "description": "g10 12.12.07 (SH-PAT-3, DAT-PAT-3; US Core 6.1.0: group 10.12). US Core Basic Provenance: a server SHALL support _revinclude=Provenance:target. The DocumentReference search returns the Provenance whose target is DocumentReference/g10-cardiology-report-note.",
    "resourceType": "TestScript",
    "test": [
        {
            "id": "01-revinclude",
            "name": "GET DocumentReference?patient=g10-example&_revinclude=Provenance:target",
            "action": [
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "search"
                        },
                        "resource": "DocumentReference",
                        "params": "patient=g10-example&_revinclude=Provenance:target",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "description": "The search answers 200",
                        "responseCode": "200",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "A searchset Bundle is returned",
                        "resource": "Bundle",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "DocumentReference/g10-cardiology-report-note is returned",
                        "expression": "Bundle.entry.resource.ofType(DocumentReference).where(id = 'g10-cardiology-report-note').exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Provenance/g10-prov-documentreference-cardiology-report-note is included",
                        "expression": "Bundle.entry.resource.ofType(Provenance).where(id = 'g10-prov-documentreference-cardiology-report-note' and target.reference = 'DocumentReference/g10-cardiology-report-note').exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                }
            ]
        }
    ]
}
