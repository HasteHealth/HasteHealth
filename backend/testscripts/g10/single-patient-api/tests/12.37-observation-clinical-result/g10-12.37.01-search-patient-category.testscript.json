{
    "id": "g10-12.37.01-search-patient-category",
    "url": "https://haste.health/fhir/TestScript/g10-12.37.01-search-patient-category",
    "name": "g10-12.37.01-search-patient-category",
    "title": "12.37.01 Server returns valid results for Observation search by patient + category",
    "status": "active",
    "description": "g10 12.37.01 (SH-PAT-2, DAT-PAT-7; US Core 6.1.0: group 10.34). Server returns valid results for Observation search by patient + category. US Core SHALL search. Every result must match every parameter, and the record's Observation/g10-capillary-refill-time-nail-bed must be among them.",
    "resourceType": "TestScript",
    "test": [
        {
            "id": "01-get-observation-patient-g10-example-category-exam",
            "name": "GET Observation?patient=g10-example&category=exam",
            "action": [
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "search"
                        },
                        "resource": "Observation",
                        "params": "patient=g10-example&category=exam",
                        "responseId": "main",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "description": "The search answers 200",
                        "responseCode": "200",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "A searchset Bundle is returned",
                        "resource": "Bundle",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Observation/g10-capillary-refill-time-nail-bed is returned",
                        "expression": "Bundle.entry.resource.ofType(Observation).where(id = 'g10-capillary-refill-time-nail-bed').exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Every Observation returned matches the search",
                        "expression": "Bundle.entry.resource.ofType(Observation).all((subject.reference.endsWith('Patient/g10-example')) and (category.coding.where(code = 'exam').exists()))",
                        "value": "true",
                        "warningOnly": false
                    }
                }
            ]
        },
        {
            "id": "02-get-observation-patient-g10-example-category-imaging",
            "name": "GET Observation?patient=g10-example&category=imaging",
            "action": [
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "search"
                        },
                        "resource": "Observation",
                        "params": "patient=g10-example&category=imaging",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "description": "The search answers 200",
                        "responseCode": "200",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "A searchset Bundle is returned",
                        "resource": "Bundle",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Observation/g10-dxa-femur-l-armass-bmd is returned",
                        "expression": "Bundle.entry.resource.ofType(Observation).where(id = 'g10-dxa-femur-l-armass-bmd').exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Every Observation returned matches the search",
                        "expression": "Bundle.entry.resource.ofType(Observation).all((subject.reference.endsWith('Patient/g10-example')) and (category.coding.where(code = 'imaging').exists()))",
                        "value": "true",
                        "warningOnly": false
                    }
                }
            ]
        },
        {
            "id": "03-get-observation-patient-g10-example-category-procedure",
