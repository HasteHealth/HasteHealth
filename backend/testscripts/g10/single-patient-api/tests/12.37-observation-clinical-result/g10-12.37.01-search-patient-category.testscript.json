        },
        {
            "id": "04-reference-form-get-observation-patient-patient-g10-example-category-exam",
            "name": "Reference form: GET Observation?patient=Patient/g10-example&category=exam",
            "description": "patient=Patient/[id] returns what patient=[id] returns.",
            "action": [
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "search"
                        },
                        "resource": "Observation",
                        "params": "patient=Patient/g10-example&category=exam",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "description": "The search answers 200",
                        "responseCode": "200",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "A searchset Bundle is returned",
                        "resource": "Bundle",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Observation/g10-capillary-refill-time-nail-bed is returned",
                        "expression": "Bundle.entry.resource.ofType(Observation).where(id = 'g10-capillary-refill-time-nail-bed').exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Every Observation returned matches the search",
                        "expression": "Bundle.entry.resource.ofType(Observation).all((subject.reference.endsWith('Patient/g10-example')) and (category.coding.where(code = 'exam').exists()))",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "It returns as many entries as patient=[id]",
                        "expression": "Bundle.entry.count()",
                        "compareToSourceId": "main",
                        "compareToSourceExpression": "Bundle.entry.count()",
                        "warningOnly": false
                    }
                }
            ]
        },
        {
            "id": "05-token-system-code-form-get-observation-patient-g10-example-category-http-terminology-hl7-org-codesystem-observation-category-exam",
            "name": "Token system|code form: GET Observation?patient=g10-example&category=http://terminology.hl7.org/CodeSystem/observation-category|exam",
            "action": [
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "search"
                        },
                        "resource": "Observation",
                        "params": "patient=g10-example&category=http://terminology.hl7.org/CodeSystem/observation-category|exam",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "description": "The search answers 200",
                        "responseCode": "200",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "A searchset Bundle is returned",
                        "resource": "Bundle",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Observation/g10-capillary-refill-time-nail-bed is returned",
                        "expression": "Bundle.entry.resource.ofType(Observation).where(id = 'g10-capillary-refill-time-nail-bed').exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Every Observation returned matches the search",
                        "expression": "Bundle.entry.resource.ofType(Observation).all((subject.reference.endsWith('Patient/g10-example')) and (category.coding.where(system = 'http://terminology.hl7.org/CodeSystem/observation-category' and code = 'exam').exists()))",
                        "value": "true",
                        "warningOnly": false
                    }
                }
            ]
        },
        {
            "id": "06-post-observation-search-patient-g10-example-category-exam",
            "name": "POST Observation/_search?patient=g10-example&category=exam",
            "description": "Inferno posts the parameters as a form body, which a TestScript cannot send; this sends them in the query string of a POST with no body, which the server reads the same way.",
            "action": [
                {
                    "operation": {
                        "method": "post",
                        "url": "Observation/_search?patient=g10-example&category=exam",
                        "requestHeader": [
                            {
                                "field": "Content-Type",
                                "value": "application/x-www-form-urlencoded"
                            }
                        ],
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "description": "The search answers 200",
                        "responseCode": "200",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "A searchset Bundle is returned",
                        "resource": "Bundle",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "It returns as many entries as the GET",
                        "expression": "Bundle.entry.count()",
                        "compareToSourceId": "main",
                        "compareToSourceExpression": "Bundle.entry.count()",
                        "warningOnly": false
                    }
                }
            ]
        }
    ]
}
