{
    "id": "g10-12.37.07-must-support",
    "url": "https://haste.health/fhir/TestScript/g10-12.37.07-must-support",
    "name": "g10-12.37.07-must-support",
    "title": "12.37.07 Must support elements are returned",
    "status": "active",
    "description": "g10 12.37.07 (DAT-PAT-2; US Core 6.1.0: group 10.34). Every must support element of US Core Observation Clinical Result Profile (including the USCDI ones) appears in at least one Observation the server returns. The record's instances of the profile are fetched together by _id.",
    "resourceType": "TestScript",
    "test": [
        {
            "id": "01-must-support",
            "name": "Must support elements",
            "action": [
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "search"
                        },
                        "resource": "Observation",
                        "params": "_id=g10-capillary-refill-time-nail-bed,g10-dxa-femur-l-armass-bmd,g10-dxa-femur-l-t-score-bmd,g10-dxa-femur-l-z-score-bmd,g10-dxa-hip-l-armass-bmd,g10-dxa-hip-l-t-score-bmd,g10-dxa-hip-l-z-score-bmd,g10-ekg-impression,g10-ekg-lead,g10-heart-rate-rhythm,g10-jugular-vein-distension,g10-p-r-interval-ekg-lead,g10-pulse-intensity-palpation,g10-q-t-interval-ekg-lead,g10-qrs-dur-ekg-lead,g10-xray-chest-findings,g10-xray-chest-impression",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "description": "The search answers 200",
                        "responseCode": "200",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "A searchset Bundle is returned",
                        "resource": "Bundle",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Observation.category is present",
                        "expression": "Bundle.entry.resource.ofType(Observation).category.exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Observation.category:us-core is present",
                        "expression": "Bundle.entry.resource.ofType(Observation).category.where(coding.where(system = 'http://terminology.hl7.org/CodeSystem/observation-category' and (code = 'laboratory' or code = 'exam' or code = 'therapy' or code = 'imaging' or code = 'procedure' or code = 'vital-signs' or code = 'activity')).exists()).exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Observation.code is present",
                        "expression": "Bundle.entry.resource.ofType(Observation).code.exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Observation.effectiveDateTime is present",
                        "expression": "Bundle.entry.resource.ofType(Observation).effective.ofType(dateTime).exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Observation.encounter is present",
                        "expression": "Bundle.entry.resource.ofType(Observation).encounter.exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Observation.status is present",
                        "expression": "Bundle.entry.resource.ofType(Observation).status.exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Observation.subject is present",
                        "expression": "Bundle.entry.resource.ofType(Observation).subject.exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Observation.valueCodeableConcept is present",
                        "expression": "Bundle.entry.resource.ofType(Observation).value.ofType(CodeableConcept).exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Observation.valueQuantity is present",
                        "expression": "Bundle.entry.resource.ofType(Observation).value.ofType(Quantity).exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Observation.valueString is present",
                        "expression": "Bundle.entry.resource.ofType(Observation).value.ofType(string).exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                }
            ]
        }
    ]
}
