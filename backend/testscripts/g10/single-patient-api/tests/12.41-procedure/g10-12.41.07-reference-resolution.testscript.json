    "test": [
        {
            "id": "01-references",
            "name": "Must support references",
            "action": [
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "read"
                        },
                        "resource": "ServiceRequest",
                        "targetId": "fixture-ServiceRequest-g10-rehab",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "description": "ServiceRequest/g10-rehab resolves",
                        "responseCode": "200",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "A ServiceRequest is returned",
                        "resource": "ServiceRequest",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "It is the referenced resource",
                        "expression": "ServiceRequest.id = 'g10-rehab'",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "operation": {
