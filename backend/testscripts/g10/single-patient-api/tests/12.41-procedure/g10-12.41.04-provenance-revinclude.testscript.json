{
    "id": "g10-12.41.04-provenance-revinclude",
    "url": "https://haste.health/fhir/TestScript/g10-12.41.04-provenance-revinclude",
    "name": "g10-12.41.04-provenance-revinclude",
    "title": "12.41.04 Provenance returned with _revinclude",
    "status": "active",
    "description": "g10 12.41.04 (SH-PAT-3, DAT-PAT-3; US Core 6.1.0: group 10.38). US Core Basic Provenance: a server SHALL support _revinclude=Provenance:target. The Procedure search returns the Provenance whose target is Procedure/g10-defib-implant.",
    "resourceType": "TestScript",
    "test": [
        {
            "id": "01-revinclude",
            "name": "GET Procedure?patient=g10-example&_revinclude=Provenance:target",
            "action": [
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "search"
                        },
                        "resource": "Procedure",
                        "params": "patient=g10-example&_revinclude=Provenance:target",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "description": "The search answers 200",
                        "responseCode": "200",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "A searchset Bundle is returned",
                        "resource": "Bundle",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Procedure/g10-defib-implant is returned",
                        "expression": "Bundle.entry.resource.ofType(Procedure).where(id = 'g10-defib-implant').exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Provenance/g10-prov-procedure-defib-implant is included",
                        "expression": "Bundle.entry.resource.ofType(Provenance).where(id = 'g10-prov-procedure-defib-implant' and target.reference = 'Procedure/g10-defib-implant').exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                }
            ]
        }
    ]
}
