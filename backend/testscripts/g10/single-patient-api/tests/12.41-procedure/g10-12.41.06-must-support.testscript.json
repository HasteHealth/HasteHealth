{
    "id": "g10-12.41.06-must-support",
    "url": "https://haste.health/fhir/TestScript/g10-12.41.06-must-support",
    "name": "g10-12.41.06-must-support",
    "title": "12.41.06 Must support elements are returned",
    "status": "active",
    "description": "g10 12.41.06 (DAT-PAT-2; US Core 6.1.0: group 10.38). Every must support element of US Core Procedure Profile (including the USCDI ones) appears in at least one Procedure the server returns. The record's instances of the profile are fetched together by _id.",
    "resourceType": "TestScript",
    "test": [
        {
            "id": "01-must-support",
            "name": "Must support elements",
            "action": [
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "search"
                        },
                        "resource": "Procedure",
                        "params": "_id=g10-defib-implant,g10-rehab",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "description": "The search answers 200",
                        "responseCode": "200",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "A searchset Bundle is returned",
                        "resource": "Bundle",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Procedure.code is present",
                        "expression": "Bundle.entry.resource.ofType(Procedure).code.exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Procedure.encounter is present",
                        "expression": "Bundle.entry.resource.ofType(Procedure).encounter.exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Procedure.performedDateTime is present",
                        "expression": "Bundle.entry.resource.ofType(Procedure).performed.ofType(dateTime).exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Procedure.status is present",
                        "expression": "Bundle.entry.resource.ofType(Procedure).status.exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Procedure.subject is present",
                        "expression": "Bundle.entry.resource.ofType(Procedure).subject.exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Procedure.basedOn is present",
                        "expression": "Bundle.entry.resource.ofType(Procedure).basedOn.exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Procedure.reasonCode or Procedure.reasonReference is present",
                        "expression": "(Bundle.entry.resource.ofType(Procedure).reasonCode.exists() or Bundle.entry.resource.ofType(Procedure).reasonReference.exists())",
                        "value": "true",
                        "warningOnly": false
                    }
                }
            ]
        }
    ]
}
