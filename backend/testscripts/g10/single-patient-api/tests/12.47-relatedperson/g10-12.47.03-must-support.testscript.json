{
    "id": "g10-12.47.03-must-support",
    "url": "https://haste.health/fhir/TestScript/g10-12.47.03-must-support",
    "name": "g10-12.47.03-must-support",
    "title": "12.47.03 Must support elements are returned",
    "status": "active",
    "description": "g10 12.47.03 (DAT-PAT-2; US Core 6.1.0: group 10.43). Every must support element of US Core RelatedPerson Profile (including the USCDI ones) appears in at least one RelatedPerson the server returns. The record's instances of the profile are fetched together by _id.",
    "resourceType": "TestScript",
    "test": [
        {
            "id": "01-must-support",
            "name": "Must support elements",
            "action": [
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "search"
                        },
                        "resource": "RelatedPerson",
                        "params": "_id=g10-shaw-niece",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "description": "The search answers 200",
                        "responseCode": "200",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "A searchset Bundle is returned",
                        "resource": "Bundle",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "RelatedPerson.active is present",
                        "expression": "Bundle.entry.resource.ofType(RelatedPerson).active.exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "RelatedPerson.address is present",
                        "expression": "Bundle.entry.resource.ofType(RelatedPerson).address.exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "RelatedPerson.name is present",
                        "expression": "Bundle.entry.resource.ofType(RelatedPerson).name.exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "RelatedPerson.patient is present",
                        "expression": "Bundle.entry.resource.ofType(RelatedPerson).patient.exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "RelatedPerson.relationship is present",
                        "expression": "Bundle.entry.resource.ofType(RelatedPerson).relationship.exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "RelatedPerson.telecom is present",
                        "expression": "Bundle.entry.resource.ofType(RelatedPerson).telecom.exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                }
            ]
        }
    ]
}
