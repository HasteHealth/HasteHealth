{
    "id": "g10-12.3.03-provenance-revinclude",
    "url": "https://haste.health/fhir/TestScript/g10-12.3.03-provenance-revinclude",
    "name": "g10-12.3.03-provenance-revinclude",
    "title": "12.3.03 Provenance returned with _revinclude",
    "status": "active",
    "description": "g10 12.3.03 (SH-PAT-3, DAT-PAT-3; US Core 6.1.0: group 10.3). US Core Basic Provenance: a server SHALL support _revinclude=Provenance:target. The AllergyIntolerance search returns the Provenance whose target is AllergyIntolerance/g10-79613.",
    "resourceType": "TestScript",
    "test": [
        {
            "id": "01-revinclude",
            "name": "GET AllergyIntolerance?patient=g10-example&_revinclude=Provenance:target",
            "action": [
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "search"
                        },
                        "resource": "AllergyIntolerance",
                        "params": "patient=g10-example&_revinclude=Provenance:target",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "description": "The search answers 200",
                        "responseCode": "200",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "A searchset Bundle is returned",
                        "resource": "Bundle",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "AllergyIntolerance/g10-79613 is returned",
                        "expression": "Bundle.entry.resource.ofType(AllergyIntolerance).where(id = 'g10-79613').exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Provenance/g10-prov-allergyintolerance-79613 is included",
                        "expression": "Bundle.entry.resource.ofType(Provenance).where(id = 'g10-prov-allergyintolerance-79613' and target.reference = 'AllergyIntolerance/g10-79613').exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                }
            ]
        }
    ]
}
