{
    "id": "g10-12.19.05-provenance-revinclude",
    "url": "https://haste.health/fhir/TestScript/g10-12.19.05-provenance-revinclude",
    "name": "g10-12.19.05-provenance-revinclude",
    "title": "12.19.05 Provenance returned with _revinclude",
    "status": "active",
    "description": "g10 12.19.05 (SH-PAT-3, DAT-PAT-3; US Core 6.1.0: group 10.19). US Core Basic Provenance: a server SHALL support _revinclude=Provenance:target. The Observation search returns the Provenance whose target is Observation/g10-pregnancy-status.",
    "resourceType": "TestScript",
    "test": [
        {
            "id": "01-revinclude",
            "name": "GET Observation?patient=g10-example&code=82810-3&_revinclude=Provenance:target",
            "action": [
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "search"
                        },
                        "resource": "Observation",
                        "params": "patient=g10-example&code=82810-3&_revinclude=Provenance:target",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "description": "The search answers 200",
                        "responseCode": "200",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "A searchset Bundle is returned",
                        "resource": "Bundle",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Observation/g10-pregnancy-status is returned",
                        "expression": "Bundle.entry.resource.ofType(Observation).where(id = 'g10-pregnancy-status').exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Provenance/g10-prov-observation-pregnancy-status is included",
                        "expression": "Bundle.entry.resource.ofType(Provenance).where(id = 'g10-prov-observation-pregnancy-status' and target.reference = 'Observation/g10-pregnancy-status').exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                }
            ]
        }
    ]
}
