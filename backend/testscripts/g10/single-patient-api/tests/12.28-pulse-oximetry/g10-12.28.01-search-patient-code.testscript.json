{
    "id": "g10-12.28.01-search-patient-code",
    "url": "https://haste.health/fhir/TestScript/g10-12.28.01-search-patient-code",
    "name": "g10-12.28.01-search-patient-code",
    "title": "12.28.01 Server returns valid results for Observation search by patient + code",
    "status": "active",
    "description": "g10 12.28.01 (SH-PAT-2, DAT-PAT-7; US Core 6.1.0: group 10.26). Server returns valid results for Observation search by patient + code. US Core SHALL search. Every result must match every parameter, and the record's Observation/g10-oxygen-saturation must be among them.",
    "resourceType": "TestScript",
    "test": [
        {
            "id": "01-get-observation-patient-g10-example-code-2708-6",
            "name": "GET Observation?patient=g10-example&code=2708-6",
            "action": [
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "search"
                        },
                        "resource": "Observation",
                        "params": "patient=g10-example&code=2708-6",
                        "responseId": "main",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "description": "The search answers 200",
                        "responseCode": "200",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "A searchset Bundle is returned",
                        "resource": "Bundle",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Observation/g10-oxygen-saturation is returned",
                        "expression": "Bundle.entry.resource.ofType(Observation).where(id = 'g10-oxygen-saturation').exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Every Observation returned matches the search",
                        "expression": "Bundle.entry.resource.ofType(Observation).all((subject.reference.endsWith('Patient/g10-example')) and (code.coding.where(code = '2708-6').exists()))",
                        "value": "true",
                        "warningOnly": false
                    }
                }
            ]
        },
        {
            "id": "02-get-observation-patient-g10-example-code-59408-5",
            "name": "GET Observation?patient=g10-example&code=59408-5",
            "action": [
