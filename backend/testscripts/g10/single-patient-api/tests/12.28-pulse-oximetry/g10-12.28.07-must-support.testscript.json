                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Observation.component:Concentration.valueQuantity.code is present",
                        "expression": "Bundle.entry.resource.ofType(Observation).component.where(code.coding.where(system = 'http://loinc.org' and code = '3150-0').exists()).value.ofType(Quantity).code.where($this = '%').exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Observation.component:Concentration.valueQuantity.system is present",
                        "expression": "Bundle.entry.resource.ofType(Observation).component.where(code.coding.where(system = 'http://loinc.org' and code = '3150-0').exists()).value.ofType(Quantity).system.where($this = 'http://unitsofmeasure.org').exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Observation.component:Concentration.valueQuantity.unit is present",
                        "expression": "Bundle.entry.resource.ofType(Observation).component.where(code.coding.where(system = 'http://loinc.org' and code = '3150-0').exists()).value.ofType(Quantity).unit.exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Observation.component:Concentration.valueQuantity.value is present",
                        "expression": "Bundle.entry.resource.ofType(Observation).component.where(code.coding.where(system = 'http://loinc.org' and code = '3150-0').exists()).value.ofType(Quantity).value.exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Observation.component:FlowRate is present",
                        "expression": "Bundle.entry.resource.ofType(Observation).component.where(code.coding.where(system = 'http://loinc.org' and code = '3151-8').exists()).exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Observation.component:FlowRate.code is present",
                        "expression": "Bundle.entry.resource.ofType(Observation).component.where(code.coding.where(system = 'http://loinc.org' and code = '3151-8').exists()).code.exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Observation.component:FlowRate.valueQuantity is present",
                        "expression": "Bundle.entry.resource.ofType(Observation).component.where(code.coding.where(system = 'http://loinc.org' and code = '3151-8').exists()).value.ofType(Quantity).exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Observation.component:FlowRate.valueQuantity.code is present",
                        "expression": "Bundle.entry.resource.ofType(Observation).component.where(code.coding.where(system = 'http://loinc.org' and code = '3151-8').exists()).value.ofType(Quantity).code.where($this = 'L/min').exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Observation.component:FlowRate.valueQuantity.system is present",
                        "expression": "Bundle.entry.resource.ofType(Observation).component.where(code.coding.where(system = 'http://loinc.org' and code = '3151-8').exists()).value.ofType(Quantity).system.where($this = 'http://unitsofmeasure.org').exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Observation.component:FlowRate.valueQuantity.unit is present",
                        "expression": "Bundle.entry.resource.ofType(Observation).component.where(code.coding.where(system = 'http://loinc.org' and code = '3151-8').exists()).value.ofType(Quantity).unit.exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Observation.component:FlowRate.valueQuantity.value is present",
                        "expression": "Bundle.entry.resource.ofType(Observation).component.where(code.coding.where(system = 'http://loinc.org' and code = '3151-8').exists()).value.ofType(Quantity).value.exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Observation.effectiveDateTime is present",
                        "expression": "Bundle.entry.resource.ofType(Observation).effective.ofType(dateTime).exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Observation.status is present",
                        "expression": "Bundle.entry.resource.ofType(Observation).status.exists()",
                        "value": "true",
