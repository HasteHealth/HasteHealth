{
    "id": "g10-12.28.07-must-support",
    "url": "https://haste.health/fhir/TestScript/g10-12.28.07-must-support",
    "name": "g10-12.28.07-must-support",
    "title": "12.28.07 Must support elements are returned",
    "status": "active",
    "description": "g10 12.28.07 (DAT-PAT-2; US Core 6.1.0: group 10.26). Every must support element of US Core Pulse Oximetry Profile (including the USCDI ones) appears in at least one Observation the server returns. The record's instances of the profile are fetched together by _id.",
    "resourceType": "TestScript",
    "test": [
        {
            "id": "01-must-support",
            "name": "Must support elements",
            "action": [
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "search"
                        },
                        "resource": "Observation",
                        "params": "_id=g10-oxygen-saturation,g10-satO2-fiO2",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "description": "The search answers 200",
                        "responseCode": "200",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "A searchset Bundle is returned",
                        "resource": "Bundle",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Observation.category is present",
                        "expression": "Bundle.entry.resource.ofType(Observation).category.exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Observation.category:VSCat is present",
                        "expression": "Bundle.entry.resource.ofType(Observation).category.where(coding.where(code = 'vital-signs' and system = 'http://terminology.hl7.org/CodeSystem/observation-category').exists()).exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Observation.category:VSCat.coding is present",
                        "expression": "Bundle.entry.resource.ofType(Observation).category.where(coding.where(code = 'vital-signs' and system = 'http://terminology.hl7.org/CodeSystem/observation-category').exists()).coding.exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Observation.category:VSCat.coding.code is present",
                        "expression": "Bundle.entry.resource.ofType(Observation).category.where(coding.where(code = 'vital-signs' and system = 'http://terminology.hl7.org/CodeSystem/observation-category').exists()).coding.code.where($this = 'vital-signs').exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Observation.category:VSCat.coding.system is present",
                        "expression": "Bundle.entry.resource.ofType(Observation).category.where(coding.where(code = 'vital-signs' and system = 'http://terminology.hl7.org/CodeSystem/observation-category').exists()).coding.system.where($this = 'http://terminology.hl7.org/CodeSystem/observation-category').exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Observation.code is present",
                        "expression": "Bundle.entry.resource.ofType(Observation).code.exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Observation.code.coding is present",
                        "expression": "Bundle.entry.resource.ofType(Observation).code.coding.exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Observation.code.coding:O2Sat is present",
                        "expression": "Bundle.entry.resource.ofType(Observation).code.coding.where((system = 'http://loinc.org' and code = '2708-6')).exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Observation.code.coding:PulseOx is present",
                        "expression": "Bundle.entry.resource.ofType(Observation).code.coding.where((system = 'http://loinc.org' and code = '59408-5')).exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Observation.component is present",
                        "expression": "Bundle.entry.resource.ofType(Observation).component.exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Observation.component.code is present",
                        "expression": "Bundle.entry.resource.ofType(Observation).component.code.exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Observation.component.valueQuantity is present",
                        "expression": "Bundle.entry.resource.ofType(Observation).component.value.ofType(Quantity).exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Observation.component:Concentration is present",
                        "expression": "Bundle.entry.resource.ofType(Observation).component.where(code.coding.where(system = 'http://loinc.org' and code = '3150-0').exists()).exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
