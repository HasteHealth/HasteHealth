{
    "id": "g10-12.25.07-must-support",
    "url": "https://haste.health/fhir/TestScript/g10-12.25.07-must-support",
    "name": "g10-12.25.07-must-support",
    "title": "12.25.07 Must support elements are returned",
    "status": "active",
    "description": "g10 12.25.07 (DAT-PAT-2; US Core 6.1.0: group 10.23). Every must support element of US Core Heart Rate Profile (including the USCDI ones) appears in at least one Observation the server returns. The record's instances of the profile are fetched together by _id.",
    "resourceType": "TestScript",
    "test": [
        {
            "id": "01-must-support",
            "name": "Must support elements",
            "action": [
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "search"
                        },
                        "resource": "Observation",
                        "params": "_id=g10-heart-rate",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "description": "The search answers 200",
                        "responseCode": "200",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "A searchset Bundle is returned",
                        "resource": "Bundle",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Observation.category is present",
                        "expression": "Bundle.entry.resource.ofType(Observation).category.exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Observation.category:VSCat is present",
                        "expression": "Bundle.entry.resource.ofType(Observation).category.where(coding.where(code = 'vital-signs' and system = 'http://terminology.hl7.org/CodeSystem/observation-category').exists()).exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Observation.category:VSCat.coding is present",
                        "expression": "Bundle.entry.resource.ofType(Observation).category.where(coding.where(code = 'vital-signs' and system = 'http://terminology.hl7.org/CodeSystem/observation-category').exists()).coding.exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Observation.category:VSCat.coding.code is present",
                        "expression": "Bundle.entry.resource.ofType(Observation).category.where(coding.where(code = 'vital-signs' and system = 'http://terminology.hl7.org/CodeSystem/observation-category').exists()).coding.code.where($this = 'vital-signs').exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Observation.category:VSCat.coding.system is present",
                        "expression": "Bundle.entry.resource.ofType(Observation).category.where(coding.where(code = 'vital-signs' and system = 'http://terminology.hl7.org/CodeSystem/observation-category').exists()).coding.system.where($this = 'http://terminology.hl7.org/CodeSystem/observation-category').exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Observation.code.coding.code is present",
                        "expression": "Bundle.entry.resource.ofType(Observation).code.coding.code.where($this = '8867-4').exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Observation.effectiveDateTime is present",
                        "expression": "Bundle.entry.resource.ofType(Observation).effective.ofType(dateTime).exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Observation.status is present",
                        "expression": "Bundle.entry.resource.ofType(Observation).status.exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Observation.subject is present",
                        "expression": "Bundle.entry.resource.ofType(Observation).subject.exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Observation.valueQuantity is present",
                        "expression": "Bundle.entry.resource.ofType(Observation).value.ofType(Quantity).exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Observation.valueQuantity:valueQuantity.code is present",
                        "expression": "Bundle.entry.resource.ofType(Observation).value.ofType(Quantity).code.where($this = '/min').exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Observation.valueQuantity:valueQuantity.system is present",
                        "expression": "Bundle.entry.resource.ofType(Observation).value.ofType(Quantity).system.where($this = 'http://unitsofmeasure.org').exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Observation.valueQuantity:valueQuantity.unit is present",
                        "expression": "Bundle.entry.resource.ofType(Observation).value.ofType(Quantity).unit.exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Observation.valueQuantity:valueQuantity.value is present",
                        "expression": "Bundle.entry.resource.ofType(Observation).value.ofType(Quantity).value.exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Observation.value[x]:valueQuantity is present",
                        "expression": "Bundle.entry.resource.ofType(Observation).value.ofType(Quantity).exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                }
            ]
        }
    ]
}
