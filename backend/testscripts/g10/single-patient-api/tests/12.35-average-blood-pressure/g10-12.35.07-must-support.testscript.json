{
    "id": "g10-12.35.07-must-support",
    "url": "https://haste.health/fhir/TestScript/g10-12.35.07-must-support",
    "name": "g10-12.35.07-must-support",
    "title": "12.35.07 Must support elements are returned",
    "status": "active",
    "description": "g10 12.35.07 (DAT-PAT-2; US Core 6.1.0: group None). Every must support element of US Core Average Blood Pressure Profile (including the USCDI ones) appears in at least one Observation the server returns. The record's instances of the profile are fetched together by _id.",
    "resourceType": "TestScript",
    "test": [
        {
            "id": "01-must-support",
            "name": "Must support elements",
            "action": [
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "search"
                        },
                        "resource": "Observation",
                        "params": "_id=g10-average-blood-pressure,g10-average-blood-pressure-absent",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "description": "The search answers 200",
                        "responseCode": "200",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "A searchset Bundle is returned",
                        "resource": "Bundle",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Observation.category is present",
                        "expression": "Bundle.entry.resource.ofType(Observation).category.exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Observation.category:VSCat is present",
                        "expression": "Bundle.entry.resource.ofType(Observation).category.where(coding.where(code = 'vital-signs' and system = 'http://terminology.hl7.org/CodeSystem/observation-category').exists()).exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Observation.category:VSCat.coding is present",
                        "expression": "Bundle.entry.resource.ofType(Observation).category.where(coding.where(code = 'vital-signs' and system = 'http://terminology.hl7.org/CodeSystem/observation-category').exists()).coding.exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Observation.code.coding.code is present",
                        "expression": "Bundle.entry.resource.ofType(Observation).code.coding.code.where($this = '96607-7').exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Observation.component is present",
                        "expression": "Bundle.entry.resource.ofType(Observation).component.exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Observation.component.dataAbsentReason is present",
                        "expression": "Bundle.entry.resource.ofType(Observation).component.dataAbsentReason.exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Observation.component.valueQuantity is present",
                        "expression": "Bundle.entry.resource.ofType(Observation).component.value.ofType(Quantity).exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Observation.component:diastolic is present",
                        "expression": "Bundle.entry.resource.ofType(Observation).component.where(code.coding.where(system = 'http://loinc.org' and code = '96609-3').exists()).exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Observation.component:diastolic.code is present",
                        "expression": "Bundle.entry.resource.ofType(Observation).component.where(code.coding.where(system = 'http://loinc.org' and code = '96609-3').exists()).code.exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Observation.component:diastolic.value[x] is present",
                        "expression": "Bundle.entry.resource.ofType(Observation).component.where(code.coding.where(system = 'http://loinc.org' and code = '96609-3').exists()).value.exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Observation.component:systolic is present",
                        "expression": "Bundle.entry.resource.ofType(Observation).component.where(code.coding.where(system = 'http://loinc.org' and code = '96608-5').exists()).exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Observation.component:systolic.code is present",
                        "expression": "Bundle.entry.resource.ofType(Observation).component.where(code.coding.where(system = 'http://loinc.org' and code = '96608-5').exists()).code.exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Observation.component:systolic.value[x] is present",
                        "expression": "Bundle.entry.resource.ofType(Observation).component.where(code.coding.where(system = 'http://loinc.org' and code = '96608-5').exists()).value.exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Observation.effectivePeriod is present",
                        "expression": "Bundle.entry.resource.ofType(Observation).effective.ofType(Period).exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Observation.status is present",
                        "expression": "Bundle.entry.resource.ofType(Observation).status.exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Observation.subject is present",
                        "expression": "Bundle.entry.resource.ofType(Observation).subject.exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                }
            ]
        }
    ]
}
