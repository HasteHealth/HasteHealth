                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "read"
                        },
                        "resource": "Organization",
                        "targetId": "fixture-g10-acme-lab",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "description": "Organization/g10-acme-lab is read",
                        "responseCode": "200",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "A Organization is returned",
                        "resource": "Organization",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "It is the requested resource",
                        "expression": "Organization.id = 'g10-acme-lab'",
                        "value": "true",
