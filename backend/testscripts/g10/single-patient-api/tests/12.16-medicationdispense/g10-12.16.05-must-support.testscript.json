{
    "id": "g10-12.16.05-must-support",
    "url": "https://haste.health/fhir/TestScript/g10-12.16.05-must-support",
    "name": "g10-12.16.05-must-support",
    "title": "12.16.05 Must support elements are returned",
    "status": "active",
    "description": "g10 12.16.05 (DAT-PAT-2; US Core 6.1.0: group 10.16). Every must support element of US Core MedicationDispense Profile (including the USCDI ones) appears in at least one MedicationDispense the server returns. The record's instances of the profile are fetched together by _id.",
    "resourceType": "TestScript",
    "test": [
        {
            "id": "01-must-support",
            "name": "Must support elements",
            "action": [
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "search"
                        },
                        "resource": "MedicationDispense",
                        "params": "_id=g10-medicationdispense-example",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "description": "The search answers 200",
                        "responseCode": "200",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "A searchset Bundle is returned",
                        "resource": "Bundle",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "MedicationDispense.authorizingPrescription is present",
                        "expression": "Bundle.entry.resource.ofType(MedicationDispense).authorizingPrescription.exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "MedicationDispense.context is present",
                        "expression": "Bundle.entry.resource.ofType(MedicationDispense).context.exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "MedicationDispense.dosageInstruction is present",
                        "expression": "Bundle.entry.resource.ofType(MedicationDispense).dosageInstruction.exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "MedicationDispense.dosageInstruction.doseAndRate is present",
                        "expression": "Bundle.entry.resource.ofType(MedicationDispense).dosageInstruction.doseAndRate.exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "MedicationDispense.dosageInstruction.doseAndRate.doseQuantity is present",
                        "expression": "Bundle.entry.resource.ofType(MedicationDispense).dosageInstruction.doseAndRate.dose.ofType(Quantity).exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "MedicationDispense.dosageInstruction.text is present",
                        "expression": "Bundle.entry.resource.ofType(MedicationDispense).dosageInstruction.text.exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "MedicationDispense.dosageInstruction.timing is present",
                        "expression": "Bundle.entry.resource.ofType(MedicationDispense).dosageInstruction.timing.exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "MedicationDispense.medication[x] is present",
                        "expression": "Bundle.entry.resource.ofType(MedicationDispense).medication.exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "MedicationDispense.performer is present",
                        "expression": "Bundle.entry.resource.ofType(MedicationDispense).performer.exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "MedicationDispense.performer.actor is present",
                        "expression": "Bundle.entry.resource.ofType(MedicationDispense).performer.actor.exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "MedicationDispense.quantity is present",
                        "expression": "Bundle.entry.resource.ofType(MedicationDispense).quantity.exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "MedicationDispense.status is present",
                        "expression": "Bundle.entry.resource.ofType(MedicationDispense).status.exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "MedicationDispense.subject is present",
                        "expression": "Bundle.entry.resource.ofType(MedicationDispense).subject.exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "MedicationDispense.type is present",
                        "expression": "Bundle.entry.resource.ofType(MedicationDispense).type.exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "MedicationDispense.whenHandedOver is present",
                        "expression": "Bundle.entry.resource.ofType(MedicationDispense).whenHandedOver.exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                }
            ]
        }
    ]
}
