{
    "id": "g10-12.9.03-provenance-revinclude",
    "url": "https://haste.health/fhir/TestScript/g10-12.9.03-provenance-revinclude",
    "name": "g10-12.9.03-provenance-revinclude",
    "title": "12.9.03 Provenance returned with _revinclude",
    "status": "active",
    "description": "g10 12.9.03 (SH-PAT-3, DAT-PAT-3; US Core 6.1.0: group 10.9). US Core Basic Provenance: a server SHALL support _revinclude=Provenance:target. The Device search returns the Provenance whose target is Device/g10-udi-2.",
    "resourceType": "TestScript",
    "test": [
        {
            "id": "01-revinclude",
            "name": "GET Device?patient=g10-example&_revinclude=Provenance:target",
            "action": [
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "search"
                        },
                        "resource": "Device",
                        "params": "patient=g10-example&_revinclude=Provenance:target",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "description": "The search answers 200",
                        "responseCode": "200",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "A searchset Bundle is returned",
                        "resource": "Bundle",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Device/g10-udi-2 is returned",
                        "expression": "Bundle.entry.resource.ofType(Device).where(id = 'g10-udi-2').exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Provenance/g10-prov-device-udi-2 is included",
                        "expression": "Bundle.entry.resource.ofType(Provenance).where(id = 'g10-prov-device-udi-2' and target.reference = 'Device/g10-udi-2').exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                }
            ]
        }
    ]
}
