{
    "id": "g10-12.18.07-must-support",
    "url": "https://haste.health/fhir/TestScript/g10-12.18.07-must-support",
    "name": "g10-12.18.07-must-support",
    "title": "12.18.07 Must support elements are returned",
    "status": "active",
    "description": "g10 12.18.07 (DAT-PAT-2; US Core 6.1.0: group 10.18). Every must support element of US Core Laboratory Result Observation Profile (including the USCDI ones) appears in at least one Observation the server returns. The record's instances of the profile are fetched together by _id.",
    "resourceType": "TestScript",
    "test": [
        {
            "id": "01-must-support",
            "name": "Must support elements",
            "action": [
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "search"
                        },
                        "resource": "Observation",
                        "params": "_id=g10-at-home-in-vitro-test,g10-cbc-erythrocytes,g10-cbc-hematocrit,g10-cbc-hemoglobin,g10-cbc-leukocytes,g10-cbc-mch,g10-cbc-mchc,g10-cbc-mcv,g10-cbc-platelets,g10-lab-value-string,g10-serum-bun,g10-serum-calcium,g10-serum-chloride,g10-serum-co2,g10-serum-creatinine,g10-serum-glucose,g10-serum-potassium,g10-serum-sodium,g10-urobilinogen",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "description": "The search answers 200",
                        "responseCode": "200",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "A searchset Bundle is returned",
                        "resource": "Bundle",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Observation.category is present",
                        "expression": "Bundle.entry.resource.ofType(Observation).category.exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Observation.category:us-core is present",
                        "expression": "Bundle.entry.resource.ofType(Observation).category.where(coding.where(system = 'http://terminology.hl7.org/CodeSystem/observation-category' and code = 'laboratory').exists()).exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Observation.code is present",
                        "expression": "Bundle.entry.resource.ofType(Observation).code.exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Observation.effectiveDateTime is present",
                        "expression": "Bundle.entry.resource.ofType(Observation).effective.ofType(dateTime).exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Observation.encounter is present",
                        "expression": "Bundle.entry.resource.ofType(Observation).encounter.exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Observation.interpretation is present",
                        "expression": "Bundle.entry.resource.ofType(Observation).interpretation.exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Observation.meta is present",
                        "expression": "Bundle.entry.resource.ofType(Observation).meta.exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Observation.meta.lastUpdated is present",
                        "expression": "Bundle.entry.resource.ofType(Observation).meta.lastUpdated.exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Observation.referenceRange is present",
                        "expression": "Bundle.entry.resource.ofType(Observation).referenceRange.exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Observation.specimen is present",
                        "expression": "Bundle.entry.resource.ofType(Observation).specimen.exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Observation.status is present",
                        "expression": "Bundle.entry.resource.ofType(Observation).status.exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Observation.subject is present",
                        "expression": "Bundle.entry.resource.ofType(Observation).subject.exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Observation.valueCodeableConcept is present",
                        "expression": "Bundle.entry.resource.ofType(Observation).value.ofType(CodeableConcept).exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Observation.valueQuantity is present",
                        "expression": "Bundle.entry.resource.ofType(Observation).value.ofType(Quantity).exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Observation.valueString is present",
                        "expression": "Bundle.entry.resource.ofType(Observation).value.ofType(string).exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                }
            ]
        }
    ]
}
