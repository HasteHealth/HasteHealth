                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "description": "The search answers 200",
                        "responseCode": "200",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "A searchset Bundle is returned",
                        "resource": "Bundle",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Observation/g10-head-circumference is returned",
                        "expression": "Bundle.entry.resource.ofType(Observation).where(id = 'g10-head-circumference').exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Every Observation returned matches the search",
                        "expression": "Bundle.entry.resource.ofType(Observation).all((subject.reference.endsWith('Patient/g10-infant-example')) and (category.coding.where(system = 'http://terminology.hl7.org/CodeSystem/observation-category' and code = 'vital-signs').exists()))",
                        "value": "true",
                        "warningOnly": false
                    }
                }
            ]
        },
        {
            "id": "03-comparator-gt-get-observation-patient-g10-infant-example-category-vital-signs-date-gt2020-11-18t00-19-31z",
            "name": "Comparator gt: GET Observation?patient=g10-infant-example&category=vital-signs&date=gt2020-11-18T00:19:31Z",
            "description": "Every result's date satisfies gt (compared by day). As in Inferno, no result is required.",
            "action": [
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "search"
                        },
                        "resource": "Observation",
                        "params": "patient=g10-infant-example&category=vital-signs&date=gt2020-11-18T00:19:31Z",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "description": "The search answers 200",
                        "responseCode": "200",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "A searchset Bundle is returned",
                        "resource": "Bundle",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Every Observation returned matches the search",
                        "expression": "Bundle.entry.resource.ofType(Observation).all((subject.reference.endsWith('Patient/g10-infant-example')) and (category.coding.where(code = 'vital-signs').exists()) and (effective.ofType(dateTime).where($this.toString().substring(0, 10) >= '2020-11-18').exists() or effective.ofType(instant).where($this.toString().substring(0, 10) >= '2020-11-18').exists() or effective.ofType(date).where($this.toString().substring(0, 10) >= '2020-11-18').exists() or effective.ofType(Period).where(end.empty() or end.where($this.toString().substring(0, 10) >= '2020-11-18').exists()).exists()))",
                        "value": "true",
                        "warningOnly": false
                    }
                }
            ]
        },
