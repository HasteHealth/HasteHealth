{
    "id": "g10-12.31.02-search-patient-category-date",
    "url": "https://haste.health/fhir/TestScript/g10-12.31.02-search-patient-category-date",
    "name": "g10-12.31.02-search-patient-category-date",
    "title": "12.31.02 Server returns valid results for Observation search by patient + category + date",
    "status": "active",
    "description": "g10 12.31.02 (SH-PAT-2; US Core 6.1.0: group 10.29). Server returns valid results for Observation search by patient + category + date. US Core SHALL search. Every result must match every parameter, and the record's Observation/g10-head-circumference must be among them.",
    "resourceType": "TestScript",
    "test": [
        {
            "id": "01-get-observation-patient-g10-infant-example-category-vital-signs-date-2020-11-18t16-19-31-08-00",
            "name": "GET Observation?patient=g10-infant-example&category=vital-signs&date=2020-11-18T16:19:31-08:00",
            "action": [
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "search"
                        },
                        "resource": "Observation",
                        "params": "patient=g10-infant-example&category=vital-signs&date=2020-11-18T16:19:31-08:00",
                        "responseId": "main",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "description": "The search answers 200",
                        "responseCode": "200",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "A searchset Bundle is returned",
                        "resource": "Bundle",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Observation/g10-head-circumference is returned",
                        "expression": "Bundle.entry.resource.ofType(Observation).where(id = 'g10-head-circumference').exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Every Observation returned matches the search",
                        "expression": "Bundle.entry.resource.ofType(Observation).all((subject.reference.endsWith('Patient/g10-infant-example')) and (category.coding.where(code = 'vital-signs').exists()))",
                        "value": "true",
                        "warningOnly": false
                    }
                }
            ]
        },
        {
            "id": "02-token-system-code-form-get-observation-patient-g10-infant-example-category-http-terminology-hl7-org-codesystem-observation-category-vital-signs-date-2020-11-18t16-19-31-08-00",
            "name": "Token system|code form: GET Observation?patient=g10-infant-example&category=http://terminology.hl7.org/CodeSystem/observation-category|vital-signs&date=2020-11-18T16:19:31-08:00",
            "action": [
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "search"
