{
    "id": "g10-12.31.05-provenance-revinclude",
    "url": "https://haste.health/fhir/TestScript/g10-12.31.05-provenance-revinclude",
    "name": "g10-12.31.05-provenance-revinclude",
    "title": "12.31.05 Provenance returned with _revinclude",
    "status": "active",
    "description": "g10 12.31.05 (SH-PAT-3, DAT-PAT-3; US Core 6.1.0: group 10.29). US Core Basic Provenance: a server SHALL support _revinclude=Provenance:target. The Observation search returns the Provenance whose target is Observation/g10-head-circumference.",
    "resourceType": "TestScript",
    "test": [
        {
            "id": "01-revinclude",
            "name": "GET Observation?patient=g10-infant-example&code=9843-4&_revinclude=Provenance:target",
            "action": [
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "search"
                        },
                        "resource": "Observation",
                        "params": "patient=g10-infant-example&code=9843-4&_revinclude=Provenance:target",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "description": "The search answers 200",
                        "responseCode": "200",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "A searchset Bundle is returned",
                        "resource": "Bundle",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Observation/g10-head-circumference is returned",
                        "expression": "Bundle.entry.resource.ofType(Observation).where(id = 'g10-head-circumference').exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Provenance/g10-prov-observation-head-circumference is included",
                        "expression": "Bundle.entry.resource.ofType(Provenance).where(id = 'g10-prov-observation-head-circumference' and target.reference = 'Observation/g10-head-circumference').exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                }
            ]
        }
    ]
}
