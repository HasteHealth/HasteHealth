{
    "id": "g10-12.17.04-provenance-revinclude",
    "url": "https://haste.health/fhir/TestScript/g10-12.17.04-provenance-revinclude",
    "name": "g10-12.17.04-provenance-revinclude",
    "title": "12.17.04 Provenance returned with _revinclude",
    "status": "active",
    "description": "g10 12.17.04 (SH-PAT-3, DAT-PAT-3; US Core 6.1.0: group 10.17). US Core Basic Provenance: a server SHALL support _revinclude=Provenance:target. The MedicationRequest search returns the Provenance whose target is MedicationRequest/g10-medicationrequest-coded-oral-axid.",
    "resourceType": "TestScript",
    "test": [
        {
            "id": "01-revinclude",
            "name": "GET MedicationRequest?patient=g10-example&intent=order&_revinclude=Provenance:target",
            "action": [
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "search"
                        },
                        "resource": "MedicationRequest",
                        "params": "patient=g10-example&intent=order&_revinclude=Provenance:target",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "description": "The search answers 200",
                        "responseCode": "200",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "A searchset Bundle is returned",
                        "resource": "Bundle",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "MedicationRequest/g10-medicationrequest-coded-oral-axid is returned",
                        "expression": "Bundle.entry.resource.ofType(MedicationRequest).where(id = 'g10-medicationrequest-coded-oral-axid').exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Provenance/g10-prov-medicationrequest-medicationrequest-coded-oral-axid is included",
                        "expression": "Bundle.entry.resource.ofType(Provenance).where(id = 'g10-prov-medicationrequest-medicationrequest-coded-oral-axid' and target.reference = 'MedicationRequest/g10-medicationrequest-coded-oral-axid').exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                }
            ]
        }
    ]
}
