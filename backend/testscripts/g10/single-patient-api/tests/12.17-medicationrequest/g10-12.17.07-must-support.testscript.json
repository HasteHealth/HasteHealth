{
    "id": "g10-12.17.07-must-support",
    "url": "https://haste.health/fhir/TestScript/g10-12.17.07-must-support",
    "name": "g10-12.17.07-must-support",
    "title": "12.17.07 Must support elements are returned",
    "status": "active",
    "description": "g10 12.17.07 (DAT-PAT-2; US Core 6.1.0: group 10.17). Every must support element of US Core MedicationRequest Profile (including the USCDI ones) appears in at least one MedicationRequest the server returns. The record's instances of the profile are fetched together by _id.",
    "resourceType": "TestScript",
    "test": [
        {
            "id": "01-must-support",
            "name": "Must support elements",
            "action": [
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "search"
                        },
                        "resource": "MedicationRequest",
                        "params": "_id=g10-medicationrequest-coded-oral-axid,g10-medicationrequest-contained-oral-axid,g10-medicationrequest-referenced-oral-axid,g10-self-tylenol",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "description": "The search answers 200",
                        "responseCode": "200",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "A searchset Bundle is returned",
                        "resource": "Bundle",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "MedicationRequest.authoredOn is present",
                        "expression": "Bundle.entry.resource.ofType(MedicationRequest).authoredOn.exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "MedicationRequest.category is present",
                        "expression": "Bundle.entry.resource.ofType(MedicationRequest).category.exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "MedicationRequest.category:us-core is present",
                        "expression": "Bundle.entry.resource.ofType(MedicationRequest).category.where(coding.where(system = 'http://terminology.hl7.org/CodeSystem/medicationrequest-category' and (code = 'inpatient' or code = 'outpatient' or code = 'community' or code = 'discharge')).exists()).exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "MedicationRequest.dispenseRequest is present",
                        "expression": "Bundle.entry.resource.ofType(MedicationRequest).dispenseRequest.exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "MedicationRequest.dispenseRequest.numberOfRepeatsAllowed is present",
                        "expression": "Bundle.entry.resource.ofType(MedicationRequest).dispenseRequest.numberOfRepeatsAllowed.exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "MedicationRequest.dispenseRequest.quantity is present",
                        "expression": "Bundle.entry.resource.ofType(MedicationRequest).dispenseRequest.quantity.exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "MedicationRequest.dosageInstruction is present",
                        "expression": "Bundle.entry.resource.ofType(MedicationRequest).dosageInstruction.exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "MedicationRequest.dosageInstruction.doseAndRate is present",
                        "expression": "Bundle.entry.resource.ofType(MedicationRequest).dosageInstruction.doseAndRate.exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "MedicationRequest.dosageInstruction.doseAndRate.doseQuantity is present",
                        "expression": "Bundle.entry.resource.ofType(MedicationRequest).dosageInstruction.doseAndRate.dose.ofType(Quantity).exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "MedicationRequest.dosageInstruction.text is present",
                        "expression": "Bundle.entry.resource.ofType(MedicationRequest).dosageInstruction.text.exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "MedicationRequest.dosageInstruction.timing is present",
                        "expression": "Bundle.entry.resource.ofType(MedicationRequest).dosageInstruction.timing.exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "MedicationRequest.encounter is present",
                        "expression": "Bundle.entry.resource.ofType(MedicationRequest).encounter.exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "MedicationRequest.intent is present",
                        "expression": "Bundle.entry.resource.ofType(MedicationRequest).intent.exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "MedicationRequest.medication[x] is present",
                        "expression": "Bundle.entry.resource.ofType(MedicationRequest).medication.exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "MedicationRequest.reportedBoolean or MedicationRequest.reportedReference is present",
                        "expression": "(Bundle.entry.resource.ofType(MedicationRequest).reported.ofType(boolean).exists() or Bundle.entry.resource.ofType(MedicationRequest).reported.ofType(Reference).exists())",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "MedicationRequest.requester is present",
                        "expression": "Bundle.entry.resource.ofType(MedicationRequest).requester.exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "MedicationRequest.status is present",
                        "expression": "Bundle.entry.resource.ofType(MedicationRequest).status.exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "MedicationRequest.subject is present",
                        "expression": "Bundle.entry.resource.ofType(MedicationRequest).subject.exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "MedicationRequest.extension:medicationAdherence is present",
                        "expression": "Bundle.entry.resource.ofType(MedicationRequest).extension.where(url = 'http://hl7.org/fhir/us/core/StructureDefinition/us-core-medication-adherence').exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "MedicationRequest.reasonCode or MedicationRequest.reasonReference is present",
                        "expression": "(Bundle.entry.resource.ofType(MedicationRequest).reasonCode.exists() or Bundle.entry.resource.ofType(MedicationRequest).reasonReference.exists())",
                        "value": "true",
                        "warningOnly": false
                    }
                }
            ]
        }
    ]
}
