{
    "id": "g10-12.17.01-search-patient-intent",
    "url": "https://haste.health/fhir/TestScript/g10-12.17.01-search-patient-intent",
    "name": "g10-12.17.01-search-patient-intent",
    "title": "12.17.01 Server returns valid results for MedicationRequest search by patient + intent",
    "status": "active",
    "description": "g10 12.17.01 (SH-PAT-2, DAT-PAT-7; US Core 6.1.0: group 10.17). Server returns valid results for MedicationRequest search by patient + intent. US Core SHALL search. Every result must match every parameter, and the record's MedicationRequest/g10-medicationrequest-coded-oral-axid must be among them.",
    "resourceType": "TestScript",
    "test": [
        {
            "id": "01-get-medicationrequest-patient-g10-example-intent-order",
            "name": "GET MedicationRequest?patient=g10-example&intent=order",
            "action": [
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "search"
                        },
                        "resource": "MedicationRequest",
                        "params": "patient=g10-example&intent=order",
                        "responseId": "main",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "description": "The search answers 200",
                        "responseCode": "200",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "A searchset Bundle is returned",
                        "resource": "Bundle",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "MedicationRequest/g10-medicationrequest-coded-oral-axid is returned",
                        "expression": "Bundle.entry.resource.ofType(MedicationRequest).where(id = 'g10-medicationrequest-coded-oral-axid').exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Every MedicationRequest returned matches the search",
                        "expression": "Bundle.entry.resource.ofType(MedicationRequest).all((subject.reference.endsWith('Patient/g10-example')) and (intent = 'order'))",
                        "value": "true",
                        "warningOnly": false
                    }
                }
            ]
        },
        {
            "id": "02-reference-form-get-medicationrequest-patient-patient-g10-example-intent-order",
            "name": "Reference form: GET MedicationRequest?patient=Patient/g10-example&intent=order",
            "description": "patient=Patient/[id] returns what patient=[id] returns.",
            "action": [
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "search"
                        },
                        "resource": "MedicationRequest",
                        "params": "patient=Patient/g10-example&intent=order",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "description": "The search answers 200",
                        "responseCode": "200",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "A searchset Bundle is returned",
                        "resource": "Bundle",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "MedicationRequest/g10-medicationrequest-coded-oral-axid is returned",
                        "expression": "Bundle.entry.resource.ofType(MedicationRequest).where(id = 'g10-medicationrequest-coded-oral-axid').exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Every MedicationRequest returned matches the search",
                        "expression": "Bundle.entry.resource.ofType(MedicationRequest).all((subject.reference.endsWith('Patient/g10-example')) and (intent = 'order'))",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "It returns as many entries as patient=[id]",
                        "expression": "Bundle.entry.count()",
                        "compareToSourceId": "main",
                        "compareToSourceExpression": "Bundle.entry.count()",
                        "warningOnly": false
                    }
                }
            ]
        },
        {
            "id": "03-multiple-or-get-medicationrequest-patient-g10-example-intent-proposal-plan-order-original-order-reflex-order-filler-order-instance-order-option",
            "name": "Multiple-or: GET MedicationRequest?patient=g10-example&intent=proposal,plan,order,original-order,reflex-order,filler-order,instance-order,option",
            "action": [
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "search"
                        },
                        "resource": "MedicationRequest",
                        "params": "patient=g10-example&intent=proposal,plan,order,original-order,reflex-order,filler-order,instance-order,option",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "description": "The search answers 200",
                        "responseCode": "200",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "A searchset Bundle is returned",
                        "resource": "Bundle",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Every MedicationRequest returned has one of the values",
                        "expression": "Bundle.entry.resource.ofType(MedicationRequest).all(intent = 'proposal' or intent = 'plan' or intent = 'order' or intent = 'original-order' or intent = 'reflex-order' or intent = 'filler-order' or intent = 'instance-order' or intent = 'option')",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "A MedicationRequest with intent order is returned",
                        "expression": "Bundle.entry.resource.ofType(MedicationRequest).where(intent = 'order').exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "A MedicationRequest with intent plan is returned",
                        "expression": "Bundle.entry.resource.ofType(MedicationRequest).where(intent = 'plan').exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                }
            ]
        },
        {
            "id": "04-include-get-medicationrequest-patient-g10-example-intent-order-include-medicationrequest-medication",
            "name": "_include: GET MedicationRequest?patient=g10-example&intent=order&_include=MedicationRequest:medication",
            "action": [
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "search"
                        },
                        "resource": "MedicationRequest",
                        "params": "patient=g10-example&intent=order&_include=MedicationRequest:medication",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "description": "The search answers 200",
                        "responseCode": "200",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "A searchset Bundle is returned",
                        "resource": "Bundle",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Medication/g10-uscore-med2 is included",
                        "expression": "Bundle.entry.resource.ofType(Medication).where(id = 'g10-uscore-med2').exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Every included Medication is one the results reference",
                        "expression": "Bundle.entry.resource.ofType(Medication).all(id = 'g10-uscore-med2')",
                        "value": "true",
                        "warningOnly": false
                    }
                }
            ]
        },
        {
            "id": "05-post-medicationrequest-search-patient-g10-example-intent-order",
            "name": "POST MedicationRequest/_search?patient=g10-example&intent=order",
            "description": "Inferno posts the parameters as a form body, which a TestScript cannot send; this sends them in the query string of a POST with no body, which the server reads the same way.",
            "action": [
                {
                    "operation": {
                        "method": "post",
                        "url": "MedicationRequest/_search?patient=g10-example&intent=order",
                        "requestHeader": [
                            {
                                "field": "Content-Type",
                                "value": "application/x-www-form-urlencoded"
                            }
                        ],
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "description": "The search answers 200",
                        "responseCode": "200",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "A searchset Bundle is returned",
                        "resource": "Bundle",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "It returns as many entries as the GET",
                        "expression": "Bundle.entry.count()",
                        "compareToSourceId": "main",
                        "compareToSourceExpression": "Bundle.entry.count()",
                        "warningOnly": false
                    }
                }
            ]
        }
    ]
}
