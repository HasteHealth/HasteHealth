{
    "id": "g10-12.2.03-search-name",
    "url": "https://haste.health/fhir/TestScript/g10-12.2.03-search-name",
    "name": "g10-12.2.03-search-name",
    "title": "12.2.03 Server returns valid results for Patient search by name",
    "status": "active",
    "description": "g10 12.2.03 (SH-PAT-2; US Core 6.1.0: group 10.2). Server returns valid results for Patient search by name. US Core SHALL search. Every result must match every parameter, and the record's Patient/g10-child-example must be among them.",
    "resourceType": "TestScript",
    "test": [
        {
            "id": "01-get-patient-name-example",
            "name": "GET Patient?name=Example",
            "action": [
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "search"
                        },
                        "resource": "Patient",
                        "params": "name=Example",
                        "responseId": "main",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "description": "The search answers 200",
                        "responseCode": "200",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "A searchset Bundle is returned",
                        "resource": "Bundle",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Patient/g10-child-example is returned",
                        "expression": "Bundle.entry.resource.ofType(Patient).where(id = 'g10-child-example').exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Every Patient returned matches the search",
                        "expression": "Bundle.entry.resource.ofType(Patient).all((name.where(family.where($this.lower().startsWith('example')).exists() or given.where($this.lower().startsWith('example')).exists() or text.where($this.lower().startsWith('example')).exists()).exists()))",
                        "value": "true",
                        "warningOnly": false
                    }
                }
            ]
        }
    ]
}
