{
    "id": "g10-12.2.07-provenance-revinclude",
    "url": "https://haste.health/fhir/TestScript/g10-12.2.07-provenance-revinclude",
    "name": "g10-12.2.07-provenance-revinclude",
    "title": "12.2.07 Provenance returned with _revinclude",
    "status": "active",
    "description": "g10 12.2.07 (SH-PAT-3, DAT-PAT-3; US Core 6.1.0: group 10.2). US Core Basic Provenance: a server SHALL support _revinclude=Provenance:target. The Patient search returns the Provenance whose target is Patient/g10-child-example.",
    "resourceType": "TestScript",
    "test": [
        {
            "id": "01-revinclude",
            "name": "GET Patient?_id=g10-child-example&_revinclude=Provenance:target",
            "action": [
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "search"
                        },
                        "resource": "Patient",
                        "params": "_id=g10-child-example&_revinclude=Provenance:target",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "description": "The search answers 200",
                        "responseCode": "200",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "A searchset Bundle is returned",
                        "resource": "Bundle",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Patient/g10-child-example is returned",
                        "expression": "Bundle.entry.resource.ofType(Patient).where(id = 'g10-child-example').exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Provenance/g10-prov-patient-child-example is included",
                        "expression": "Bundle.entry.resource.ofType(Provenance).where(id = 'g10-prov-patient-child-example' and target.reference = 'Patient/g10-child-example').exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                }
            ]
        }
    ]
}
