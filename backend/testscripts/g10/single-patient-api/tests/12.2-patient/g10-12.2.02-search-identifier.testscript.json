{
    "id": "g10-12.2.02-search-identifier",
    "url": "https://haste.health/fhir/TestScript/g10-12.2.02-search-identifier",
    "name": "g10-12.2.02-search-identifier",
    "title": "12.2.02 Server returns valid results for Patient search by identifier",
    "status": "active",
    "description": "g10 12.2.02 (SH-PAT-2; US Core 6.1.0: group 10.2). Server returns valid results for Patient search by identifier. US Core SHALL search. Every result must match every parameter, and the record's Patient/g10-child-example must be among them.",
    "resourceType": "TestScript",
    "test": [
        {
            "id": "01-get-patient-identifier-1032704",
            "name": "GET Patient?identifier=1032704",
            "action": [
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "search"
                        },
                        "resource": "Patient",
                        "params": "identifier=1032704",
                        "responseId": "main",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "description": "The search answers 200",
                        "responseCode": "200",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "A searchset Bundle is returned",
                        "resource": "Bundle",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Patient/g10-child-example is returned",
                        "expression": "Bundle.entry.resource.ofType(Patient).where(id = 'g10-child-example').exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Every Patient returned matches the search",
                        "expression": "Bundle.entry.resource.ofType(Patient).all((identifier.where(value = '1032704').exists()))",
                        "value": "true",
                        "warningOnly": false
                    }
                }
            ]
        },
        {
            "id": "02-token-system-code-form-get-patient-identifier-http-example-org-patient-identifiers-1032704",
            "name": "Token system|code form: GET Patient?identifier=http://example.org/patient/identifiers|1032704",
            "action": [
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "search"
                        },
                        "resource": "Patient",
                        "params": "identifier=http://example.org/patient/identifiers|1032704",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "description": "The search answers 200",
                        "responseCode": "200",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "A searchset Bundle is returned",
                        "resource": "Bundle",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Patient/g10-child-example is returned",
                        "expression": "Bundle.entry.resource.ofType(Patient).where(id = 'g10-child-example').exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Every Patient returned matches the search",
                        "expression": "Bundle.entry.resource.ofType(Patient).all((identifier.where(system = 'http://example.org/patient/identifiers' and value = '1032704').exists()))",
                        "value": "true",
                        "warningOnly": false
                    }
                }
            ]
        }
    ]
}
