{
    "id": "g10-12.7.04-provenance-revinclude",
    "url": "https://haste.health/fhir/TestScript/g10-12.7.04-provenance-revinclude",
    "name": "g10-12.7.04-provenance-revinclude",
    "title": "12.7.04 Provenance returned with _revinclude",
    "status": "active",
    "description": "g10 12.7.04 (SH-PAT-3, DAT-PAT-3; US Core 6.1.0: group 10.7). US Core Basic Provenance: a server SHALL support _revinclude=Provenance:target. The Condition search returns the Provenance whose target is Condition/g10-condition-SDOH-example.",
    "resourceType": "TestScript",
    "test": [
        {
            "id": "01-revinclude",
            "name": "GET Condition?patient=g10-example&category=problem-list-item&_revinclude=Provenance:target",
            "action": [
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "search"
                        },
                        "resource": "Condition",
                        "params": "patient=g10-example&category=problem-list-item&_revinclude=Provenance:target",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "description": "The search answers 200",
                        "responseCode": "200",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "A searchset Bundle is returned",
                        "resource": "Bundle",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Condition/g10-condition-SDOH-example is returned",
                        "expression": "Bundle.entry.resource.ofType(Condition).where(id = 'g10-condition-SDOH-example').exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Provenance/g10-prov-condition-condition-SDOH-example is included",
                        "expression": "Bundle.entry.resource.ofType(Provenance).where(id = 'g10-prov-condition-condition-SDOH-example' and target.reference = 'Condition/g10-condition-SDOH-example').exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                }
            ]
        }
    ]
}
