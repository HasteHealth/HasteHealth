{
    "id": "g10-12.7.07-reference-resolution",
    "url": "https://haste.health/fhir/TestScript/g10-12.7.07-reference-resolution",
    "name": "g10-12.7.07-reference-resolution",
    "title": "12.7.07 Must support references resolve",
    "status": "active",
    "description": "g10 12.7.07 (DAT-PAT-2; US Core 6.1.0: group 10.7). Each must support reference of the record's Condition instances resolves with a read: subject -> Patient/g10-granular-patient. Conformance of each target to its profile is checked when the record is written.",
    "resourceType": "TestScript",
    "contained": [
        {
            "resourceType": "Patient",
            "id": "g10-granular-patient",
            "meta": {
                "tag": [
                    {
                        "system": "https://haste.health/fhir/testscript",
                        "code": "g10"
                    }
                ]
            },
            "identifier": [
                {
                    "system": "http://example.org/patient/identifiers",
                    "value": "g10-granular"
                }
            ],
            "name": [
                {
                    "family": "Granular",
                    "given": [
                        "Scope"
                    ]
                }
            ],
            "gender": "female",
            "birthDate": "1990-05-01"
        }
    ],
    "fixture": [
        {
            "id": "fixture-Patient-g10-granular-patient",
            "resource": {
                "reference": "#g10-granular-patient"
            },
            "autocreate": false,
            "autodelete": false
        }
    ],
    "test": [
        {
            "id": "01-references",
            "name": "Must support references",
            "action": [
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "read"
                        },
                        "resource": "Patient",
                        "targetId": "fixture-Patient-g10-granular-patient",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "description": "Patient/g10-granular-patient resolves",
                        "responseCode": "200",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "A Patient is returned",
                        "resource": "Patient",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "It is the referenced resource",
                        "expression": "Patient.id = 'g10-granular-patient'",
                        "value": "true",
                        "warningOnly": false
                    }
                }
            ]
        }
    ]
}
