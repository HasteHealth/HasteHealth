                        "expression": "Bundle.entry.resource.ofType(DiagnosticReport).where(id = 'g10-bone-density-report').exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Every DiagnosticReport returned matches the search",
                        "expression": "Bundle.entry.resource.ofType(DiagnosticReport).all((subject.reference.endsWith('Patient/g10-example')) and (category.coding.where(system = 'http://loinc.org' and code = 'LP29684-5').exists()))",
                        "value": "true",
                        "warningOnly": false
                    }
                }
            ]
        },
        {
            "id": "03-comparator-gt-get-diagnosticreport-patient-g10-example-category-lp29684-5-date-gt2021-11-10t03-30-46z",
            "name": "Comparator gt: GET DiagnosticReport?patient=g10-example&category=LP29684-5&date=gt2021-11-10T03:30:46Z",
            "description": "Every result's date satisfies gt (compared by day). As in Inferno, no result is required.",
            "action": [
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "search"
                        },
                        "resource": "DiagnosticReport",
                        "params": "patient=g10-example&category=LP29684-5&date=gt2021-11-10T03:30:46Z",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "description": "The search answers 200",
                        "responseCode": "200",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "A searchset Bundle is returned",
                        "resource": "Bundle",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Every DiagnosticReport returned matches the search",
                        "expression": "Bundle.entry.resource.ofType(DiagnosticReport).all((subject.reference.endsWith('Patient/g10-example')) and (category.coding.where(code = 'LP29684-5').exists()) and (effective.ofType(dateTime).where($this.toString().substring(0, 10) >= '2021-11-10').exists() or effective.ofType(instant).where($this.toString().substring(0, 10) >= '2021-11-10').exists() or effective.ofType(date).where($this.toString().substring(0, 10) >= '2021-11-10').exists() or effective.ofType(Period).where(end.empty() or end.where($this.toString().substring(0, 10) >= '2021-11-10').exists()).exists()))",
                        "value": "true",
                        "warningOnly": false
                    }
                }
            ]
        },
