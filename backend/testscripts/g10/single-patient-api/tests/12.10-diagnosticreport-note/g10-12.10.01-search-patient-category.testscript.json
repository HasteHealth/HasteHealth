        {
            "id": "06-post-diagnosticreport-search-patient-g10-example-category-lp29684-5",
            "name": "POST DiagnosticReport/_search?patient=g10-example&category=LP29684-5",
            "description": "Inferno posts the parameters as a form body, which a TestScript cannot send; this sends them in the query string of a POST with no body, which the server reads the same way.",
            "action": [
                {
                    "operation": {
                        "method": "post",
                        "url": "DiagnosticReport/_search?patient=g10-example&category=LP29684-5",
                        "requestHeader": [
                            {
