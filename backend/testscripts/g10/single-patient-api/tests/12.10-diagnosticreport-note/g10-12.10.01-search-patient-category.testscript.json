        {
            "id": "04-reference-form-get-diagnosticreport-patient-patient-g10-example-category-lp29684-5",
            "name": "Reference form: GET DiagnosticReport?patient=Patient/g10-example&category=LP29684-5",
            "description": "patient=Patient/[id] returns what patient=[id] returns.",
            "action": [
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "search"
                        },
                        "resource": "DiagnosticReport",
                        "params": "patient=Patient/g10-example&category=LP29684-5",
                        "encodeRequestUrl": false
