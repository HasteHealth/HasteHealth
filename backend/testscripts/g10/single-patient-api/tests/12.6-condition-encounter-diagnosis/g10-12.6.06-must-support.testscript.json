{
    "id": "g10-12.6.06-must-support",
    "url": "https://haste.health/fhir/TestScript/g10-12.6.06-must-support",
    "name": "g10-12.6.06-must-support",
    "title": "12.6.06 Must support elements are returned",
    "status": "active",
    "description": "g10 12.6.06 (DAT-PAT-2; US Core 6.1.0: group 10.6). Every must support element of US Core Condition Encounter Diagnosis Profile (including the USCDI ones) appears in at least one Condition the server returns. The record's instances of the profile are fetched together by _id.",
    "resourceType": "TestScript",
    "test": [
        {
            "id": "01-must-support",
            "name": "Must support elements",
            "action": [
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "search"
                        },
                        "resource": "Condition",
                        "params": "_id=g10-encounter-diagnosis-example1,g10-encounter-diagnosis-example2",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "description": "The search answers 200",
                        "responseCode": "200",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "A searchset Bundle is returned",
                        "resource": "Bundle",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Condition.abatementDateTime is present",
                        "expression": "Bundle.entry.resource.ofType(Condition).abatement.ofType(dateTime).exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Condition.category is present",
                        "expression": "Bundle.entry.resource.ofType(Condition).category.exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Condition.category:us-core is present",
                        "expression": "Bundle.entry.resource.ofType(Condition).category.where(coding.where(system = 'http://terminology.hl7.org/CodeSystem/condition-category' and code = 'encounter-diagnosis').exists()).exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Condition.code is present",
                        "expression": "Bundle.entry.resource.ofType(Condition).code.exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Condition.encounter is present",
                        "expression": "Bundle.entry.resource.ofType(Condition).encounter.exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Condition.recordedDate is present",
                        "expression": "Bundle.entry.resource.ofType(Condition).recordedDate.exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Condition.subject is present",
                        "expression": "Bundle.entry.resource.ofType(Condition).subject.exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                }
            ]
        }
    ]
}
