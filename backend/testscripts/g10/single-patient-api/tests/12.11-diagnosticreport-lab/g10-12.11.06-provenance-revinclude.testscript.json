{
    "id": "g10-12.11.06-provenance-revinclude",
    "url": "https://haste.health/fhir/TestScript/g10-12.11.06-provenance-revinclude",
    "name": "g10-12.11.06-provenance-revinclude",
    "title": "12.11.06 Provenance returned with _revinclude",
    "status": "active",
    "description": "g10 12.11.06 (SH-PAT-3, DAT-PAT-3; US Core 6.1.0: group 10.11). US Core Basic Provenance: a server SHALL support _revinclude=Provenance:target. The DiagnosticReport search returns the Provenance whose target is DiagnosticReport/g10-cbc.",
    "resourceType": "TestScript",
    "test": [
        {
            "id": "01-revinclude",
            "name": "GET DiagnosticReport?patient=g10-example&category=LAB&_revinclude=Provenance:target",
            "action": [
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "search"
                        },
                        "resource": "DiagnosticReport",
                        "params": "patient=g10-example&category=LAB&_revinclude=Provenance:target",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "description": "The search answers 200",
                        "responseCode": "200",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "A searchset Bundle is returned",
                        "resource": "Bundle",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "DiagnosticReport/g10-cbc is returned",
                        "expression": "Bundle.entry.resource.ofType(DiagnosticReport).where(id = 'g10-cbc').exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Provenance/g10-prov-diagnosticreport-cbc is included",
                        "expression": "Bundle.entry.resource.ofType(Provenance).where(id = 'g10-prov-diagnosticreport-cbc' and target.reference = 'DiagnosticReport/g10-cbc').exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                }
            ]
        }
    ]
}
