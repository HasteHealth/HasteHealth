{
    "id": "g10-12.11.04-search-patient-category-date",
    "url": "https://haste.health/fhir/TestScript/g10-12.11.04-search-patient-category-date",
    "name": "g10-12.11.04-search-patient-category-date",
    "title": "12.11.04 Server returns valid results for DiagnosticReport search by patient + category + date",
    "status": "active",
    "description": "g10 12.11.04 (SH-PAT-2; US Core 6.1.0: group 10.11). Server returns valid results for DiagnosticReport search by patient + category + date. US Core SHALL search. Every result must match every parameter, and the record's DiagnosticReport/g10-cbc must be among them.",
    "resourceType": "TestScript",
    "test": [
        {
            "id": "01-get-diagnosticreport-patient-g10-example-category-lab-date-2005-07-05",
            "name": "GET DiagnosticReport?patient=g10-example&category=LAB&date=2005-07-05",
            "action": [
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "search"
                        },
                        "resource": "DiagnosticReport",
                        "params": "patient=g10-example&category=LAB&date=2005-07-05",
                        "responseId": "main",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "description": "The search answers 200",
                        "responseCode": "200",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "A searchset Bundle is returned",
                        "resource": "Bundle",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "DiagnosticReport/g10-cbc is returned",
                        "expression": "Bundle.entry.resource.ofType(DiagnosticReport).where(id = 'g10-cbc').exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Every DiagnosticReport returned matches the search",
                        "expression": "Bundle.entry.resource.ofType(DiagnosticReport).all((subject.reference.endsWith('Patient/g10-example')) and (category.coding.where(code = 'LAB').exists()))",
                        "value": "true",
                        "warningOnly": false
                    }
                }
            ]
        },
        {
            "id": "02-token-system-code-form-get-diagnosticreport-patient-g10-example-category-http-terminology-hl7-org-codesystem-v2-0074-lab-date-2005-07-05",
            "name": "Token system|code form: GET DiagnosticReport?patient=g10-example&category=http://terminology.hl7.org/CodeSystem/v2-0074|LAB&date=2005-07-05",
            "action": [
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "search"
                        },
                        "resource": "DiagnosticReport",
                        "params": "patient=g10-example&category=http://terminology.hl7.org/CodeSystem/v2-0074|LAB&date=2005-07-05",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "description": "The search answers 200",
                        "responseCode": "200",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "A searchset Bundle is returned",
                        "resource": "Bundle",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "DiagnosticReport/g10-cbc is returned",
                        "expression": "Bundle.entry.resource.ofType(DiagnosticReport).where(id = 'g10-cbc').exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Every DiagnosticReport returned matches the search",
                        "expression": "Bundle.entry.resource.ofType(DiagnosticReport).all((subject.reference.endsWith('Patient/g10-example')) and (category.coding.where(system = 'http://terminology.hl7.org/CodeSystem/v2-0074' and code = 'LAB').exists()))",
                        "value": "true",
                        "warningOnly": false
                    }
                }
            ]
        },
        {
            "id": "03-comparator-gt-get-diagnosticreport-patient-g10-example-category-lab-date-gt2005-07-04",
            "name": "Comparator gt: GET DiagnosticReport?patient=g10-example&category=LAB&date=gt2005-07-04",
            "description": "Every result's date satisfies gt (compared by day). As in Inferno, no result is required.",
            "action": [
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "search"
                        },
                        "resource": "DiagnosticReport",
                        "params": "patient=g10-example&category=LAB&date=gt2005-07-04",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "description": "The search answers 200",
                        "responseCode": "200",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "A searchset Bundle is returned",
                        "resource": "Bundle",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Every DiagnosticReport returned matches the search",
                        "expression": "Bundle.entry.resource.ofType(DiagnosticReport).all((subject.reference.endsWith('Patient/g10-example')) and (category.coding.where(code = 'LAB').exists()) and (effective.ofType(dateTime).where($this.toString().substring(0, 10) >= '2005-07-04').exists() or effective.ofType(instant).where($this.toString().substring(0, 10) >= '2005-07-04').exists() or effective.ofType(date).where($this.toString().substring(0, 10) >= '2005-07-04').exists() or effective.ofType(Period).where(end.empty() or end.where($this.toString().substring(0, 10) >= '2005-07-04').exists()).exists()))",
                        "value": "true",
                        "warningOnly": false
                    }
                }
            ]
        },
