{
    "id": "g10-12.11.03-search-patient-code",
    "url": "https://haste.health/fhir/TestScript/g10-12.11.03-search-patient-code",
    "name": "g10-12.11.03-search-patient-code",
    "title": "12.11.03 Server returns valid results for DiagnosticReport search by patient + code",
    "status": "active",
    "description": "g10 12.11.03 (SH-PAT-2; US Core 6.1.0: group 10.11). Server returns valid results for DiagnosticReport search by patient + code. US Core SHALL search. Every result must match every parameter, and the record's DiagnosticReport/g10-cbc must be among them.",
    "resourceType": "TestScript",
    "test": [
        {
            "id": "01-get-diagnosticreport-patient-g10-example-code-58410-2",
            "name": "GET DiagnosticReport?patient=g10-example&code=58410-2",
            "action": [
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "search"
                        },
                        "resource": "DiagnosticReport",
                        "params": "patient=g10-example&code=58410-2",
                        "responseId": "main",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "description": "The search answers 200",
                        "responseCode": "200",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "A searchset Bundle is returned",
                        "resource": "Bundle",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "DiagnosticReport/g10-cbc is returned",
                        "expression": "Bundle.entry.resource.ofType(DiagnosticReport).where(id = 'g10-cbc').exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Every DiagnosticReport returned matches the search",
                        "expression": "Bundle.entry.resource.ofType(DiagnosticReport).all((subject.reference.endsWith('Patient/g10-example')) and (code.coding.where(code = '58410-2').exists()))",
                        "value": "true",
                        "warningOnly": false
                    }
                }
            ]
        },
        {
            "id": "02-token-system-code-form-get-diagnosticreport-patient-g10-example-code-http-loinc-org-58410-2",
            "name": "Token system|code form: GET DiagnosticReport?patient=g10-example&code=http://loinc.org|58410-2",
            "action": [
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "search"
                        },
                        "resource": "DiagnosticReport",
                        "params": "patient=g10-example&code=http://loinc.org|58410-2",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "description": "The search answers 200",
                        "responseCode": "200",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "A searchset Bundle is returned",
                        "resource": "Bundle",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "DiagnosticReport/g10-cbc is returned",
                        "expression": "Bundle.entry.resource.ofType(DiagnosticReport).where(id = 'g10-cbc').exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Every DiagnosticReport returned matches the search",
                        "expression": "Bundle.entry.resource.ofType(DiagnosticReport).all((subject.reference.endsWith('Patient/g10-example')) and (code.coding.where(system = 'http://loinc.org' and code = '58410-2').exists()))",
                        "value": "true",
                        "warningOnly": false
                    }
                }
            ]
        }
    ]
}
