{
    "id": "g10-12.11.08-must-support",
    "url": "https://haste.health/fhir/TestScript/g10-12.11.08-must-support",
    "name": "g10-12.11.08-must-support",
    "title": "12.11.08 Must support elements are returned",
    "status": "active",
    "description": "g10 12.11.08 (DAT-PAT-2; US Core 6.1.0: group 10.11). Every must support element of US Core DiagnosticReport Profile for Laboratory Results Reporting (including the USCDI ones) appears in at least one DiagnosticReport the server returns. The record's instances of the profile are fetched together by _id.",
    "resourceType": "TestScript",
    "test": [
        {
            "id": "01-must-support",
            "name": "Must support elements",
            "action": [
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "search"
                        },
                        "resource": "DiagnosticReport",
                        "params": "_id=g10-cbc,g10-metabolic-panel",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "description": "The search answers 200",
                        "responseCode": "200",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "A searchset Bundle is returned",
                        "resource": "Bundle",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "DiagnosticReport.category is present",
                        "expression": "Bundle.entry.resource.ofType(DiagnosticReport).category.exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "DiagnosticReport.category:LaboratorySlice is present",
                        "expression": "Bundle.entry.resource.ofType(DiagnosticReport).category.where(coding.where(system = 'http://terminology.hl7.org/CodeSystem/v2-0074' and code = 'LAB').exists()).exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "DiagnosticReport.code is present",
                        "expression": "Bundle.entry.resource.ofType(DiagnosticReport).code.exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "DiagnosticReport.effectiveDateTime is present",
                        "expression": "Bundle.entry.resource.ofType(DiagnosticReport).effective.ofType(dateTime).exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "DiagnosticReport.encounter is present",
                        "expression": "Bundle.entry.resource.ofType(DiagnosticReport).encounter.exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "DiagnosticReport.issued is present",
                        "expression": "Bundle.entry.resource.ofType(DiagnosticReport).issued.exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "DiagnosticReport.meta is present",
                        "expression": "Bundle.entry.resource.ofType(DiagnosticReport).meta.exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "DiagnosticReport.meta.lastUpdated is present",
                        "expression": "Bundle.entry.resource.ofType(DiagnosticReport).meta.lastUpdated.exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "DiagnosticReport.performer is present",
                        "expression": "Bundle.entry.resource.ofType(DiagnosticReport).performer.exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "DiagnosticReport.result is present",
                        "expression": "Bundle.entry.resource.ofType(DiagnosticReport).result.exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "DiagnosticReport.status is present",
                        "expression": "Bundle.entry.resource.ofType(DiagnosticReport).status.exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "DiagnosticReport.subject is present",
                        "expression": "Bundle.entry.resource.ofType(DiagnosticReport).subject.exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                }
            ]
        }
    ]
}
