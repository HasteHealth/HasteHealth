    "test": [
        {
            "id": "01-care-team-nurse",
            "name": "The care team nurse example stores one manifest entry for its constraint",
            "action": [
                {
                    "operation": {
                        "type": {
                            "code": "create"
                        },
                        "resource": "AccessPolicyV3",
                        "sourceId": "fixture-care-team-nurse",
                        "responseId": "r-care-team-nurse",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "description": "Created",
                        "expression": "AccessPolicyV3.id.exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "operation": {
                        "type": {
                            "code": "read"
                        },
                        "targetId": "r-care-team-nurse",
                        "responseId": "read-care-team-nurse",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "description": "One rule references attributes",
                        "expression": "AccessPolicyV3.manifest.count() = 1",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "The constraint is rule[0]",
                        "expression": "AccessPolicyV3.manifest.rule = 'rule[0]'",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "It needs careTeamPatients",
                        "expression": "AccessPolicyV3.manifest.attribute.attributeId = 'careTeamPatients'",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "A principal-scope attribute",
                        "expression": "AccessPolicyV3.manifest.attribute.scope = 'principal'",
                        "value": "true",
                        "warningOnly": false
                    }
                }
            ]
        },
        {
            "id": "02-no-attributes",
            "name": "A policy without attribute references stores an empty manifest, dropping the client's",
            "action": [
                {
                    "operation": {
                        "type": {
                            "code": "create"
                        },
                        "resource": "AccessPolicyV3",
                        "sourceId": "fixture-no-attributes",
                        "responseId": "r-no-attributes",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "description": "Created",
                        "expression": "AccessPolicyV3.id.exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "operation": {
                        "type": {
                            "code": "read"
                        },
                        "targetId": "r-no-attributes",
                        "responseId": "read-no-attributes",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "description": "No manifest",
                        "expression": "AccessPolicyV3.manifest.exists().not()",
                        "value": "true",
                        "warningOnly": false
                    }
                }
            ]
        },
        {
            "id": "03-request-scope",
            "name": "A condition may use %target and a declared request-scope attribute",
            "action": [
                {
                    "operation": {
                        "type": {
                            "code": "create"
                        },
                        "resource": "AccessPolicyV3",
                        "sourceId": "fixture-request-scope",
                        "responseId": "r-request-scope",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "description": "Created",
                        "expression": "AccessPolicyV3.id.exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "operation": {
                        "type": {
                            "code": "read"
                        },
                        "targetId": "r-request-scope",
                        "responseId": "read-request-scope",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "description": "Both are listed for rule[0]",
                        "expression": "AccessPolicyV3.manifest.where(rule = 'rule[0]').attribute.count() = 2",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "%target is a request-scope attribute",
                        "expression": "AccessPolicyV3.manifest.attribute.where(attributeId = 'target').scope = 'request'",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "The declared attribute keeps its scope",
                        "expression": "AccessPolicyV3.manifest.attribute.where(attributeId = 'encounter').scope = 'request'",
                        "value": "true",
                        "warningOnly": false
                    }
                }
            ]
        },
        {
            "id": "04-nested-rule",
            "name": "A nested rule is listed by its path, once per attribute",
