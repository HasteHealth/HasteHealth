                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Listed once",
                        "expression": "AccessPolicyV3.manifest.attribute.count() = 1",
                        "value": "true",
                        "warningOnly": false
                    }
                }
            ]
        },
