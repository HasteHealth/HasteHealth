{
    "id": "format-pretty-test",
    "url": "https://haste.health/fhir/TestScript/format-pretty-test",
    "title": "_format and _pretty checks",
    "name": "Format and Pretty tests",
    "status": "active",
    "description": "Validate the general _format and _pretty parameters on search (https://hl7.org/fhir/R4/http.html#parameters).",
    "resourceType": "TestScript",
    "contained": [
        {
            "id": "patient-format-pretty",
            "resourceType": "Patient",
            "meta": {
                "tag": [
                    {
                        "code": "format-pretty-test"
                    }
                ]
            },
            "active": true,
            "name": [
                {
                    "family": "Format",
                    "given": [
                        "Pretty"
                    ]
                }
            ]
        }
    ],
    "fixture": [
        {
            "id": "fixture-patient-create",
            "resource": {
                "reference": "#patient-format-pretty"
            },
            "autocreate": false,
            "autodelete": false
        }
    ],
    "test": [
        {
            "id": "01-format-json",
            "name": "_format=json returns the searchset.",
            "action": [
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "create"
                        },
                        "resource": "Patient",
                        "sourceId": "fixture-patient-create",
                        "responseId": "create-response",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "search"
                        },
                        "resource": "Patient",
                        "params": "_tag=format-pretty-test&_format=json",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "expression": "Bundle.type",
                        "operator": "equals",
                        "value": "searchset",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "expression": "Bundle.entry.count()",
                        "operator": "equals",
                        "value": "1",
                        "warningOnly": false
                    }
                }
            ]
        },
        {
            "id": "02-format-fhir-json",
            "name": "_format=application/fhir+json returns the searchset.",
            "action": [
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "search"
                        },
                        "resource": "Patient",
                        "params": "_tag=format-pretty-test&_format=application/fhir+json",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "expression": "Bundle.type",
                        "operator": "equals",
                        "value": "searchset",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "expression": "Bundle.entry.count()",
                        "operator": "equals",
                        "value": "1",
                        "warningOnly": false
                    }
                }
            ]
        },
        {
            "id": "03-format-application-json",
            "name": "_format=application/json returns the searchset.",
            "action": [
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "search"
                        },
                        "resource": "Patient",
                        "params": "_tag=format-pretty-test&_format=application/json",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "expression": "Bundle.type",
                        "operator": "equals",
                        "value": "searchset",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "expression": "Bundle.entry.count()",
                        "operator": "equals",
                        "value": "1",
                        "warningOnly": false
                    }
                }
            ]
        },
        {
            "id": "04-pretty-true",
            "name": "_pretty=true is accepted.",
            "action": [
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "search"
                        },
                        "resource": "Patient",
                        "params": "_tag=format-pretty-test&_pretty=true",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "expression": "Bundle.type",
                        "operator": "equals",
                        "value": "searchset",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "expression": "Bundle.entry.count()",
                        "operator": "equals",
                        "value": "1",
                        "warningOnly": false
                    }
                }
            ]
        },
        {
            "id": "05-format-unsupported",
            "name": "An unsupported _format is rejected.",
            "action": [
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "search"
                        },
                        "resource": "Patient",
                        "params": "_tag=format-pretty-test&_format=xml",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "label": "unsupported _format rejected",
                        "direction": "response",
                        "resource": "OperationOutcome",
                        "warningOnly": false
                    }
                }
            ]
        }
    ],
    "teardown": {
        "action": [
            {
                "operation": {
                    "type": {
                        "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                        "code": "deleteCondMultiple"
                    },
                    "params": "_tag=format-pretty-test",
                    "encodeRequestUrl": false
                }
            }
        ]
    }
}
