{
    "id": "limit-count-test",
    "url": "https://haste.health/fhir/TestScript/limit-count-test",
    "title": "Limit and count checks",
    "name": "Limit and Count tests",
    "status": "active",
    "resourceType": "TestScript",
    "contained": [
        {
            "id": "patient-chalmers",
            "resourceType": "Patient",
            "meta": {
                "tag": [
                    {
                        "code": "limit-count-test"
                    }
                ]
            },
            "name": [
                {
                    "family": "Chalmers",
                    "given": [
                        "Peter"
                    ]
                }
            ]
        }
    ],
    "fixture": [
        {
            "id": "fixture-patient-create",
            "resource": {
                "reference": "#patient-chalmers",
                "display": "Peter Chalmers"
            },
            "autocreate": false,
            "autodelete": false
        }
    ],
    "test": [
        {
            "id": "01-count-checks",
            "name": "Search Count checks.",
            "action": [
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "create"
                        },
                        "resource": "Patient",
                        "sourceId": "fixture-patient-create",
                        "responseId": "create-response",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "create"
                        },
                        "resource": "Patient",
                        "sourceId": "fixture-patient-create",
                        "responseId": "create-response",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "create"
                        },
                        "resource": "Patient",
                        "sourceId": "fixture-patient-create",
                        "responseId": "create-response",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "search"
                        },
                        "params": "_tag=limit-count-test",
                        "resource": "Patient",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "expression": "Bundle.entry.count()",
                        "operator": "equals",
                        "value": "3",
                        "warningOnly": false
                    }
                },
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "search"
                        },
                        "resource": "Patient",
                        "params": "_tag=limit-count-test&_count=2",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "expression": "Bundle.entry.count()",
                        "operator": "equals",
                        "value": "2",
                        "warningOnly": false
                    }
                },
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "search"
                        },
                        "resource": "Patient",
                        "params": "_tag=limit-count-test&_count=5",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "expression": "Bundle.entry.count()",
                        "operator": "equals",
                        "value": "3",
                        "warningOnly": false
                    }
                },
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "search"
                        },
                        "resource": "Patient",
                        "params": "_tag=limit-count-test&_count=-5",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "resource": "OperationOutcome",
                        "warningOnly": false
                    }
                }
            ]
        },
        {
            "id": "02-offset-checks",
            "name": "Search Offset checks.",
            "action": [
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "search"
                        },
                        "resource": "Patient",
                        "params": "_tag=limit-count-test&_offset=1",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "expression": "Bundle.entry.count()",
                        "operator": "equals",
                        "value": "2",
                        "warningOnly": false
                    }
                },
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "search"
                        },
                        "resource": "Patient",
                        "params": "_tag=limit-count-test&_offset=2",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "expression": "Bundle.entry.count()",
                        "operator": "equals",
                        "value": "1",
                        "warningOnly": false
                    }
                },
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "search"
                        },
                        "resource": "Patient",
                        "params": "_tag=limit-count-test&_offset=5",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "expression": "Bundle.entry.count()",
                        "operator": "equals",
                        "value": "0",
                        "warningOnly": false
                    }
                },
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "search"
                        },
                        "resource": "Patient",
                        "params": "_tag=limit-count-test&_offset=-1",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "resource": "OperationOutcome",
                        "warningOnly": false
                    }
                },
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "search"
                        },
                        "resource": "Patient",
                        "params": "_tag=limit-count-test&_offset=abc",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "resource": "OperationOutcome",
                        "warningOnly": false
                    }
                },
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "search"
                        },
                        "resource": "Patient",
                        "params": "_tag=limit-count-test&_count=abc",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "resource": "OperationOutcome",
                        "warningOnly": false
                    }
                }
            ]
        },
        {
            "id": "03-history-count-checks",
            "name": "History Count checks.",
            "action": [
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "history"
                        },
                        "resource": "Patient",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "expression": "Bundle.entry.count() > 0",
                        "operator": "equals",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "history"
                        },
                        "params": "_count=2",
                        "resource": "Patient",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "expression": "Bundle.entry.count()",
                        "operator": "equals",
                        "value": "2",
                        "warningOnly": false
                    }
                },
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "history"
                        },
                        "params": "_count=-2",
                        "resource": "Patient",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "resource": "OperationOutcome",
                        "warningOnly": false
                    }
                }
            ]
        },
        {
            "id": "04-history-offset-checks",
            "name": "History Offset checks.",
            "action": [
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "history"
                        },
                        "resource": "Patient",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "expression": "Bundle.entry.count() > 0",
                        "operator": "equals",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "history"
                        },
                        "params": "_offset=2",
                        "resource": "Patient",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "expression": "Bundle.entry.count() > 0",
                        "operator": "equals",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "history"
                        },
                        "params": "_offset=-2",
                        "resource": "Patient",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "resource": "OperationOutcome",
                        "warningOnly": false
                    }
                }
            ]
        },
        {
            "id": "05-total-checks",
            "name": "Search total checks.",
            "action": [
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "search"
                        },
                        "resource": "Patient",
                        "params": "_tag=limit-count-test&_count=1&_total=accurate",
                        "encodeRequestUrl": false,
                        "description": "A full first page, with an accurate total."
                    }
                },
                {
                    "assert": {
                        "description": "Accurate counts every match, not just the page.",
                        "expression": "Bundle.total",
                        "operator": "equals",
                        "value": "3",
                        "warningOnly": false
                    }
                },
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "search"
                        },
                        "resource": "Patient",
                        "params": "_tag=limit-count-test&_count=1&_offset=1&_total=accurate",
                        "encodeRequestUrl": false,
                        "description": "A full middle page, with an accurate total."
                    }
                },
                {
                    "assert": {
                        "description": "The total does not depend on the page.",
                        "expression": "Bundle.total",
                        "operator": "equals",
                        "value": "3",
                        "warningOnly": false
                    }
                },
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "search"
                        },
                        "resource": "Patient",
                        "params": "_tag=limit-count-test&_count=5&_total=accurate",
                        "encodeRequestUrl": false,
                        "description": "A short first page, with an accurate total."
                    }
                },
                {
                    "assert": {
                        "description": "A short page ends at the last match.",
                        "expression": "Bundle.total",
                        "operator": "equals",
                        "value": "3",
                        "warningOnly": false
                    }
                },
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "search"
                        },
                        "resource": "Patient",
                        "params": "_tag=limit-count-test&_count=1&_offset=2&_total=accurate",
                        "encodeRequestUrl": false,
                        "description": "The full last page, with an accurate total."
                    }
                },
                {
                    "assert": {
                        "description": "A full last page still counts.",
                        "expression": "Bundle.total",
                        "operator": "equals",
                        "value": "3",
                        "warningOnly": false
                    }
                },
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "search"
                        },
                        "resource": "Patient",
                        "params": "_tag=limit-count-test&_count=1&_offset=5&_total=accurate",
                        "encodeRequestUrl": false,
                        "description": "A page past the end, with an accurate total."
                    }
                },
                {
                    "assert": {
                        "description": "An empty page past the end still counts.",
                        "expression": "Bundle.total",
                        "operator": "equals",
                        "value": "3",
                        "warningOnly": false
                    }
                },
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "search"
                        },
                        "resource": "Patient",
                        "params": "_tag=limit-count-test&_count=1&_total=estimate",
                        "encodeRequestUrl": false,
                        "description": "A full first page, with an estimated total."
                    }
                },
                {
                    "assert": {
                        "description": "An estimate is exact for a small result.",
                        "expression": "Bundle.total",
                        "operator": "equals",
                        "value": "3",
                        "warningOnly": false
                    }
                },
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "search"
                        },
                        "resource": "Patient",
                        "params": "_tag=limit-count-test&_count=1&_total=none",
                        "encodeRequestUrl": false,
                        "description": "No total."
                    }
                },
                {
                    "assert": {
                        "description": "_total=none leaves the total out.",
                        "expression": "Bundle.total.exists()",
                        "operator": "equals",
                        "value": "false",
                        "warningOnly": false
                    }
                }
            ]
        },
        {
            "id": "06-count-zero-checks",
            "name": "Search _count=0 checks.",
            "action": [
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "search"
                        },
                        "resource": "Patient",
                        "params": "_tag=limit-count-test&_count=0",
                        "encodeRequestUrl": false,
                        "description": "Only the total, without _total."
                    }
                },
                {
                    "assert": {
                        "description": "The total is every match.",
                        "expression": "Bundle.total",
                        "operator": "equals",
                        "value": "3",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "No entries.",
                        "expression": "Bundle.entry.exists()",
                        "operator": "equals",
                        "value": "false",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "No paging links.",
                        "expression": "Bundle.link.where(relation = 'next' or relation = 'previous').exists()",
                        "operator": "equals",
                        "value": "false",
                        "warningOnly": false
                    }
                }
            ]
        }
    ],
    "teardown": {
        "action": [
            {
                "operation": {
                    "type": {
                        "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                        "code": "deleteCondMultiple"
                    },
                    "params": "_tag=limit-count-test",
                    "resource": "Patient",
                    "encodeRequestUrl": false
                }
            }
        ]
    }
