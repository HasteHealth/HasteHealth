    "test": [
        {
            "id": "01-crud-round-trip",
            "name": "Create, read, update and search round-trip; rules are sorted",
            "action": [
                {
                    "operation": {
                        "type": {
                            "code": "create"
                        },
                        "encodeRequestUrl": false,
                        "resource": "DeidentificationPolicy",
                        "sourceId": "fixture-valid",
                        "responseId": "r-create"
                    }
                },
                {
                    "assert": {
                        "description": "Created",
                        "expression": "DeidentificationPolicy.id.exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "operation": {
                        "type": {
                            "code": "read"
                        },
                        "encodeRequestUrl": false,
                        "targetId": "r-create",
                        "responseId": "r-read"
                    }
                },
                {
                    "assert": {
                        "description": "Rules round-trip",
                        "expression": "DeidentificationPolicy.rule.count()",
                        "value": "5",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Path rules sort first",
                        "expression": "DeidentificationPolicy.rule.first().target.path",
                        "value": "Patient.birthDate",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Type rules sort last",
                        "expression": "DeidentificationPolicy.rule.last().target.type",
                        "value": "dateTime",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Param kept",
                        "expression": "DeidentificationPolicy.rule.where(target.path = 'Patient.birthDate').param.ageOver",
                        "value": "89",
                        "warningOnly": false
                    }
                },
                {
                    "operation": {
                        "type": {
                            "code": "update"
                        },
                        "encodeRequestUrl": false,
                        "resource": "DeidentificationPolicy",
                        "targetId": "r-create",
                        "sourceId": "fixture-update",
                        "responseId": "r-update"
                    }
                },
                {
                    "assert": {
                        "description": "Updated",
                        "expression": "DeidentificationPolicy.version",
                        "value": "1.1.0",
                        "warningOnly": false
                    }
                },
                {
                    "operation": {
                        "type": {
                            "code": "search"
                        },
                        "encodeRequestUrl": false,
                        "resource": "DeidentificationPolicy",
                        "params": "url=http://example.org/deid/valid&status=active&_tag=deid-policy-validation"
                    }
                },
                {
                    "assert": {
                        "description": "Found by url",
                        "expression": "Bundle.entry.count()",
                        "value": "1",
                        "warningOnly": false,
                        "operator": "equals"
                    }
                },
                {
                    "operation": {
                        "type": {
                            "code": "delete"
                        },
                        "encodeRequestUrl": false,
                        "resource": "DeidentificationPolicy",
                        "targetId": "r-create"
                    }
                }
            ]
        },
        {
            "id": "02-reject-unknown-path",
            "name": "An unknown path is rejected and named",
            "action": [
                {
                    "operation": {
                        "type": {
                            "code": "create"
                        },
                        "encodeRequestUrl": false,
                        "resource": "DeidentificationPolicy",
                        "sourceId": "fixture-unknown-path",
                        "responseId": "r-unknown-path"
                    }
                },
                {
                    "assert": {
                        "description": "Refused with an OperationOutcome",
                        "expression": "OperationOutcome.issue.exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Names the path",
                        "expression": "OperationOutcome.issue.first().diagnostics.contains('Patient.birthDay')",
                        "value": "true",
                        "warningOnly": false
                    }
                }
            ]
        },
