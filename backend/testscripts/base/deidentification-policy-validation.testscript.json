{
    "resourceType": "TestScript",
    "id": "deidentification-policy-validation",
    "url": "https://haste.health/fhir/TestScript/deidentification-policy-validation",
    "name": "DeidentificationPolicy validation",
    "title": "DeidentificationPolicy validation",
    "status": "active",
    "description": "CRUD round-trips with rules sorted on save; unknown targets, unfitting params, duplicate targets and bad versions are rejected.",
    "contained": [
        {
            "resourceType": "DeidentificationPolicy",
            "id": "valid",
            "url": "http://example.org/deid/valid",
            "version": "1.0.0",
            "name": "valid",
            "status": "active",
            "default": "redact",
            "rule": [
                {
                    "target": {
                        "type": "dateTime"
                    },
                    "action": "dateShift",
                    "param": {
                        "rangeDays": 365
                    }
                },
                {
                    "target": {
                        "extension": "http://example.org/ext"
                    },
                    "action": "keep"
                },
                {
                    "target": {
                        "path": "Patient.birthDate"
                    },
                    "action": "generalize",
                    "param": {
                        "to": "year",
                        "ageOver": 89
                    }
                },
                {
                    "target": {
                        "type": "Identifier"
                    },
                    "action": "cryptoHash",
                    "param": {
                        "keep": [
                            "system"
                        ]
                    }
                },
                {
                    "target": {
                        "path": "Observation.valueQuantity"
                    },
                    "action": "keep"
                }
            ],
            "meta": {
                "tag": [
                    {
                        "code": "deid-policy-validation"
                    }
                ]
            }
        },
