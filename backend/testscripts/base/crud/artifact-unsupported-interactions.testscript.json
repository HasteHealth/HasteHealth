{
    "id": "artifact-unsupported-interactions",
    "name": "Artifact unsupported interactions",
    "title": "Artifact unsupported interactions",
    "status": "active",
    "url": "https://haste.health/fhir/TestScript/artifact-unsupported-interactions",
    "description": "History and vread are not served for artifact resources. The server says so with a not-supported outcome instead of failing.",
    "resourceType": "TestScript",
    "contained": [
        {
            "id": "artifact-unsupported-valueset",
            "resourceType": "ValueSet",
            "meta": {
                "tag": [
                    {
                        "code": "artifact-unsupported-test"
                    }
                ]
            },
            "status": "draft",
            "name": "ArtifactUnsupportedInteractions"
        }
    ],
    "fixture": [
        {
            "id": "fixture-valueset",
            "resource": {
                "reference": "#artifact-unsupported-valueset"
            },
            "autocreate": false,
            "autodelete": false
        }
    ],
    "setup": {
        "action": [
            {
                "operation": {
                    "type": {
                        "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                        "code": "create"
                    },
                    "encodeRequestUrl": false,
                    "resource": "ValueSet",
                    "sourceId": "fixture-valueset",
                    "responseId": "valueset-response"
                }
            },
            {
                "assert": {
                    "label": "valueset created",
                    "direction": "response",
                    "resource": "ValueSet",
                    "warningOnly": false
                }
            }
        ]
    },
    "test": [
        {
            "id": "history-and-vread",
            "name": "History and vread are not supported",
            "description": "Instance history, type history and vread of a ValueSet each return a not-supported OperationOutcome.",
            "action": [
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "history"
                        },
                        "encodeRequestUrl": false,
                        "resource": "ValueSet",
                        "targetId": "valueset-response"
                    }
                },
                {
                    "assert": {
                        "label": "instance history refused",
                        "direction": "response",
                        "resource": "OperationOutcome",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "label": "instance history not supported",
                        "expression": "OperationOutcome.issue[0].code",
                        "value": "not-supported",
                        "warningOnly": false
                    }
                },
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "history"
                        },
                        "encodeRequestUrl": false,
                        "resource": "ValueSet"
                    }
                },
                {
                    "assert": {
                        "label": "type history refused",
                        "direction": "response",
                        "resource": "OperationOutcome",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "label": "type history not supported",
                        "expression": "OperationOutcome.issue[0].code",
                        "value": "not-supported",
                        "warningOnly": false
                    }
                },
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "vread"
                        },
                        "encodeRequestUrl": false,
                        "targetId": "valueset-response"
                    }
                },
                {
                    "assert": {
                        "label": "vread refused",
                        "direction": "response",
                        "resource": "OperationOutcome",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "label": "vread not supported",
                        "expression": "OperationOutcome.issue[0].code",
                        "value": "not-supported",
                        "warningOnly": false
                    }
                }
            ]
        }
    ],
    "teardown": {
        "action": [
            {
                "operation": {
                    "type": {
                        "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                        "code": "deleteCondMultiple"
                    },
                    "encodeRequestUrl": false,
                    "resource": "ValueSet",
                    "params": "_tag=artifact-unsupported-test",
                    "description": "Delete ValueSet resources created in test."
                }
            }
        ]
    }
}
