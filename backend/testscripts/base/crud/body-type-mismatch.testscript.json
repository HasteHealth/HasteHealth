{
    "id": "body-type-mismatch",
    "url": "https://haste.health/fhir/TestScript/body-type-mismatch",
    "name": "Create and update reject a body of another type",
    "title": "Body type mismatch",
    "status": "active",
    "description": "A create or update whose body is another resource type than the request names is refused with an invalid OperationOutcome (HTTP 400) instead of storing the body under its own type. Sent as transaction entries: the REST endpoints already refuse such a body while parsing it, but bundle entries (and the MCP tools) reach the server's check.",
    "resourceType": "TestScript",
    "contained": [
        {
            "resourceType": "Patient",
            "meta": {
                "tag": [
                    {
                        "code": "body-type-mismatch-test"
                    }
                ]
            },
            "name": [
                {
                    "family": "Original"
                }
            ],
            "id": "type-mismatch-target"
        },
        {
            "id": "create-mismatch",
            "resourceType": "Bundle",
            "type": "transaction",
            "entry": [
                {
                    "resource": {
                        "resourceType": "Patient",
                        "meta": {
                            "tag": [
                                {
                                    "code": "body-type-mismatch-test"
                                }
                            ]
                        },
                        "name": [
                            {
                                "family": "Created"
                            }
                        ]
                    },
                    "request": {
                        "method": "POST",
                        "url": "Observation"
                    }
                }
            ]
        },
        {
            "id": "update-mismatch",
            "resourceType": "Bundle",
            "type": "transaction",
            "entry": [
                {
                    "resource": {
                        "resourceType": "Patient",
                        "meta": {
                            "tag": [
                                {
                                    "code": "body-type-mismatch-test"
                                }
                            ]
                        },
                        "name": [
                            {
                                "family": "Replaced"
                            }
                        ],
                        "id": "type-mismatch-target"
                    },
                    "request": {
                        "method": "PUT",
                        "url": "Observation/type-mismatch-target"
                    }
                }
            ]
        }
    ],
    "fixture": [
        {
            "id": "fixture-patient",
            "resource": {
                "reference": "#type-mismatch-target"
            },
            "autocreate": false,
            "autodelete": false
        },
        {
            "id": "fixture-create-mismatch",
            "resource": {
                "reference": "#create-mismatch"
            },
            "autocreate": false,
            "autodelete": false
        },
        {
            "id": "fixture-update-mismatch",
            "resource": {
                "reference": "#update-mismatch"
            },
            "autocreate": false,
            "autodelete": false
        }
    ],
    "setup": {
        "action": [
            {
                "operation": {
                    "type": {
                        "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                        "code": "update"
                    },
                    "resource": "Patient",
                    "targetId": "fixture-patient",
                    "sourceId": "fixture-patient",
                    "description": "Creates the Patient with its fixture id.",
                    "encodeRequestUrl": false
                }
            },
            {
                "assert": {
                    "label": "patient stored",
                    "direction": "response",
                    "resource": "Patient",
                    "warningOnly": false
                }
            }
        ]
    },
    "test": [
        {
            "id": "create-mismatch",
            "name": "Create with a body of another type",
            "description": "Creating an Observation with a Patient body is refused.",
            "action": [
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "transaction"
                        },
                        "sourceId": "fixture-create-mismatch",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "label": "create refused",
                        "direction": "response",
                        "resource": "OperationOutcome",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "label": "create refused as invalid",
                        "expression": "OperationOutcome.issue[0].code",
                        "value": "invalid",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "label": "create names both types",
                        "expression": "OperationOutcome.issue[0].diagnostics.contains('Patient') and OperationOutcome.issue[0].diagnostics.contains('Observation')",
                        "value": "true",
                        "warningOnly": false
                    }
                }
            ]
        },
        {
            "id": "update-mismatch",
            "name": "Update with a body of another type",
            "description": "Updating Observation/<id> with a Patient body of the same id is refused and leaves the Patient unchanged.",
            "action": [
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "transaction"
                        },
                        "sourceId": "fixture-update-mismatch",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "label": "update refused",
                        "direction": "response",
                        "resource": "OperationOutcome",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "label": "update refused as invalid",
                        "expression": "OperationOutcome.issue[0].code",
                        "value": "invalid",
                        "warningOnly": false
                    }
                },
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "read"
                        },
                        "resource": "Patient",
                        "targetId": "fixture-patient",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "label": "patient unchanged",
                        "expression": "Patient.name.family",
                        "value": "Original",
                        "warningOnly": false
                    }
                }
            ]
        }
    ],
    "teardown": {
        "action": [
            {
                "operation": {
                    "type": {
                        "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                        "code": "deleteCondMultiple"
                    },
                    "resource": "Patient",
                    "params": "_tag=body-type-mismatch-test",
                    "description": "Delete Patients created in test.",
                    "encodeRequestUrl": false
                }
            }
        ]
    }
}
