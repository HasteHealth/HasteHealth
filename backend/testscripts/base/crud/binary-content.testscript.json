{
    "resourceType": "TestScript",
    "id": "binary-content",
    "url": "https://haste.health/fhir/TestScript/binary-content",
    "name": "BinaryContent",
    "title": "Binary content round trip",
    "status": "active",
    "description": "Binary content comes back unchanged from create, read, vread, history, update, patch, search and transaction, and every version keeps its own content. Large content may be kept in document storage instead of the database; the results must not depend on it.",
    "contained": [
