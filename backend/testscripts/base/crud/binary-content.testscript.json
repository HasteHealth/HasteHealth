    "variable": [
        {
            "name": "BinaryId",
            "sourceId": "create-response",
            "expression": "Binary.id"
        }
    ],
    "test": [
        {
            "id": "01-create-read",
            "name": "Create, read and vread return the content",
            "action": [
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "create"
                        },
                        "encodeRequestUrl": false,
                        "resource": "Binary",
                        "sourceId": "fixture-binary-large-v1",
                        "responseId": "create-response"
                    }
                },
                {
                    "assert": {
                        "description": "Response is 201",
                        "warningOnly": false,
                        "responseCode": "201"
                    }
                },
                {
                    "assert": {
                        "description": "Create returns the content",
                        "warningOnly": false,
                        "expression": "Binary.data",
                        "operator": "equals",
                        "compareToSourceId": "fixture-binary-large-v1",
                        "compareToSourceExpression": "Binary.data"
                    }
                },
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "read"
                        },
                        "encodeRequestUrl": false,
                        "resource": "Binary",
                        "targetId": "create-response"
                    }
                },
                {
                    "assert": {
                        "description": "Response is 200",
                        "warningOnly": false,
                        "responseCode": "200"
                    }
                },
                {
                    "assert": {
                        "description": "Read returns the content",
                        "warningOnly": false,
                        "expression": "Binary.data",
                        "operator": "equals",
                        "compareToSourceId": "fixture-binary-large-v1",
                        "compareToSourceExpression": "Binary.data"
                    }
                },
                {
                    "assert": {
                        "description": "Read returns the content type",
                        "warningOnly": false,
                        "expression": "Binary.contentType",
                        "operator": "equals",
                        "value": "application/octet-stream"
                    }
                },
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "vread"
                        },
                        "encodeRequestUrl": false,
                        "resource": "Binary",
                        "targetId": "create-response"
                    }
                },
                {
                    "assert": {
                        "description": "Response is 200",
                        "warningOnly": false,
                        "responseCode": "200"
                    }
                },
                {
                    "assert": {
                        "description": "Vread returns the content",
                        "warningOnly": false,
                        "expression": "Binary.data",
                        "operator": "equals",
                        "compareToSourceId": "fixture-binary-large-v1",
                        "compareToSourceExpression": "Binary.data"
                    }
                }
            ]
        },
        {
            "id": "02-update-history",
            "name": "Each version keeps its own content",
            "action": [
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "update"
                        },
                        "encodeRequestUrl": false,
                        "resource": "Binary",
                        "targetId": "create-response",
                        "sourceId": "fixture-binary-large-v2",
                        "responseId": "update-response"
                    }
                },
                {
                    "assert": {
                        "description": "Response is 200",
                        "warningOnly": false,
                        "responseCode": "200"
                    }
                },
                {
                    "assert": {
                        "description": "Update returns the new content",
                        "warningOnly": false,
                        "expression": "Binary.data",
                        "operator": "equals",
                        "compareToSourceId": "fixture-binary-large-v2",
                        "compareToSourceExpression": "Binary.data"
                    }
                },
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "read"
                        },
                        "encodeRequestUrl": false,
                        "resource": "Binary",
                        "targetId": "create-response"
                    }
                },
                {
                    "assert": {
                        "description": "Read returns the new content",
                        "warningOnly": false,
                        "expression": "Binary.data",
                        "operator": "equals",
                        "compareToSourceId": "fixture-binary-large-v2",
                        "compareToSourceExpression": "Binary.data"
                    }
                },
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "vread"
                        },
                        "encodeRequestUrl": false,
                        "resource": "Binary",
                        "targetId": "create-response"
                    }
                },
                {
                    "assert": {
                        "description": "Vread of the first version returns the first content",
                        "warningOnly": false,
                        "expression": "Binary.data",
                        "operator": "equals",
                        "compareToSourceId": "fixture-binary-large-v1",
                        "compareToSourceExpression": "Binary.data"
                    }
                },
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "history"
                        },
                        "encodeRequestUrl": false,
                        "resource": "Binary",
                        "targetId": "create-response"
                    }
                },
                {
                    "assert": {
                        "description": "Response is 200",
                        "warningOnly": false,
                        "responseCode": "200"
                    }
                },
                {
                    "assert": {
                        "description": "Two versions",
                        "warningOnly": false,
                        "expression": "Bundle.entry.count()",
                        "operator": "equals",
                        "value": "2"
                    }
                },
                {
                    "assert": {
                        "description": "Newest version has the new content",
                        "warningOnly": false,
                        "expression": "Bundle.entry[0].resource.data",
                        "operator": "equals",
                        "compareToSourceId": "fixture-binary-large-v2",
                        "compareToSourceExpression": "Binary.data"
                    }
                },
                {
                    "assert": {
                        "description": "Oldest version has the first content",
                        "warningOnly": false,
                        "expression": "Bundle.entry[1].resource.data",
                        "operator": "equals",
                        "compareToSourceId": "fixture-binary-large-v1",
                        "compareToSourceExpression": "Binary.data"
                    }
                }
            ]
        },
        {
            "id": "03-patch",
            "name": "A patch that changes the content type keeps the content",
            "action": [
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "patch"
                        },
                        "encodeRequestUrl": false,
                        "resource": "Binary",
                        "targetId": "create-response",
                        "sourceId": "fixture-patch-content-type",
                        "responseId": "patch-response"
                    }
                },
                {
                    "assert": {
                        "description": "Response is 200",
                        "warningOnly": false,
                        "responseCode": "200"
                    }
                },
                {
                    "assert": {
                        "description": "Content type changed",
                        "warningOnly": false,
                        "expression": "Binary.contentType",
                        "operator": "equals",
                        "value": "application/pdf"
                    }
                },
                {
                    "assert": {
                        "description": "Content kept",
                        "warningOnly": false,
                        "expression": "Binary.data",
                        "operator": "equals",
                        "compareToSourceId": "fixture-binary-large-v2",
                        "compareToSourceExpression": "Binary.data"
                    }
                },
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "read"
                        },
                        "encodeRequestUrl": false,
                        "resource": "Binary",
                        "targetId": "create-response"
                    }
                },
                {
                    "assert": {
                        "description": "Read sees the new content type",
                        "warningOnly": false,
                        "expression": "Binary.contentType",
                        "operator": "equals",
                        "value": "application/pdf"
                    }
                },
                {
                    "assert": {
                        "description": "Read sees the content",
                        "warningOnly": false,
                        "expression": "Binary.data",
                        "operator": "equals",
                        "compareToSourceId": "fixture-binary-large-v2",
                        "compareToSourceExpression": "Binary.data"
                    }
                }
            ]
        },
        {
            "id": "04-search",
            "name": "Search results carry the content",
            "action": [
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "search"
                        },
                        "encodeRequestUrl": false,
                        "resource": "Binary",
                        "params": "?_id=${BinaryId}"
                    }
                },
                {
                    "assert": {
                        "description": "Response is 200",
                        "warningOnly": false,
                        "responseCode": "200"
                    }
                },
                {
                    "assert": {
                        "description": "One match",
                        "warningOnly": false,
                        "expression": "Bundle.entry.count()",
                        "operator": "equals",
                        "value": "1"
                    }
                },
                {
                    "assert": {
                        "description": "The match has the content",
                        "warningOnly": false,
                        "expression": "Bundle.entry.resource.data",
                        "operator": "equals",
                        "compareToSourceId": "fixture-binary-large-v2",
                        "compareToSourceExpression": "Binary.data"
                    }
                }
            ]
        },
        {
            "id": "05-small",
            "name": "Small content round-trips",
            "action": [
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "create"
                        },
                        "encodeRequestUrl": false,
                        "resource": "Binary",
                        "sourceId": "fixture-binary-small",
                        "responseId": "small-response"
                    }
                },
                {
                    "assert": {
                        "description": "Response is 201",
                        "warningOnly": false,
                        "responseCode": "201"
                    }
                },
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "read"
                        },
                        "encodeRequestUrl": false,
                        "resource": "Binary",
                        "targetId": "small-response"
                    }
                },
                {
                    "assert": {
                        "description": "Response is 200",
                        "warningOnly": false,
                        "responseCode": "200"
                    }
                },
                {
                    "assert": {
                        "description": "Read returns the content",
                        "warningOnly": false,
                        "expression": "Binary.data",
                        "operator": "equals",
                        "compareToSourceId": "fixture-binary-small",
                        "compareToSourceExpression": "Binary.data"
                    }
                }
            ]
        },
        {
            "id": "06-transaction",
            "name": "A Binary created in a transaction keeps its content",
            "action": [
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "transaction"
                        },
                        "encodeRequestUrl": false,
                        "sourceId": "fixture-transaction-binary"
                    }
                },
                {
                    "assert": {
                        "description": "Response is 200",
                        "warningOnly": false,
                        "responseCode": "200"
                    }
                },
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "read"
                        },
                        "encodeRequestUrl": false,
                        "resource": "Binary",
                        "targetId": "fixture-binary-content-transaction"
                    }
                },
                {
                    "assert": {
                        "description": "Response is 200",
                        "warningOnly": false,
                        "responseCode": "200"
                    }
                },
                {
                    "assert": {
                        "description": "Read returns the content",
                        "warningOnly": false,
                        "expression": "Binary.data",
                        "operator": "equals",
                        "compareToSourceId": "fixture-transaction-binary",
                        "compareToSourceExpression": "Bundle.entry.resource.data"
                    }
                },
                {
                    "assert": {
                        "description": "Read returns the content type",
                        "warningOnly": false,
                        "expression": "Binary.contentType",
                        "operator": "equals",
                        "value": "image/png"
                    }
                }
            ]
        },
        {
            "id": "07-delete",
            "name": "Earlier versions keep their content after a delete",
            "action": [
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "delete"
                        },
                        "encodeRequestUrl": false,
                        "resource": "Binary",
                        "targetId": "create-response"
                    }
                },
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "read"
                        },
                        "encodeRequestUrl": false,
                        "resource": "Binary",
                        "targetId": "create-response"
                    }
                },
                {
                    "assert": {
                        "description": "Deleted",
                        "warningOnly": false,
                        "response": "notFound"
                    }
                },
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "vread"
                        },
                        "encodeRequestUrl": false,
                        "resource": "Binary",
                        "targetId": "update-response"
                    }
                },
                {
                    "assert": {
                        "description": "Response is 200",
                        "warningOnly": false,
                        "responseCode": "200"
                    }
                },
                {
                    "assert": {
                        "description": "The second version still has its content",
                        "warningOnly": false,
                        "expression": "Binary.data",
                        "operator": "equals",
                        "compareToSourceId": "fixture-binary-large-v2",
                        "compareToSourceExpression": "Binary.data"
                    }
                }
            ]
        },
        {
            "id": "08-client-marker",
            "name": "A document storage marker a client sends is ignored",
            "description": "Only the server sets the marker extension on Binary.data. One sent by a client is dropped before the Binary is stored, so it can neither point the server at a document nor survive the write.",
            "action": [
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "create"
                        },
                        "encodeRequestUrl": false,
                        "resource": "Binary",
                        "sourceId": "fixture-binary-client-marker",
                        "responseId": "client-marker-response"
                    }
                },
                {
                    "assert": {
                        "description": "Response is 201",
                        "warningOnly": false,
                        "responseCode": "201"
                    }
                },
                {
                    "assert": {
                        "description": "Create returns the content",
                        "warningOnly": false,
                        "expression": "Binary.data",
                        "operator": "equals",
                        "value": "YSBtYXJrZXIgYSBjbGllbnQgc2VuZHMgaXMgaWdub3JlZA=="
                    }
                },
                {
                    "assert": {
                        "description": "Create carries no document storage marker",
                        "warningOnly": false,
                        "expression": "Binary.data.extension.where(url = 'https://haste.health/document-storage').exists()",
                        "value": "false"
                    }
                },
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "read"
                        },
                        "encodeRequestUrl": false,
                        "resource": "Binary",
                        "targetId": "client-marker-response"
                    }
                },
                {
                    "assert": {
                        "description": "Response is 200",
                        "warningOnly": false,
                        "responseCode": "200"
                    }
                },
                {
                    "assert": {
                        "description": "Read returns the content",
                        "warningOnly": false,
                        "expression": "Binary.data",
                        "operator": "equals",
                        "value": "YSBtYXJrZXIgYSBjbGllbnQgc2VuZHMgaXMgaWdub3JlZA=="
                    }
                },
                {
                    "assert": {
                        "description": "Read carries no document storage marker",
                        "warningOnly": false,
                        "expression": "Binary.data.extension.where(url = 'https://haste.health/document-storage').exists()",
                        "value": "false"
                    }
                }
            ]
        }
    ],
    "teardown": {
        "action": [
