            "resource": {
                "reference": "#binary-large-v1"
            },
            "autocreate": false,
            "autodelete": false
        },
        {
            "id": "fixture-binary-large-v2",
            "resource": {
                "reference": "#binary-large-v2"
            },
            "autocreate": false,
            "autodelete": false
        },
        {
            "id": "fixture-binary-small",
            "resource": {
                "reference": "#binary-small"
            },
            "autocreate": false,
