            "data": ""
        },
        {
            "id": "binary-large-v2",
            "resourceType": "Binary",
            "meta": {
                "tag": [
                    {
                        "code": "binary-content-test"
                    }
                ]
            },
            "contentType": "application/octet-stream",
            "data": ""
        },
        {
            "id": "binary-small",
