{
    "id": "capability-project-profiles",
    "url": "https://haste.health/fhir/TestScript/capability-project-profiles",
    "name": "capability-project-profiles",
    "title": "CapabilityStatement lists the project's profiles and search parameters",
    "status": "active",
    "description": "A constraint StructureDefinition and a SearchParameter created in the project appear in metadata without a restart.",
    "resourceType": "TestScript",
    "contained": [
        {
            "id": "profile",
            "resourceType": "StructureDefinition",
            "url": "https://haste.health/fhir/StructureDefinition/capability-test-patient",
            "name": "CapabilityTestPatient",
            "status": "active",
            "kind": "resource",
            "abstract": false,
            "type": "Patient",
            "baseDefinition": "http://hl7.org/fhir/StructureDefinition/Patient",
            "derivation": "constraint"
        },
        {
            "id": "search-parameter",
            "resourceType": "SearchParameter",
            "url": "https://haste.health/fhir/SearchParameter/capability-test-patient-nickname",
            "name": "capability-test-nickname",
            "status": "active",
            "description": "Patient nickname used to test capability listing.",
            "code": "capability-test-nickname",
            "base": ["Patient"],
            "type": "string",
            "expression": "Patient.name.where(use = 'nickname').given"
        }
    ],
    "fixture": [
        {
            "id": "fixture-profile",
            "resource": { "reference": "#profile" },
            "autocreate": false,
            "autodelete": false
        },
        {
            "id": "fixture-search-parameter",
            "resource": { "reference": "#search-parameter" },
            "autocreate": false,
            "autodelete": false
        }
    ],
    "test": [
        {
            "id": "create-and-list",
            "name": "Created profile and search parameter are listed",
            "action": [
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "create"
                        },
                        "resource": "StructureDefinition",
                        "sourceId": "fixture-profile",
                        "responseId": "profile-response",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": { "responseCode": "201", "warningOnly": false }
                },
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "create"
                        },
                        "resource": "SearchParameter",
                        "sourceId": "fixture-search-parameter",
                        "responseId": "search-parameter-response",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": { "responseCode": "201", "warningOnly": false }
                },
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "capabilities"
                        },
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "description": "The profile is listed under Patient",
                        "expression": "CapabilityStatement.rest.resource.where(type = 'Patient').supportedProfile.where($this = 'https://haste.health/fhir/StructureDefinition/capability-test-patient').exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "The search parameter is listed under Patient",
                        "expression": "CapabilityStatement.rest.resource.where(type = 'Patient').searchParam.where(name = 'capability-test-nickname').exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                }
            ]
        }
    ],
    "teardown": {
        "action": [
            {
                "operation": {
                    "type": {
                        "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                        "code": "delete"
                    },
                    "resource": "StructureDefinition",
                    "targetId": "profile-response",
                    "encodeRequestUrl": false
                }
            },
            {
                "operation": {
                    "type": {
                        "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                        "code": "delete"
                    },
                    "resource": "SearchParameter",
                    "targetId": "search-parameter-response",
                    "encodeRequestUrl": false
                }
            }
        ]
    }
}
