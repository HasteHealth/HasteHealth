                "reference": "#deny-with-obligation"
            },
            "autocreate": false,
            "autodelete": false
        },
        {
            "id": "fixture-deny-with-field",
            "resource": {
                "reference": "#deny-with-field"
            },
            "autocreate": false,
            "autodelete": false
        }
    ],
    "test": [
        {
            "id": "01-example-valid",
            "name": "The care team nurse example is accepted",
            "action": [
                {
                    "operation": {
                        "type": {
                            "code": "create"
                        },
                        "resource": "AccessPolicyV3",
                        "sourceId": "fixture-example",
                        "responseId": "r-example",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "description": "Created",
                        "expression": "AccessPolicyV3.id.exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "operation": {
                        "type": {
                            "code": "read"
                        },
                        "targetId": "r-example",
                        "responseId": "r-read",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "description": "Round-trips rules",
                        "expression": "AccessPolicyV3.rule.count()",
                        "value": "3",
                        "warningOnly": false
                    }
                }
            ]
        },
        {
            "id": "02-reject-decision-with-data",
            "name": "A decision rule with data is rejected",
            "action": [
                {
                    "operation": {
                        "type": {
                            "code": "create"
                        },
                        "resource": "AccessPolicyV3",
                        "sourceId": "fixture-decision-with-data",
                        "responseId": "r-decision-with-data",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "description": "Refused with an OperationOutcome",
                        "expression": "OperationOutcome.issue.exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                }
            ]
        },
        {
            "id": "03-reject-constraint-with-condition",
