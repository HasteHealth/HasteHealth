{
    "id": "http-assertions",
    "title": "HTTP-level assertions",
    "name": "HTTP Assertions",
    "status": "active",
    "url": "https://haste.health/fhir/TestScript/http-assertions",
    "description": "Checks HTTP status codes, response headers and content types, including on requests that are not FHIR interactions (the job status URL) and on the CORS headers a browser client needs.",
    "resourceType": "TestScript",
    "contained": [
        {
            "id": "patient-http",
            "resourceType": "Patient",
            "meta": {
                "tag": [
                    {
                        "code": "http-assertions-test"
                    }
                ]
            },
            "name": [
                {
                    "family": "Header",
                    "given": [
                        "Status"
                    ]
                }
            ]
        },
        {
            "id": "http-assertions-missing-patient",
            "resourceType": "Patient"
        }
    ],
    "fixture": [
        {
            "id": "fixture-patient-create",
            "resource": {
                "reference": "#patient-http"
            },
            "autocreate": false,
            "autodelete": false
        },
        {
            "id": "fixture-patient-missing",
            "resource": {
                "reference": "#http-assertions-missing-patient"
            },
            "autocreate": false,
            "autodelete": false
        }
    ],
    "setup": {
        "action": [
            {
                "operation": {
                    "type": {
                        "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                        "code": "create"
                    },
                    "resource": "Patient",
                    "sourceId": "fixture-patient-create",
                    "responseId": "create-response",
                    "encodeRequestUrl": false
                }
            }
        ]
    },
    "test": [
        {
            "id": "create-response",
            "name": "Create response",
            "description": "A create answers 201 Created with the version in ETag.",
            "action": [
                {
                    "assert": {
                        "label": "Create is 201",
                        "responseCode": "201",
                        "sourceId": "create-response",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "label": "Create is created",
                        "response": "created",
                        "sourceId": "create-response",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "label": "Create code is one of 200 or 201",
                        "responseCode": "200,201",
                        "operator": "in",
                        "sourceId": "create-response",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "label": "Create carries an ETag",
                        "headerField": "ETag",
                        "operator": "notEmpty",
                        "sourceId": "create-response",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "label": "ETag is weak",
                        "headerField": "ETag",
                        "operator": "contains",
                        "value": "W/",
                        "sourceId": "create-response",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "label": "Create is FHIR JSON",
                        "contentType": "application/fhir+json",
                        "sourceId": "create-response",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "label": "Create sends no X-Progress",
                        "headerField": "X-Progress",
                        "operator": "empty",
                        "sourceId": "create-response",
                        "warningOnly": false
                    }
                }
            ]
        },
        {
            "id": "read-missing",
            "name": "Read of a missing resource",
            "description": "A read of an id that does not exist answers 404 with an OperationOutcome.",
            "action": [
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "read"
                        },
                        "resource": "Patient",
                        "targetId": "fixture-patient-missing",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "label": "Missing read is notFound",
                        "response": "notFound",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "label": "Missing read is not 200",
                        "responseCode": "200",
                        "operator": "notEquals",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "label": "Missing read returns an OperationOutcome",
                        "resource": "OperationOutcome",
                        "warningOnly": false
                    }
                }
            ]
        },
        {
            "id": "url-only-request",
            "name": "Request outside the FHIR interactions",
            "description": "An operation with a url and no type is sent as a plain HTTP request, relative to the FHIR base and authenticated: the status URL of a job that does not exist answers 404 (not 401) with an OperationOutcome.",
            "action": [
                {
                    "operation": {
                        "method": "get",
                        "url": "../../jobs/http-assertions-no-such-job",
                        "responseId": "unknown-job",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "label": "Unknown job is 404",
                        "responseCode": "404",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "label": "Unknown job body is an OperationOutcome",
                        "resource": "OperationOutcome",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "label": "Unknown job issue is not-found",
                        "expression": "OperationOutcome.issue.first().code",
                        "value": "not-found",
                        "warningOnly": false
                    }
                },
                {
                    "operation": {
                        "method": "delete",
                        "url": "../../jobs/http-assertions-no-such-job",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "label": "Cancelling an unknown job is 404",
                        "responseCode": "404",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "label": "The earlier response is still addressable",
                        "responseCode": "404",
                        "sourceId": "unknown-job",
                        "warningOnly": false
                    }
                }
            ]
        },
        {
            "id": "poll-timeout",
            "name": "Polling stops at its timeout",
            "description": "The poll extension repeats a request while its response has the given status, and gives up at the timeout with the last response.",
            "action": [
                {
                    "operation": {
                        "extension": [
                            {
                                "url": "https://haste.health/fhir/StructureDefinition/testscript-poll",
                                "extension": [
                                    {
                                        "url": "whileResponseCode",
                                        "valueString": "404"
                                    },
                                    {
                                        "url": "timeoutSeconds",
                                        "valueInteger": 1
                                    }
                                ]
                            }
                        ],
                        "method": "get",
                        "url": "../../jobs/http-assertions-no-such-job",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "label": "Polled request still 404 after the timeout",
                        "responseCode": "404",
                        "warningOnly": false
                    }
                }
            ]
        },
        {
            "id": "cors-exposed-headers",
            "name": "CORS exposed headers",
            "description": "A cross-origin request may read the headers a browser client needs: the status URL of an asynchronous request, its polling hints, and the version.",
            "action": [
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "capabilities"
                        },
                        "requestHeader": [
                            {
                                "field": "Origin",
                                "value": "https://example.org"
                            }
                        ],
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "label": "Capabilities is okay",
                        "response": "okay",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "label": "Any origin is allowed",
                        "headerField": "Access-Control-Allow-Origin",
                        "value": "*",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "label": "Content-Location is exposed",
                        "headerField": "Access-Control-Expose-Headers",
                        "operator": "contains",
                        "value": "content-location",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "label": "ETag is exposed",
                        "headerField": "Access-Control-Expose-Headers",
                        "operator": "contains",
                        "value": "etag",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "label": "Retry-After is exposed",
                        "headerField": "Access-Control-Expose-Headers",
                        "operator": "contains",
                        "value": "retry-after",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "label": "X-Progress is exposed",
                        "headerField": "Access-Control-Expose-Headers",
                        "operator": "contains",
                        "value": "x-progress",
                        "warningOnly": false
                    }
                }
            ]
        }
    ],
    "teardown": {
        "action": [
            {
                "operation": {
                    "type": {
                        "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                        "code": "deleteCondMultiple"
                    },
                    "resource": "Patient",
                    "params": "_tag=http-assertions-test",
                    "description": "Delete Patients created in test.",
                    "encodeRequestUrl": false
                }
            }
        ]
    }
}
