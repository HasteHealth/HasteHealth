            "responseId": "location-ok-response"
          }
        },
        {
          "assert": {
            "label": "Matching Location stored",
            "warningOnly": false,
            "direction": "response",
            "resource": "Location"
          }
        },
        {
          "operation": {
            "type": {
              "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
              "code": "create"
            },
            "encodeRequestUrl": false,
            "resource": "Location",
            "sourceId": "fixture-location-wrong"
          }
        },
        {
          "assert": {
            "label": "latitude 48.8 against fixedDecimal 51.5: refused",
            "warningOnly": false,
            "direction": "response",
            "resource": "OperationOutcome"
          }
        },
        {
          "assert": {
            "label": "latitude 48.8 against fixedDecimal 51.5: unprocessable",
            "warningOnly": false,
            "direction": "response",
            "response": "unprocessable"
          }
        },
        {
          "assert": {
            "label": "latitude 48.8 against fixedDecimal 51.5: names the fixed value",
            "warningOnly": false,
            "expression": "OperationOutcome.issue.diagnostics.where(contains('does not match fixed value')).exists()",
            "operator": "equals",
            "value": "true"
          }
        }
      ]
    }
