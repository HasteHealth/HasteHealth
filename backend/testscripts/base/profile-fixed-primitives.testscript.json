  "test": [
    {
      "id": "fixed-boolean-and-unsigned-int",
      "name": "Fixed boolean and unsignedInt",
      "description": "A Group whose active and quantity equal the profile's fixedBoolean and fixedUnsignedInt is stored; one that differs in either is refused as unprocessable, naming the fixed value.",
      "action": [
        {
          "operation": {
            "type": {
              "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
              "code": "create"
            },
            "encodeRequestUrl": false,
            "resource": "Group",
            "sourceId": "fixture-group-ok",
            "responseId": "group-ok-response"
          }
        },
        {
          "assert": {
            "label": "Matching Group stored",
            "warningOnly": false,
            "direction": "response",
            "resource": "Group"
          }
        },
        {
          "operation": {
            "type": {
              "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
              "code": "create"
            },
            "encodeRequestUrl": false,
            "resource": "Group",
            "sourceId": "fixture-group-wrong-boolean"
          }
        },
        {
          "assert": {
            "label": "active false against fixedBoolean true: refused",
            "warningOnly": false,
            "direction": "response",
            "resource": "OperationOutcome"
          }
        },
        {
          "assert": {
            "label": "active false against fixedBoolean true: unprocessable",
            "warningOnly": false,
            "direction": "response",
            "response": "unprocessable"
          }
        },
        {
          "assert": {
            "label": "active false against fixedBoolean true: names the fixed value",
            "warningOnly": false,
            "expression": "OperationOutcome.issue.diagnostics.where(contains('does not match fixed value')).exists()",
            "operator": "equals",
            "value": "true"
          }
        },
        {
          "operation": {
            "type": {
              "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
              "code": "create"
            },
            "encodeRequestUrl": false,
            "resource": "Group",
            "sourceId": "fixture-group-wrong-count"
          }
        },
        {
          "assert": {
            "label": "quantity 4 against fixedUnsignedInt 3: refused",
            "warningOnly": false,
            "direction": "response",
            "resource": "OperationOutcome"
          }
        },
        {
          "assert": {
            "label": "quantity 4 against fixedUnsignedInt 3: unprocessable",
            "warningOnly": false,
            "direction": "response",
            "response": "unprocessable"
          }
        },
        {
          "assert": {
            "label": "quantity 4 against fixedUnsignedInt 3: names the fixed value",
            "warningOnly": false,
            "expression": "OperationOutcome.issue.diagnostics.where(contains('does not match fixed value')).exists()",
            "operator": "equals",
            "value": "true"
          }
        }
      ]
    },
    {
      "id": "fixed-decimal",
      "name": "Fixed decimal",
      "description": "A Location whose position.latitude equals the profile's fixedDecimal is stored; another latitude is refused.",
      "action": [
        {
          "operation": {
            "type": {
              "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
              "code": "create"
            },
            "encodeRequestUrl": false,
            "resource": "Location",
