{
    "id": "get-operations-test",
    "url": "https://haste.health/fhir/TestScript/get-operations",
    "name": "GET Operations Test",
    "title": "GET operation invocation",
    "status": "active",
    "description": "Tests invoking operations with GET: allowed when affectsState is not true and every input is primitive, with the query string as the parameters.",
    "resourceType": "TestScript",
    "contained": [
        {
            "id": "get-ops-patient",
            "resourceType": "Patient",
            "name": [
                {
                    "family": "GetOps",
                    "given": [
                        "Gale"
                    ]
                }
            ]
        },
        {
            "id": "get-ops-observation",
            "resourceType": "Observation",
            "status": "final",
            "code": {
                "coding": [
                    {
                        "system": "http://loinc.org",
                        "code": "29463-7"
                    }
                ]
            },
            "subject": {
                "reference": "Patient/get-ops-patient"
            }
        }
    ],
    "fixture": [
        {
            "id": "fixture-patient",
            "resource": {
                "reference": "#get-ops-patient"
            },
            "autocreate": false,
            "autodelete": false
        },
        {
            "id": "fixture-observation",
            "resource": {
                "reference": "#get-ops-observation"
            },
            "autocreate": false,
            "autodelete": false
        }
    ],
    "setup": {
        "action": [
            {
                "operation": {
                    "type": {
                        "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                        "code": "update"
                    },
                    "description": "The patient under test, at a client-supplied id.",
                    "targetId": "fixture-patient",
                    "sourceId": "fixture-patient",
                    "encodeRequestUrl": false
                }
            },
            {
                "operation": {
                    "type": {
                        "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                        "code": "update"
                    },
                    "description": "An Observation in the patient's compartment.",
                    "targetId": "fixture-observation",
                    "sourceId": "fixture-observation",
                    "encodeRequestUrl": false
                }
            }
        ]
    },
    "test": [
        {
            "id": "get-expand",
            "name": "GET $expand with the query string as parameters",
            "action": [
                {
                    "operation": {
                        "description": "GET at the type level.",
                        "method": "get",
                        "url": "ValueSet/$expand?url=http://hl7.org/fhir/ValueSet/administrative-gender",
                        "responseId": "expand-get",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "label": "GET $expand is 200",
                        "responseCode": "200",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "The expansion holds the same codes as the POST",
                        "expression": "ValueSet.expansion.contains.where(code = 'male').exists() and ValueSet.expansion.contains.where(code = 'female').exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                }
            ]
        },
        {
            "id": "get-validate-code",
            "name": "GET $validate-code",
            "action": [
                {
                    "operation": {
                        "description": "A code in the ValueSet.",
                        "method": "get",
                        "url": "ValueSet/$validate-code?url=http://hl7.org/fhir/ValueSet/administrative-gender&system=http://hl7.org/fhir/administrative-gender&code=male",
                        "responseId": "validate-code-get",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "label": "GET $validate-code is 200",
                        "responseCode": "200",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "The code is valid",
                        "expression": "Parameters.parameter.where(name='result').value = true",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "operation": {
                        "description": "A code not in the ValueSet.",
                        "method": "get",
                        "url": "ValueSet/$validate-code?url=http://hl7.org/fhir/ValueSet/administrative-gender&system=http://hl7.org/fhir/administrative-gender&code=nope",
                        "responseId": "validate-code-get-invalid",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "description": "The code is invalid",
                        "expression": "Parameters.parameter.where(name='result').value = false",
                        "value": "true",
                        "warningOnly": false
                    }
                }
            ]
        },
        {
            "id": "get-everything",
            "name": "GET Patient/[id]/$everything",
            "action": [
                {
                    "operation": {
                        "description": "GET at the instance level.",
                        "method": "get",
                        "url": "Patient/get-ops-patient/$everything",
                        "responseId": "everything-get",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "label": "GET $everything is 200",
                        "responseCode": "200",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "A searchset Bundle",
                        "expression": "Bundle.type = 'searchset'",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "The patient is returned once",
                        "expression": "Bundle.entry.resource.ofType(Patient).where(id = 'get-ops-patient').count() = 1",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "The patient's Observation is returned",
                        "expression": "Bundle.entry.resource.ofType(Observation).where(id = 'get-ops-observation').exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                }
            ]
        },
        {
            "id": "get-affects-state",
            "name": "GET of an operation that affects state is refused",
            "action": [
                {
                    "operation": {
                        "description": "$delete-refresh-token has affectsState = true.",
                        "method": "get",
                        "url": "$delete-refresh-token?client_id=get-operations-test",
                        "responseId": "affects-state-get",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "label": "405 Method Not Allowed",
                        "response": "methodNotAllowed",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "An OperationOutcome explains why",
                        "expression": "OperationOutcome.issue.exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                }
            ]
        },
        {
            "id": "get-unknown-parameter",
            "name": "GET with a parameter the operation does not have is refused",
            "action": [
                {
                    "operation": {
                        "description": "Unknown parameter.",
                        "method": "get",
                        "url": "ValueSet/$expand?url=http://hl7.org/fhir/ValueSet/administrative-gender&no-such-parameter=1",
                        "responseId": "unknown-parameter-get",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "label": "Unknown parameter is 400",
                        "responseCode": "400",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "An OperationOutcome explains why",
                        "expression": "OperationOutcome.issue.exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                }
            ]
        },
        {
            "id": "get-non-primitive-parameter",
            "name": "GET with a non-primitive parameter is refused",
            "action": [
                {
                    "operation": {
                        "description": "$expand's valueSet is a resource.",
                        "method": "get",
                        "url": "ValueSet/$expand?valueSet=%7B%7D",
                        "responseId": "non-primitive-get",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "label": "Non-primitive parameter is 400",
                        "responseCode": "400",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "An OperationOutcome explains why",
                        "expression": "OperationOutcome.issue.exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                }
            ]
        }
    ],
    "teardown": {
        "action": [
            {
                "operation": {
                    "type": {
                        "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                        "code": "delete"
                    },
                    "targetId": "fixture-observation",
                    "encodeRequestUrl": false
                }
            },
            {
                "operation": {
                    "type": {
                        "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                        "code": "delete"
                    },
                    "targetId": "fixture-patient",
                    "encodeRequestUrl": false
                }
            }
        ]
    }
}
