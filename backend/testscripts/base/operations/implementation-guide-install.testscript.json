 "test": [
  {
   "id": "install",
   "name": "Install an uploaded package",
   "description": "npmContent installs the package's conformance resources and examples. A resource whose id the project already uses for something else is not overwritten and is reported.",
   "action": [
    {
     "operation": {
      "type": {
       "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
       "code": "invoke"
      },
      "description": "Install haste.test.ig 1.0.0 with its examples.",
      "url": "install",
      "resource": "ImplementationGuide",
      "sourceId": "fixture-install-v1",
      "responseId": "install-v1",
      "encodeRequestUrl": false
     }
    },
    {
     "assert": {
      "label": "Install is 200",
      "responseCode": "200",
      "warningOnly": false
     }
    },
    {
     "assert": {
      "label": "The package is installed",
      "expression": "Parameters.parameter.where(name = 'package').part.where(name = 'status').value = 'installed'",
      "value": "true",
      "warningOnly": false
     }
    },
    {
     "assert": {
      "label": "Four resources: the profile, the SearchParameter, ValueSet test-ig-colors and the example",
      "expression": "Parameters.parameter.where(name = 'package').part.where(name = 'resources').value = 4",
      "value": "true",
      "warningOnly": false
     }
    },
    {
     "assert": {
      "label": "The ValueSet whose id is taken is reported",
      "expression": "Parameters.parameter.where(name = 'outcome').resource.issue.where(diagnostics.contains('ValueSet/test-ig-shapes')).exists()",
      "value": "true",
      "warningOnly": false
     }
    },
    {
     "operation": {
      "type": {
       "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
       "code": "create"
      },
      "description": "A write of the runner's own, so the next search waits until the operation's writes are indexed.",
      "resource": "Patient",
      "sourceId": "fixture-index-marker",
      "encodeRequestUrl": false
     }
    }
   ]
  },
  {
   "id": "record",
   "name": "The package is recorded as an ImplementationGuide",
   "description": "Its id is the package name; definition.resource lists what was installed.",
   "action": [
    {
     "operation": {
      "type": {
       "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
       "code": "search"
      },
      "description": "The package's record.",
      "resource": "ImplementationGuide",
      "params": "_id=haste.test.ig",
      "encodeRequestUrl": false
     }
    },
    {
     "assert": {
      "label": "packageId is the package name",
      "expression": "Bundle.entry.resource.ofType(ImplementationGuide).packageId = 'haste.test.ig'",
      "value": "true",
      "warningOnly": false
     }
    },
    {
     "assert": {
      "label": "version is the installed version",
      "expression": "Bundle.entry.resource.ofType(ImplementationGuide).version = '1.0.0'",
      "value": "true",
      "warningOnly": false
     }
    },
    {
     "assert": {
      "label": "It lists the four installed resources",
      "expression": "Bundle.entry.resource.ofType(ImplementationGuide).definition.resource.count() = 4",
      "value": "true",
      "warningOnly": false
     }
    },
    {
     "assert": {
      "label": "The example is marked as one",
      "expression": "Bundle.entry.resource.ofType(ImplementationGuide).definition.resource.where(reference.reference = 'Patient/test-ig-example').example = true",
      "value": "true",
      "warningOnly": false
     }
    }
   ]
  },
  {
   "id": "tagged",
   "name": "Installed resources are tagged with the package",
   "action": [
    {
     "operation": {
      "type": {
       "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
       "code": "search"
      },
      "description": "The installed profile.",
      "resource": "StructureDefinition",
      "params": "url=https://haste.health/fhir/test-ig/StructureDefinition/test-ig-patient",
      "encodeRequestUrl": false
     }
    },
    {
     "assert": {
      "label": "The profile is installed",
      "expression": "Bundle.entry.resource.ofType(StructureDefinition).count() = 1",
      "value": "true",
      "warningOnly": false
     }
    },
    {
     "assert": {
      "label": "Tagged with the package name",
      "expression": "Bundle.entry.resource.ofType(StructureDefinition).meta.tag.where(system = 'https://haste.health/fhir/CodeSystem/fhir-package').code = 'haste.test.ig'",
      "value": "true",
      "warningOnly": false
     }
    },
    {
     "assert": {
      "label": "and its version",
      "expression": "Bundle.entry.resource.ofType(StructureDefinition).meta.tag.where(system = 'https://haste.health/fhir/CodeSystem/fhir-package').version = '1.0.0'",
      "value": "true",
      "warningOnly": false
     }
    },
    {
     "operation": {
      "type": {
       "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
       "code": "search"
      },
      "description": "The project's own ValueSet, whose id the package also uses.",
      "resource": "ValueSet",
      "params": "_id=test-ig-shapes",
      "encodeRequestUrl": false
     }
    },
    {
     "assert": {
      "label": "It was not overwritten",
      "expression": "Bundle.entry.resource.ofType(ValueSet).url = 'https://haste.health/fhir/implementation-guide-install-test/ValueSet/shapes'",
      "value": "true",
      "warningOnly": false
     }
    },
    {
     "operation": {
      "type": {
       "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
       "code": "search"
      },
      "description": "The package's example.",
      "resource": "Patient",
      "params": "_id=test-ig-example",
      "encodeRequestUrl": false
     }
    },
    {
     "assert": {
      "label": "The example is installed",
      "expression": "Bundle.entry.resource.ofType(Patient).count() = 1",
      "value": "true",
      "warningOnly": false
     }
    }
   ]
  },
