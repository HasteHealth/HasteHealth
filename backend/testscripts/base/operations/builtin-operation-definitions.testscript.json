        {
            "id": "06-reuse-code-elsewhere",
            "name": "A built-in's code can be reused where the built-in doesn't apply",
            "action": [
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "update"
                        },
                        "encodeRequestUrl": false,
                        "resource": "Encounter",
                        "targetId": "fixture-bod-encounter",
                        "sourceId": "fixture-bod-encounter",
                        "description": "An Encounter."
                    }
                },
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "update"
                        },
                        "encodeRequestUrl": false,
                        "resource": "OperationDefinition",
                        "targetId": "fixture-bod-encounter-everything",
                        "sourceId": "fixture-bod-encounter-everything",
                        "description": "$everything on Encounter instances, which the built-in doesn't handle."
                    }
                },
                {
                    "assert": {
                        "description": "Allowed",
                        "expression": "OperationDefinition.code",
                        "value": "everything",
                        "warningOnly": false
                    }
                },
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "search"
                        },
                        "encodeRequestUrl": false,
                        "resource": "OperationDefinition",
                        "params": "code=everything&instance=true",
                        "description": "Both $everything definitions."
                    }
                },
                {
                    "assert": {
                        "description": "The project's is listed",
                        "expression": "Bundle.entry.resource.where(id = 'bod-encounter-everything').exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Beside the built-in",
                        "expression": "Bundle.entry.resource.where(id = 'Patient-everything').exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "invoke"
                        },
                        "encodeRequestUrl": false,
                        "resource": "Encounter",
                        "url": "everything",
                        "targetId": "fixture-bod-encounter",
                        "sourceId": "fixture-bod-no-parameters",
                        "description": "Encounter/[id]/$everything runs the project's operation."
                    }
                },
                {
                    "assert": {
                        "description": "Not the built-in Patient $everything",
                        "expression": "Parameters.parameter.where(name = 'echo').value",
                        "value": "encounter-everything",
                        "warningOnly": false
                    }
                },
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "invoke"
                        },
                        "encodeRequestUrl": false,
                        "url": "everything",
                        "sourceId": "fixture-bod-no-parameters",
                        "description": "$everything at the system level, which nothing defines."
                    }
                },
                {
                    "assert": {
                        "description": "Not found",
                        "expression": "OperationOutcome.issue.where(code = 'not-found').exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                }
            ]
        }
