    "test": [
        {
            "id": "01-read",
            "name": "A built-in OperationDefinition reads by id",
            "action": [
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "read"
                        },
                        "encodeRequestUrl": false,
                        "resource": "OperationDefinition",
                        "targetId": "fixture-ValueSet-expand",
                        "description": "Read the built-in $expand definition."
                    }
                },
                {
                    "assert": {
                        "description": "It is the $expand definition",
                        "expression": "OperationDefinition.code",
                        "value": "expand",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "With its canonical url",
                        "expression": "OperationDefinition.url",
                        "value": "http://hl7.org/fhir/OperationDefinition/ValueSet-expand",
                        "warningOnly": false
                    }
                }
            ]
        },
        {
            "id": "02-search-by-code",
            "name": "A search lists the built-ins it matches",
            "action": [
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "search"
                        },
                        "encodeRequestUrl": false,
                        "resource": "OperationDefinition",
                        "params": "code=expand",
                        "description": "Search by a built-in's code."
                    }
                },
                {
                    "assert": {
                        "description": "One match",
                        "expression": "Bundle.entry.count()",
                        "value": "1",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "The built-in",
                        "expression": "Bundle.entry[0].resource.id",
                        "value": "ValueSet-expand",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Marked as a match",
                        "expression": "Bundle.entry[0].search.mode",
                        "value": "match",
                        "warningOnly": false
                    }
                },
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "search"
                        },
                        "encodeRequestUrl": false,
                        "resource": "OperationDefinition",
                        "params": "code:not=expand",
                        "description": "Exclude a built-in's code."
                    }
                },
                {
                    "assert": {
                        "description": "The excluded built-in is absent",
                        "expression": "Bundle.entry.resource.where(id = 'ValueSet-expand').exists()",
                        "value": "false",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Other built-ins are listed",
                        "expression": "Bundle.entry.resource.where(id = 'Patient-everything').exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                }
            ]
        },
        {
            "id": "03-paging",
            "name": "Built-ins come first and a page never repeats or skips one",
            "action": [
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "update"
                        },
                        "encodeRequestUrl": false,
                        "resource": "OperationDefinition",
                        "targetId": "fixture-bod-custom",
                        "sourceId": "fixture-bod-custom",
                        "description": "Store a project OperationDefinition."
                    }
                },
                {
                    "assert": {
                        "description": "Stored",
                        "expression": "OperationDefinition.code",
                        "value": "bod-custom",
                        "warningOnly": false
                    }
                },
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "search"
                        },
                        "encodeRequestUrl": false,
                        "resource": "OperationDefinition",
                        "params": "code=bod-custom,expand&_total=accurate",
                        "description": "Both, with a total."
                    }
                },
                {
                    "assert": {
                        "description": "The built-in and the project's",
                        "expression": "Bundle.entry.count()",
                        "value": "2",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "The total counts both",
                        "expression": "Bundle.total",
                        "value": "2",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "The built-in first",
                        "expression": "Bundle.entry[0].resource.id",
                        "value": "ValueSet-expand",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Then the project's",
                        "expression": "Bundle.entry[1].resource.id",
                        "value": "bod-custom",
                        "warningOnly": false
                    }
                },
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "search"
                        },
                        "encodeRequestUrl": false,
                        "resource": "OperationDefinition",
                        "params": "code=bod-custom,expand&_count=1",
                        "description": "First page."
                    }
                },
                {
                    "assert": {
                        "description": "One entry",
                        "expression": "Bundle.entry.count()",
                        "value": "1",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "The built-in",
                        "expression": "Bundle.entry[0].resource.id",
                        "value": "ValueSet-expand",
                        "warningOnly": false
                    }
                },
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "search"
                        },
                        "encodeRequestUrl": false,
                        "resource": "OperationDefinition",
                        "params": "code=bod-custom,expand&_count=1&_offset=1",
                        "description": "Second page."
                    }
                },
                {
                    "assert": {
                        "description": "One entry",
                        "expression": "Bundle.entry.count()",
                        "value": "1",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "The project's",
                        "expression": "Bundle.entry[0].resource.id",
                        "value": "bod-custom",
                        "warningOnly": false
                    }
                },
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "search"
                        },
                        "encodeRequestUrl": false,
                        "resource": "OperationDefinition",
                        "params": "code=bod-custom,expand&_count=1&_offset=2",
                        "description": "Past the end."
                    }
                },
                {
                    "assert": {
                        "description": "Nothing",
                        "expression": "Bundle.entry.exists()",
                        "value": "false",
                        "warningOnly": false
                    }
                }
            ]
        },
