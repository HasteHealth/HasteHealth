{
    "id": "valueset-expand-test",
    "url": "https://haste.health/fhir/valueset-expand-test",
    "name": "Valueset Expand Test",
    "title": "Valueset Expand Test",
    "status": "active",
    "description": "Tests the $expand operation on ValueSet.",
    "resourceType": "TestScript",
    "contained": [
        {
            "id": "valueset-expand-parameters",
            "resourceType": "Parameters",
            "parameter": [
                {
                    "name": "url",
                    "valueUri": "http://hl7.org/fhir/ValueSet/administrative-gender|4.0.1"
                }
            ]
        },
        {
            "id": "valueset-expand-instance-parameters",
            "resourceType": "Parameters"
        },
        {
            "id": "administrative-gender",
            "resourceType": "ValueSet",
            "status": "active"
        },
        {
            "id": "valueset-expand-test-project",
            "resourceType": "ValueSet",
            "status": "active",
            "url": "https://haste.health/fhir/ValueSet/valueset-expand-test-project",
            "compose": {
                "include": [
                    {
                        "system": "https://haste.health/fhir/CodeSystem/valueset-expand-test",
                        "concept": [
                            {
                                "code": "alpha",
                                "display": "Alpha"
                            },
                            {
                                "code": "beta",
                                "display": "Beta"
                            }
                        ]
                    }
                ]
            }
        }
    ],
    "fixture": [
        {
            "id": "fixture-expand",
            "resource": {
                "reference": "#valueset-expand-parameters"
            },
            "autocreate": false,
            "autodelete": false
        },
        {
            "id": "fixture-expand-instance",
            "resource": {
                "reference": "#valueset-expand-instance-parameters"
            },
            "autocreate": false,
            "autodelete": false
        },
        {
            "id": "fixture-administrative-gender",
            "resource": {
                "reference": "#administrative-gender"
            },
            "autocreate": false,
            "autodelete": false
        },
        {
            "id": "fixture-project-valueset",
            "resource": {
                "reference": "#valueset-expand-test-project"
            },
            "autocreate": false,
            "autodelete": false
        }
    ],
    "setup": {
        "action": [
            {
                "operation": {
                    "type": {
                        "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                        "code": "update"
                    },
                    "description": "A ValueSet owned by the project, at a client-supplied id so it can be expanded at the instance level.",
                    "resource": "ValueSet",
                    "targetId": "fixture-project-valueset",
                    "sourceId": "fixture-project-valueset",
                    "responseId": "created-project-valueset",
                    "encodeRequestUrl": false
                }
            }
        ]
    },
    "test": [
        {
            "id": "update-client-supplied",
            "name": "Update Patient with client supplied id",
            "action": [
                {
                    "operation": {
                        "url": "expand",
                        "type": {
                            "code": "invoke"
                        },
                        "resource": "ValueSet",
                        "sourceId": "fixture-expand",
                        "responseId": "expand-response",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "expression": "ValueSet.expansion.contains[0].code = 'male'",
                        "value": "true",
                        "warningOnly": false
                    }
                }
            ]
        },
        {
            "id": "expand-instance",
            "name": "Expand a ValueSet at the instance level",
            "action": [
                {
                    "operation": {
                        "url": "expand",
                        "type": {
                            "code": "invoke"
                        },
                        "resource": "ValueSet",
                        "sourceId": "fixture-expand-instance",
                        "targetId": "fixture-administrative-gender",
                        "responseId": "expand-instance-system-response",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "expression": "ValueSet.expansion.contains.where(code = 'female').exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "operation": {
                        "url": "expand",
                        "type": {
                            "code": "invoke"
                        },
                        "resource": "ValueSet",
                        "sourceId": "fixture-expand-instance",
                        "targetId": "fixture-project-valueset",
                        "responseId": "expand-instance-project-response",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "expression": "ValueSet.expansion.contains.code.count() = 2 and ValueSet.expansion.contains.where(code = 'beta').exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                }
            ]
        }
    ],
    "teardown": {
        "action": [
            {
                "operation": {
                    "type": {
                        "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                        "code": "delete"
                    },
                    "description": "Remove the project ValueSet.",
                    "resource": "ValueSet",
                    "targetId": "fixture-project-valueset",
                    "encodeRequestUrl": false
                }
            }
        ]
    }
}