                    "type": {
                        "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                        "code": "update"
                    },
                    "description": "An Observation belonging to the other patient.",
                    "targetId": "fixture-other-observation",
                    "sourceId": "fixture-other-observation",
                    "responseId": "created-other-observation",
                    "encodeRequestUrl": false
                }
            }
        ]
    },
    "test": [
        {
            "id": "01-everything-returns-the-patient-and-compartment",
            "name": "$everything returns the patient and their compartment",
            "action": [
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "invoke"
                        },
                        "url": "everything",
                        "resource": "Patient",
                        "targetId": "fixture-patient",
                        "sourceId": "fixture-no-params",
                        "responseId": "everything-response",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "description": "$everything answers with a searchset Bundle",
                        "expression": "Bundle.type = 'searchset'",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "The patient itself is in its own compartment, exactly once",
                        "expression": "Bundle.entry.resource.ofType(Patient).count()",
                        "operator": "equals",
                        "value": "1",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "The returned patient is the one invoked on",
                        "expression": "Bundle.entry.resource.ofType(Patient).id = 'everything-patient'",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "The patient's Observation is in the compartment",
                        "expression": "Bundle.entry.resource.ofType(Observation).where(id = 'everything-observation').exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "The patient's Condition is in the compartment",
                        "expression": "Bundle.entry.resource.ofType(Condition).where(id = 'everything-condition').exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Another patient's Observation is NOT in this compartment",
                        "expression": "Bundle.entry.resource.ofType(Observation).where(id = 'everything-other-observation').empty()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "Another patient is NOT in this compartment",
                        "expression": "Bundle.entry.resource.ofType(Patient).where(id = 'everything-other-patient').empty()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "An Observation reachable by two compartment parameters (subject and performer) appears exactly once",
                        "expression": "Bundle.entry.resource.ofType(Observation).where(id = 'everything-observation').count()",
                        "value": "1",
                        "warningOnly": false,
                        "operator": "equals"
                    }
                },
                {
                    "assert": {
                        "description": "a complete result reports a total",
                        "expression": "Bundle.total.exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                }
            ]
        },
        {
            "id": "02-type-filters-the-result",
            "name": "_type restricts which resource types are returned",
            "action": [
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "invoke"
                        },
                        "url": "everything",
                        "resource": "Patient",
                        "targetId": "fixture-patient",
                        "sourceId": "fixture-type-observation",
                        "responseId": "everything-observation-only",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "description": "_type=Observation returns the Observation",
                        "expression": "Bundle.entry.resource.ofType(Observation).where(id = 'everything-observation').exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "_type=Observation excludes the Condition",
                        "expression": "Bundle.entry.resource.ofType(Condition).empty()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "_type=Observation excludes the Patient itself",
                        "expression": "Bundle.entry.resource.ofType(Patient).empty()",
                        "value": "true",
                        "warningOnly": false
                    }
                }
            ]
        },
        {
            "id": "03-type-accepts-a-comma-delimited-list",
            "name": "_type accepts several comma-delimited types",
            "action": [
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "invoke"
                        },
                        "url": "everything",
                        "resource": "Patient",
                        "targetId": "fixture-patient",
                        "sourceId": "fixture-type-two",
                        "responseId": "everything-two-types",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "description": "Both requested types are returned",
                        "expression": "Bundle.entry.resource.ofType(Observation).exists() and Bundle.entry.resource.ofType(Condition).exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "assert": {
                        "description": "A type that was not requested is excluded",
                        "expression": "Bundle.entry.resource.ofType(Patient).empty()",
                        "value": "true",
                        "warningOnly": false
                    }
                }
            ]
        },
        {
            "id": "04-count-caps-the-entries",
            "name": "_count caps how many entries are returned",
            "action": [
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "invoke"
                        },
                        "url": "everything",
                        "resource": "Patient",
                        "targetId": "fixture-patient",
                        "sourceId": "fixture-count-one",
                        "responseId": "everything-count-one",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "description": "_count=1 returns exactly one entry",
                        "expression": "Bundle.entry.count()",
                        "operator": "equals",
                        "value": "1",
                        "warningOnly": false
                    }
                }
            ]
        },
        {
            "id": "05-since-excludes-older-records",
            "name": "_since excludes records last updated before it",
            "description": "Every resource was written during setup, so a _since in the future must exclude the whole compartment. The patient is read directly and is not subject to _since.",
            "action": [
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "invoke"
                        },
                        "url": "everything",
                        "resource": "Patient",
                        "targetId": "fixture-patient",
                        "sourceId": "fixture-since-future",
                        "responseId": "everything-since",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "description": "No compartment resource survives a future _since",
                        "expression": "Bundle.entry.resource.ofType(Observation).empty() and Bundle.entry.resource.ofType(Condition).empty()",
                        "value": "true",
                        "warningOnly": false
                    }
                }
            ]
        }
    ]
}
