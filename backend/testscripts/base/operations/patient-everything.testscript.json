                "operation": {
                    "type": {
                        "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                        "code": "update"
                    },
                    "description": "The patient under test, at a client-supplied id so the compartment references below are static.",
                    "targetId": "fixture-patient",
                    "sourceId": "fixture-patient",
                    "responseId": "created-patient",
                    "encodeRequestUrl": false
                }
            },
            {
                "operation": {
                    "type": {
                        "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                        "code": "update"
                    },
                    "description": "An Observation in the patient's compartment.",
                    "targetId": "fixture-observation",
                    "sourceId": "fixture-observation",
                    "responseId": "created-observation",
                    "encodeRequestUrl": false
                }
            },
            {
                "operation": {
                    "type": {
                        "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                        "code": "update"
                    },
                    "description": "A Condition in the patient's compartment.",
                    "targetId": "fixture-condition",
                    "sourceId": "fixture-condition",
                    "responseId": "created-condition",
                    "encodeRequestUrl": false
                }
            },
            {
                "operation": {
                    "type": {
                        "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                        "code": "update"
                    },
                    "description": "A second patient, whose resources must never appear in the first patient's compartment.",
                    "targetId": "fixture-other-patient",
                    "sourceId": "fixture-other-patient",
                    "responseId": "created-other-patient",
                    "encodeRequestUrl": false
                }
            },
            {
