{
    "id": "access-control-user-v1-scopes-setup",
    "url": "https://haste.health/fhir/TestScript/access-control-user-v1-scopes-setup",
    "name": "Access Control User V1 Scopes Setup",
    "title": "User v1 scopes: data and login",
    "status": "active",
    "description": "Run as admin. Writes a patient and an Observation, and the login: a member User with no patient link, a full-access policy, and a public client allowed the SMART v1 scopes openid offline_access user/Patient.read user/Observation.write.",
    "resourceType": "TestScript",
    "contained": [
        {
            "id": "acv1-patient",
            "resourceType": "Patient",
            "meta": {
                "tag": [
                    {
                        "code": "access-control-user-v1-scopes"
                    }
                ]
            },
            "name": [
                {
                    "family": "Access",
                    "given": [
                        "Vee"
                    ]
                }
            ]
        },
        {
            "id": "acv1-observation",
            "resourceType": "Observation",
            "meta": {
                "tag": [
                    {
                        "code": "access-control-user-v1-scopes"
                    }
                ]
            },
            "status": "final",
            "code": {
                "text": "Heart rate"
            },
            "subject": {
                "reference": "Patient/acv1-patient"
            }
        },
        {
            "id": "acv1-user",
            "resourceType": "User",
            "meta": {
                "tag": [
                    {
                        "code": "access-control-user-v1-scopes"
                    }
                ]
            },
            "role": "member",
            "email": "acv1-user@example.org"
        },
        {
            "id": "acv1-membership",
            "resourceType": "Membership",
            "meta": {
                "tag": [
                    {
                        "code": "access-control-user-v1-scopes"
                    }
                ]
            },
            "user": {
                "reference": "User/acv1-user"
            }
        },
        {
            "id": "acv1-policy",
            "resourceType": "AccessPolicyV2",
            "meta": {
                "tag": [
                    {
                        "code": "access-control-user-v1-scopes"
                    }
                ]
            },
            "name": "Access control: user v1 scopes",
            "description": "Full access, so only the user scopes limit this login.",
            "engine": "full-access"
        },
        {
            "id": "acv1-policy-assignment",
            "resourceType": "AccessPolicyV2Assignment",
            "meta": {
                "tag": [
                    {
                        "code": "access-control-user-v1-scopes"
                    }
                ]
            },
            "accessPolicy": {
                "reference": "AccessPolicyV2/acv1-policy"
            },
            "link": {
                "reference": "Membership/acv1-membership"
            }
        },
        {
            "id": "acv1-app",
            "resourceType": "ClientApplication",
            "meta": {
                "tag": [
                    {
                        "code": "access-control-user-v1-scopes"
                    }
                ]
            },
            "name": "Access control: user v1 scopes app",
            "grantType": [
                "authorization_code",
                "refresh_token"
            ],
            "responseTypes": "code",
            "redirectUri": [
                "http://127.0.0.1:8976/callback"
            ],
            "scope": "openid offline_access user/Patient.read user/Observation.write"
        }
    ],
    "fixture": [
        {
            "id": "fixture-acv1-patient",
            "resource": {
                "reference": "#acv1-patient"
            },
            "autocreate": false,
            "autodelete": false
        },
        {
            "id": "fixture-acv1-observation",
            "resource": {
                "reference": "#acv1-observation"
            },
            "autocreate": false,
            "autodelete": false
        },
        {
            "id": "fixture-acv1-user",
            "resource": {
                "reference": "#acv1-user"
            },
            "autocreate": false,
            "autodelete": false
        },
        {
            "id": "fixture-acv1-membership",
            "resource": {
                "reference": "#acv1-membership"
            },
            "autocreate": false,
            "autodelete": false
        },
        {
            "id": "fixture-acv1-policy",
            "resource": {
                "reference": "#acv1-policy"
            },
            "autocreate": false,
            "autodelete": false
        },
        {
            "id": "fixture-acv1-policy-assignment",
            "resource": {
                "reference": "#acv1-policy-assignment"
            },
            "autocreate": false,
            "autodelete": false
        },
        {
            "id": "fixture-acv1-app",
            "resource": {
                "reference": "#acv1-app"
            },
            "autocreate": false,
            "autodelete": false
        }
    ],
    "test": [
        {
            "id": "01-data",
            "name": "A patient and an Observation",
            "action": [
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "update"
                        },
                        "resource": "Patient",
                        "targetId": "fixture-acv1-patient",
                        "sourceId": "fixture-acv1-patient",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "description": "Patient/acv1-patient is written",
                        "resource": "Patient",
                        "warningOnly": false
                    }
                },
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "update"
                        },
                        "resource": "Observation",
                        "targetId": "fixture-acv1-observation",
                        "sourceId": "fixture-acv1-observation",
                        "description": "Target of the refused read: write does not imply read.",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "description": "Observation/acv1-observation is written",
                        "resource": "Observation",
                        "warningOnly": false
                    }
                }
            ]
        },
        {
            "id": "02-login",
            "name": "The user-v1-scopes login, its access policy and client",
            "action": [
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "update"
                        },
                        "resource": "User",
                        "targetId": "fixture-acv1-user",
                        "sourceId": "fixture-acv1-user",
                        "description": "Its password is set in the sign-in phase.",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "description": "User/acv1-user is written",
                        "resource": "User",
                        "warningOnly": false
                    }
                },
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "update"
                        },
                        "resource": "Membership",
                        "targetId": "fixture-acv1-membership",
                        "sourceId": "fixture-acv1-membership",
                        "description": "No link: user scopes need no patient in context.",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "description": "Membership/acv1-membership is written",
                        "resource": "Membership",
                        "warningOnly": false
                    }
                },
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "update"
                        },
                        "resource": "AccessPolicyV2",
                        "targetId": "fixture-acv1-policy",
                        "sourceId": "fixture-acv1-policy",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "description": "AccessPolicyV2/acv1-policy is written",
                        "resource": "AccessPolicyV2",
                        "warningOnly": false
                    }
                },
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "update"
                        },
                        "resource": "AccessPolicyV2Assignment",
                        "targetId": "fixture-acv1-policy-assignment",
                        "sourceId": "fixture-acv1-policy-assignment",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "description": "AccessPolicyV2Assignment/acv1-policy-assignment is written",
                        "resource": "AccessPolicyV2Assignment",
                        "warningOnly": false
                    }
                },
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "update"
                        },
                        "resource": "ClientApplication",
                        "targetId": "fixture-acv1-app",
                        "sourceId": "fixture-acv1-app",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "description": "ClientApplication/acv1-app is written",
                        "resource": "ClientApplication",
                        "warningOnly": false
                    }
                }
            ]
        },
        {
            "id": "03-indexed",
            "name": "The access policy can be found the way token issuance finds it",
            "action": [
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "search"
                        },
                        "resource": "AccessPolicyV2Assignment",
                        "params": "link=Membership/acv1-membership",
                        "description": "Waits for indexing: token issuance finds access policies through search.",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "description": "The assignment is found by its principal",
                        "expression": "Bundle.entry.resource.where(id = 'acv1-policy-assignment').exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                }
            ]
        }
    ]
}
