    "test": [
        {
            "id": "01-data",
            "name": "A patient, their data and shared reference data",
            "action": [
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "update"
                        },
                        "resource": "Patient",
                        "targetId": "fixture-acps-patient",
                        "sourceId": "fixture-acps-patient",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "description": "Patient/acps-patient is written",
                        "resource": "Patient",
                        "warningOnly": false
                    }
                },
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "update"
                        },
                        "resource": "Medication",
                        "targetId": "fixture-acps-medication",
                        "sourceId": "fixture-acps-medication",
                        "encodeRequestUrl": false,
                        "description": "Shared reference data: readable under patient/Medication.rs."
                    }
                },
                {
                    "assert": {
                        "description": "Medication/acps-medication is written",
                        "resource": "Medication",
                        "warningOnly": false
                    }
                },
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "update"
                        },
                        "resource": "Observation",
                        "targetId": "fixture-acps-observation",
                        "sourceId": "fixture-acps-observation",
                        "encodeRequestUrl": false,
                        "description": "Searchable but not readable: Observation.s is requested."
                    }
                },
                {
                    "assert": {
                        "description": "Observation/acps-observation is written",
                        "resource": "Observation",
                        "warningOnly": false
                    }
                },
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "update"
                        },
                        "resource": "Encounter",
                        "targetId": "fixture-acps-encounter",
                        "sourceId": "fixture-acps-encounter",
                        "encodeRequestUrl": false,
                        "description": "Allowed by the wildcard but not requested."
                    }
                },
                {
                    "assert": {
                        "description": "Encounter/acps-encounter is written",
                        "resource": "Encounter",
                        "warningOnly": false
                    }
                }
            ]
        },
        {
            "id": "02-login",
            "name": "The member User linked to the patient, its access policy and client application",
            "action": [
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "update"
                        },
                        "resource": "User",
                        "targetId": "fixture-acps-user",
                        "sourceId": "fixture-acps-user",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "description": "User/acps-user is written",
                        "resource": "User",
                        "warningOnly": false
                    }
                },
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "update"
                        },
                        "resource": "Membership",
                        "targetId": "fixture-acps-membership",
                        "sourceId": "fixture-acps-membership",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "description": "Membership/acps-membership is written",
                        "resource": "Membership",
                        "warningOnly": false
                    }
                },
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "update"
                        },
                        "resource": "AccessPolicyV2",
                        "targetId": "fixture-acps-policy",
                        "sourceId": "fixture-acps-policy",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "description": "AccessPolicyV2/acps-policy is written",
                        "resource": "AccessPolicyV2",
                        "warningOnly": false
                    }
                },
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "update"
                        },
                        "resource": "AccessPolicyV2Assignment",
                        "targetId": "fixture-acps-policy-assignment",
                        "sourceId": "fixture-acps-policy-assignment",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "description": "AccessPolicyV2Assignment/acps-policy-assignment is written",
                        "resource": "AccessPolicyV2Assignment",
                        "warningOnly": false
                    }
                },
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
