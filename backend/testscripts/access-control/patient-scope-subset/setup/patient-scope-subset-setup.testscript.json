{
    "id": "access-control-patient-scope-subset-setup",
    "url": "https://haste.health/fhir/TestScript/access-control-patient-scope-subset-setup",
    "name": "Access Control Patient Scope Subset Setup",
    "title": "Patient scope subset: data and login",
    "status": "active",
    "description": "Run as admin. Writes a patient with an Observation and an Encounter, a Medication (shared reference data), and the login the tests use: a member User linked to the patient, a full-access policy, and an app allowed openid fhirUser offline_access launch/patient patient/*.rs; the scenario requests the narrower patient/Medication.rs patient/Patient.r patient/Observation.s.",
    "resourceType": "TestScript",
    "contained": [
        {
            "id": "acps-patient",
            "resourceType": "Patient",
            "meta": {
                "tag": [
                    {
                        "code": "access-control-patient-scope-subset"
                    }
                ]
            },
            "name": [
                {
                    "family": "Access",
                    "given": [
                        "Parker"
                    ]
                }
            ]
        },
        {
            "id": "acps-medication",
            "resourceType": "Medication",
            "meta": {
                "tag": [
                    {
                        "code": "access-control-patient-scope-subset"
                    }
                ]
            },
            "code": {
                "text": "Ibuprofen"
            }
        },
        {
            "id": "acps-observation",
            "resourceType": "Observation",
            "meta": {
                "tag": [
                    {
                        "code": "access-control-patient-scope-subset"
                    }
                ]
            },
            "status": "final",
            "code": {
                "text": "Heart rate"
            },
            "subject": {
                "reference": "Patient/acps-patient"
            }
        },
        {
            "id": "acps-encounter",
            "resourceType": "Encounter",
            "meta": {
                "tag": [
                    {
                        "code": "access-control-patient-scope-subset"
                    }
                ]
            },
            "status": "finished",
            "class": {
                "system": "http://terminology.hl7.org/CodeSystem/v3-ActCode",
                "code": "AMB"
            },
            "subject": {
                "reference": "Patient/acps-patient"
            }
        },
        {
            "id": "acps-user",
            "resourceType": "User",
            "meta": {
                "tag": [
                    {
                        "code": "access-control-patient-scope-subset"
                    }
                ]
            },
            "role": "member",
            "email": "acps-patient@example.org"
        },
        {
            "id": "acps-membership",
            "resourceType": "Membership",
            "meta": {
                "tag": [
                    {
                        "code": "access-control-patient-scope-subset"
                    }
                ]
            },
            "user": {
                "reference": "User/acps-user"
            },
            "link": {
                "reference": "Patient/acps-patient"
            }
        },
        {
            "id": "acps-policy",
            "resourceType": "AccessPolicyV2",
            "meta": {
                "tag": [
                    {
                        "code": "access-control-patient-scope-subset"
                    }
                ]
            },
            "name": "Access control: patient scope subset",
            "description": "Full access, so only the patient scopes limit this login.",
            "engine": "full-access"
        },
        {
            "id": "acps-policy-assignment",
            "resourceType": "AccessPolicyV2Assignment",
            "meta": {
                "tag": [
                    {
                        "code": "access-control-patient-scope-subset"
                    }
                ]
            },
            "accessPolicy": {
                "reference": "AccessPolicyV2/acps-policy"
            },
            "link": {
                "reference": "Membership/acps-membership"
            }
        },
        {
            "id": "acps-app",
            "resourceType": "ClientApplication",
            "meta": {
                "tag": [
                    {
                        "code": "access-control-patient-scope-subset"
                    }
                ]
            },
            "name": "Access control: patient scope subset app",
            "grantType": [
                "authorization_code",
                "refresh_token"
            ],
            "responseTypes": "code",
            "redirectUri": [
                "http://127.0.0.1:8976/callback"
            ],
            "scope": "openid fhirUser offline_access launch/patient patient/*.rs"
        }
    ],
    "fixture": [
        {
            "id": "fixture-acps-patient",
            "resource": {
                "reference": "#acps-patient"
            },
            "autocreate": false,
            "autodelete": false
        },
        {
            "id": "fixture-acps-medication",
            "resource": {
                "reference": "#acps-medication"
            },
            "autocreate": false,
            "autodelete": false
        },
        {
            "id": "fixture-acps-observation",
            "resource": {
                "reference": "#acps-observation"
