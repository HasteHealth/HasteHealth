        },
        {
            "id": "fixture-acps-policy",
            "resource": {
                "reference": "#acps-policy"
            },
            "autocreate": false,
            "autodelete": false
        },
        {
            "id": "fixture-acps-policy-assignment",
            "resource": {
                "reference": "#acps-policy-assignment"
