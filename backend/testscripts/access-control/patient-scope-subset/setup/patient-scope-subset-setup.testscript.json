                        "sourceId": "fixture-acps-app",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "description": "ClientApplication/acps-app is written",
                        "resource": "ClientApplication",
                        "warningOnly": false
                    }
                }
            ]
        },
        {
            "id": "03-indexed",
            "name": "The access policy can be found the way token issuance finds it",
            "action": [
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "search"
                        },
                        "resource": "AccessPolicyV2Assignment",
                        "params": "link=Membership/acps-membership",
                        "encodeRequestUrl": false,
                        "description": "Waits for indexing: token issuance finds access policies through search."
                    }
                },
                {
                    "assert": {
                        "description": "The assignment is found by its principal",
                        "expression": "Bundle.entry.resource.where(id = 'acps-policy-assignment').exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                }
            ]
        }
    ]
