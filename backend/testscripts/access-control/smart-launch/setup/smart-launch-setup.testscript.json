                        "sourceId": "fixture-sl-app",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "description": "ClientApplication/sl-app is written",
                        "resource": "ClientApplication",
                        "warningOnly": false
                    }
                },
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "update"
                        },
                        "resource": "ClientApplication",
                        "targetId": "fixture-sl-app-no-launch",
                        "sourceId": "fixture-sl-app-no-launch",
                        "encodeRequestUrl": false,
                        "description": "A client that cannot be launched: it has no launchUri."
                    }
                },
                {
                    "assert": {
