                        "resource": "Encounter",
                        "warningOnly": false
                    }
                },
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "update"
                        },
                        "resource": "Encounter",
                        "targetId": "fixture-sl-encounter-b",
                        "sourceId": "fixture-sl-encounter-b",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "description": "Encounter/sl-encounter-b is written",
                        "resource": "Encounter",
                        "warningOnly": false
                    }
                },
                {
