        {
            "id": "01-data",
            "name": "Two patients, an encounter each, and the clients to launch",
            "action": [
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "update"
                        },
                        "resource": "Patient",
                        "targetId": "fixture-sl-patient-a",
                        "sourceId": "fixture-sl-patient-a",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "description": "Patient/sl-patient-a is written",
                        "resource": "Patient",
                        "warningOnly": false
                    }
                },
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "update"
                        },
                        "resource": "Patient",
                        "targetId": "fixture-sl-patient-b",
                        "sourceId": "fixture-sl-patient-b",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "description": "Patient/sl-patient-b is written",
                        "resource": "Patient",
                        "warningOnly": false
                    }
                },
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "update"
                        },
                        "resource": "Encounter",
                        "targetId": "fixture-sl-encounter-a",
                        "sourceId": "fixture-sl-encounter-a",
                        "encodeRequestUrl": false
                    }
                },
                {
