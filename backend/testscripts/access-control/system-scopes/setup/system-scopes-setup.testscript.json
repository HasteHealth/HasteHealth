    "test": [
        {
            "id": "01-data",
            "name": "Two patients and data of every type the tests use",
            "action": [
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "update"
                        },
                        "resource": "Patient",
                        "targetId": "fixture-acs-patient-a",
                        "sourceId": "fixture-acs-patient-a",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "description": "Patient/acs-patient-a is written",
                        "resource": "Patient",
                        "warningOnly": false
                    }
                },
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "update"
                        },
                        "resource": "Patient",
                        "targetId": "fixture-acs-patient-b",
                        "sourceId": "fixture-acs-patient-b",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "description": "Patient/acs-patient-b is written",
                        "resource": "Patient",
                        "warningOnly": false
                    }
                },
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "update"
                        },
                        "resource": "Practitioner",
                        "targetId": "fixture-acs-practitioner",
                        "sourceId": "fixture-acs-practitioner",
                        "encodeRequestUrl": false,
                        "description": "No scope grants Practitioner."
                    }
                },
                {
                    "assert": {
                        "description": "Practitioner/acs-practitioner is written",
                        "resource": "Practitioner",
                        "warningOnly": false
                    }
                },
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "update"
                        },
                        "resource": "Observation",
                        "targetId": "fixture-acs-observation-a",
                        "sourceId": "fixture-acs-observation-a",
                        "encodeRequestUrl": false,
                        "description": "Its performer is the practitioner."
                    }
                },
                {
                    "assert": {
                        "description": "Observation/acs-observation-a is written",
                        "resource": "Observation",
                        "warningOnly": false
                    }
                },
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "update"
                        },
                        "resource": "Observation",
                        "targetId": "fixture-acs-observation-b",
                        "sourceId": "fixture-acs-observation-b",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "description": "Observation/acs-observation-b is written",
                        "resource": "Observation",
                        "warningOnly": false
                    }
                },
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "update"
                        },
                        "resource": "Observation",
                        "targetId": "fixture-acs-observation-update",
                        "sourceId": "fixture-acs-observation-update",
                        "encodeRequestUrl": false,
                        "description": "Target of the refused update."
                    }
                },
                {
                    "assert": {
                        "description": "Observation/acs-observation-update is written",
                        "resource": "Observation",
                        "warningOnly": false
                    }
                },
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "update"
                        },
                        "resource": "Observation",
                        "targetId": "fixture-acs-observation-delete",
                        "sourceId": "fixture-acs-observation-delete",
                        "encodeRequestUrl": false,
                        "description": "Target of the refused delete."
                    }
                },
                {
                    "assert": {
                        "description": "Observation/acs-observation-delete is written",
                        "resource": "Observation",
                        "warningOnly": false
                    }
                },
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "update"
                        },
                        "resource": "Encounter",
                        "targetId": "fixture-acs-encounter",
                        "sourceId": "fixture-acs-encounter",
                        "encodeRequestUrl": false,
                        "description": "Readable but not searchable: Encounter.r only."
                    }
                },
                {
                    "assert": {
                        "description": "Encounter/acs-encounter is written",
                        "resource": "Encounter",
                        "warningOnly": false
                    }
                }
            ]
        },
        {
            "id": "02-login",
            "name": "The system-scopes login, its access policy and client",
            "action": [
