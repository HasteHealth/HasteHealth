        {
            "id": "03-indexed",
            "name": "The access policy can be found the way token issuance finds it",
            "action": [
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "search"
                        },
                        "resource": "AccessPolicyV2Assignment",
                        "params": "link=Membership/ac-patient-membership",
                        "encodeRequestUrl": false,
                        "description": "Waits for indexing: token issuance finds access policies through search."
                    }
                },
                {
                    "assert": {
                        "description": "The assignment is found by its Membership",
                        "expression": "Bundle.entry.resource.where(id = 'ac-patient-policy-assignment').exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "search"
                        },
                        "resource": "AccessPolicyV2",
                        "params": "_id=ac-patient-policy",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "description": "The policy is found by id",
                        "expression": "Bundle.entry.resource.where(id = 'ac-patient-policy').exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                }
            ]
        }
    ]
