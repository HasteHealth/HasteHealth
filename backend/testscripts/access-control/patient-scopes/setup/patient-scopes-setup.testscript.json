    "test": [
        {
            "id": "01-data",
            "name": "Two patients, data in and out of the first one's compartment",
            "action": [
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "update"
                        },
                        "resource": "Patient",
                        "targetId": "fixture-ac-patient-a",
                        "sourceId": "fixture-ac-patient-a",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "description": "Patient/ac-patient-a is written",
                        "resource": "Patient",
                        "warningOnly": false
                    }
                },
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "update"
                        },
                        "resource": "Patient",
                        "targetId": "fixture-ac-patient-b",
                        "sourceId": "fixture-ac-patient-b",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "description": "Patient/ac-patient-b is written",
                        "resource": "Patient",
                        "warningOnly": false
                    }
                },
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "update"
                        },
                        "resource": "Practitioner",
                        "targetId": "fixture-ac-practitioner",
                        "sourceId": "fixture-ac-practitioner",
                        "encodeRequestUrl": false,
                        "description": "Shared reference data."
                    }
                },
                {
                    "assert": {
                        "description": "Practitioner/ac-practitioner is written",
                        "resource": "Practitioner",
                        "warningOnly": false
                    }
                },
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "update"
                        },
                        "resource": "Observation",
                        "targetId": "fixture-ac-observation-a",
                        "sourceId": "fixture-ac-observation-a",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "description": "Observation/ac-observation-a is written",
                        "resource": "Observation",
                        "warningOnly": false
                    }
                },
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "update"
                        },
                        "resource": "Observation",
                        "targetId": "fixture-ac-observation-shared",
                        "sourceId": "fixture-ac-observation-shared",
                        "encodeRequestUrl": false,
                        "description": "Subject ac-patient-a; performers ac-patient-b and the practitioner."
                    }
                },
                {
                    "assert": {
                        "description": "Observation/ac-observation-shared is written",
                        "resource": "Observation",
                        "warningOnly": false
                    }
                },
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "update"
                        },
                        "resource": "Observation",
                        "targetId": "fixture-ac-observation-a-delete",
                        "sourceId": "fixture-ac-observation-a-delete",
                        "encodeRequestUrl": false,
                        "description": "Target of the refused delete, so a wrongful success affects no other test."
                    }
                },
                {
                    "assert": {
                        "description": "Observation/ac-observation-a-delete is written",
                        "resource": "Observation",
                        "warningOnly": false
                    }
                },
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "update"
                        },
                        "resource": "Observation",
                        "targetId": "fixture-ac-observation-b",
                        "sourceId": "fixture-ac-observation-b",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "description": "Observation/ac-observation-b is written",
                        "resource": "Observation",
                        "warningOnly": false
                    }
                },
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "update"
                        },
                        "resource": "Questionnaire",
                        "targetId": "fixture-ac-questionnaire",
                        "sourceId": "fixture-ac-questionnaire",
                        "encodeRequestUrl": false,
                        "description": "Outside every compartment and not shared."
                    }
                },
                {
                    "assert": {
                        "description": "Questionnaire/ac-questionnaire is written",
                        "resource": "Questionnaire",
                        "warningOnly": false
                    }
                }
            ]
        },
