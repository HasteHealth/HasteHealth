{
  "id": "access-control-policy-studio-setup",
  "url": "https://haste.health/fhir/TestScript/access-control-policy-studio-setup",
  "name": "Access Control Policy Studio Setup",
  "title": "Policy studio: member, policy and assignment",
  "status": "active",
  "description": "Run as admin. Creates the member, the clinician matrix policy and its assignment, and the data the tests read and update.",
  "resourceType": "TestScript",
  "contained": [
    {
      "id": "ps-patient",
      "resourceType": "Patient",
      "meta": {
        "tag": [
          {
            "code": "policy-studio"
          }
        ]
      },
      "name": [
        {
          "family": "Studio",
          "given": [
            "Patient"
          ]
        }
      ]
    },
    {
      "id": "ps-observation",
      "resourceType": "Observation",
      "meta": {
        "tag": [
          {
            "code": "policy-studio"
          }
        ]
      },
      "status": "final",
      "code": {
        "text": "Policy studio"
      }
    },
    {
      "id": "ps-observation-delete",
      "resourceType": "Observation",
      "meta": {
        "tag": [
          {
            "code": "policy-studio"
          }
        ]
      },
      "status": "final",
      "code": {
        "text": "Policy studio delete target"
      }
    },
    {
      "id": "ps-basic",
      "resourceType": "Basic",
      "code": {
        "text": "Policy studio unconfigured type"
      }
    },
    {
      "id": "ps-user",
      "resourceType": "User",
      "email": "policy-studio-member@example.org",
      "role": "member"
    },
    {
      "id": "ps-membership",
      "resourceType": "Membership",
      "user": {
        "reference": "User/ps-user"
      }
    },
    {
      "id": "ps-policy",
      "resourceType": "AccessPolicyV2",
      "name": "Policy studio: clinician matrix",
      "description": "Observation create/read/update and Patient read, generated by the Roles & Permissions studio.",
      "engine": "rule-engine",
      "rule": [
        {
          "name": "Observation permissions",
          "description": "Grants create, read and update on Observation.",
          "effect": "permit",
          "target": {
            "expression": {
              "language": "text/fhirpath",
              "expression": "%request.resource_type = 'Observation' and %request.type in ('create' | 'read' | 'vread' | 'search' | 'update' | 'patch')"
            }
          },
          "condition": {
            "expression": {
              "language": "text/fhirpath",
              "expression": "true"
            }
          }
        },
        {
          "name": "Patient permissions",
          "description": "Grants read on Patient.",
          "effect": "permit",
          "target": {
            "expression": {
              "language": "text/fhirpath",
              "expression": "%request.resource_type = 'Patient' and %request.type in ('read' | 'vread' | 'search')"
            }
          },
          "condition": {
            "expression": {
              "language": "text/fhirpath",
              "expression": "true"
            }
          }
        }
      ]
    },
    {
      "id": "ps-assignment",
      "resourceType": "AccessPolicyV2Assignment",
      "accessPolicy": {
        "reference": "AccessPolicyV2/ps-policy"
      },
      "link": {
        "reference": "Membership/ps-membership"
      }
    },
    {
      "id": "policy-studio-app",
      "resourceType": "ClientApplication",
      "name": "Policy studio test",
      "grantType": [
        "authorization_code",
        "refresh_token"
      ],
      "responseTypes": "code",
      "redirectUri": [
        "http://127.0.0.1:8976/callback"
      ],
      "scope": "openid offline_access user/*.*"
    }
  ],
  "fixture": [
    {
      "id": "fixture-ps-patient",
      "resource": {
        "reference": "#ps-patient"
      },
      "autocreate": false,
      "autodelete": false
    },
    {
      "id": "fixture-ps-observation",
      "resource": {
        "reference": "#ps-observation"
      },
      "autocreate": false,
      "autodelete": false
    },
    {
      "id": "fixture-ps-observation-delete",
      "resource": {
        "reference": "#ps-observation-delete"
      },
      "autocreate": false,
      "autodelete": false
    },
    {
      "id": "fixture-ps-basic",
      "resource": {
        "reference": "#ps-basic"
      },
      "autocreate": false,
      "autodelete": false
    },
    {
      "id": "fixture-ps-user",
      "resource": {
        "reference": "#ps-user"
      },
      "autocreate": false,
      "autodelete": false
    },
    {
      "id": "fixture-ps-membership",
      "resource": {
        "reference": "#ps-membership"
      },
      "autocreate": false,
      "autodelete": false
    },
    {
      "id": "fixture-ps-policy",
      "resource": {
        "reference": "#ps-policy"
      },
      "autocreate": false,
      "autodelete": false
    },
    {
      "id": "fixture-ps-assignment",
      "resource": {
        "reference": "#ps-assignment"
      },
      "autocreate": false,
      "autodelete": false
    },
    {
      "id": "fixture-ps-client",
      "resource": {
        "reference": "#policy-studio-app"
      },
      "autocreate": false,
      "autodelete": false
    }
  ],
  "test": [
    {
      "id": "01-data",
      "name": "Patient, Observations and an unconfigured Basic",
      "action": [
        {
          "operation": {
            "type": {
              "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
              "code": "update"
            },
            "resource": "Patient",
            "targetId": "fixture-ps-patient",
            "sourceId": "fixture-ps-patient",
            "encodeRequestUrl": false
          }
        },
        {
          "assert": {
            "description": "Patient/ps-patient is written",
            "resource": "Patient",
            "warningOnly": false
          }
        },
        {
          "operation": {
            "type": {
              "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
              "code": "update"
            },
            "resource": "Observation",
            "targetId": "fixture-ps-observation",
            "sourceId": "fixture-ps-observation",
            "encodeRequestUrl": false
          }
        },
        {
          "assert": {
            "description": "Observation/ps-observation is written",
            "resource": "Observation",
            "warningOnly": false
          }
        },
        {
          "operation": {
            "type": {
              "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
              "code": "update"
            },
            "resource": "Observation",
            "targetId": "fixture-ps-observation-delete",
            "sourceId": "fixture-ps-observation-delete",
            "encodeRequestUrl": false
          }
        },
        {
          "assert": {
            "description": "Observation/ps-observation-delete is written",
            "resource": "Observation",
            "warningOnly": false
          }
        },
        {
          "operation": {
            "type": {
              "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
              "code": "update"
            },
            "resource": "Basic",
            "targetId": "fixture-ps-basic",
            "sourceId": "fixture-ps-basic",
            "encodeRequestUrl": false
          }
        },
        {
          "assert": {
            "description": "Basic/ps-basic is written",
            "resource": "Basic",
            "warningOnly": false
          }
        }
      ]
    },
    {
      "id": "02-login",
      "name": "The member, the matrix policy, its assignment and the client",
      "action": [
        {
          "operation": {
            "type": {
              "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
              "code": "update"
            },
            "resource": "User",
            "targetId": "fixture-ps-user",
            "sourceId": "fixture-ps-user",
            "encodeRequestUrl": false,
            "description": "Its password is set in the sign-in phase."
          }
        },
        {
          "assert": {
            "description": "User/ps-user is written",
            "resource": "User",
            "warningOnly": false
          }
        },
        {
          "operation": {
            "type": {
              "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
              "code": "update"
            },
            "resource": "Membership",
            "targetId": "fixture-ps-membership",
            "sourceId": "fixture-ps-membership",
            "encodeRequestUrl": false
          }
        },
        {
          "assert": {
            "description": "Membership/ps-membership is written",
            "resource": "Membership",
            "warningOnly": false
          }
        },
        {
          "operation": {
            "type": {
              "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
              "code": "update"
            },
            "resource": "AccessPolicyV2",
            "targetId": "fixture-ps-policy",
            "sourceId": "fixture-ps-policy",
            "encodeRequestUrl": false
          }
        },
        {
          "assert": {
            "description": "AccessPolicyV2/ps-policy is written",
            "resource": "AccessPolicyV2",
            "warningOnly": false
          }
        },
        {
          "operation": {
            "type": {
              "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
              "code": "update"
            },
            "resource": "AccessPolicyV2Assignment",
            "targetId": "fixture-ps-assignment",
            "sourceId": "fixture-ps-assignment",
            "encodeRequestUrl": false
          }
        },
        {
          "assert": {
            "description": "AccessPolicyV2Assignment/ps-assignment is written",
            "resource": "AccessPolicyV2Assignment",
            "warningOnly": false
          }
        },
        {
          "operation": {
            "type": {
              "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
              "code": "update"
            },
            "resource": "ClientApplication",
            "targetId": "fixture-ps-client",
            "sourceId": "fixture-ps-client",
            "encodeRequestUrl": false
          }
        },
        {
          "assert": {
            "description": "ClientApplication/ps-client is written",
            "resource": "ClientApplication",
            "warningOnly": false
          }
        }
      ]
    }
  ]
}
