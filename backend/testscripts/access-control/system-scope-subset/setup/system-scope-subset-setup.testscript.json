{
    "id": "access-control-system-scope-subset-setup",
    "url": "https://haste.health/fhir/TestScript/access-control-system-scope-subset-setup",
    "name": "Access Control System Scope Subset Setup",
    "title": "System scope subset: data and login",
    "status": "active",
    "description": "Run as admin. Writes a patient with an Observation and an Encounter, a practitioner, and the login: a client-credentials client (its secret is set in the sign-in phase) and a full-access policy. The client is allowed system/*.rs system/Observation.cud; the scenario requests the narrower system/Patient.rs system/Observation.cs system/Encounter.r.",
    "resourceType": "TestScript",
    "contained": [
        {
            "id": "acss-patient",
            "resourceType": "Patient",
            "meta": {
                "tag": [
                    {
                        "code": "access-control-system-scope-subset"
                    }
                ]
            },
            "name": [
                {
                    "family": "Access",
                    "given": [
                        "Sam"
                    ]
                }
            ]
        },
        {
            "id": "acss-observation",
            "resourceType": "Observation",
            "meta": {
                "tag": [
                    {
                        "code": "access-control-system-scope-subset"
                    }
                ]
            },
            "status": "final",
            "code": {
                "text": "Heart rate"
            },
            "subject": {
                "reference": "Patient/acss-patient"
            }
        },
        {
            "id": "acss-encounter",
            "resourceType": "Encounter",
            "meta": {
                "tag": [
                    {
                        "code": "access-control-system-scope-subset"
                    }
                ]
            },
            "status": "finished",
            "class": {
                "system": "http://terminology.hl7.org/CodeSystem/v3-ActCode",
                "code": "AMB"
            },
            "subject": {
                "reference": "Patient/acss-patient"
            }
        },
        {
            "id": "acss-practitioner",
            "resourceType": "Practitioner",
            "meta": {
                "tag": [
                    {
                        "code": "access-control-system-scope-subset"
                    }
                ]
            },
            "name": [
                {
                    "family": "Access",
                    "given": [
                        "Pat"
                    ]
                }
            ]
        },
        {
            "id": "acss-policy",
            "resourceType": "AccessPolicyV2",
            "meta": {
                "tag": [
                    {
                        "code": "access-control-system-scope-subset"
                    }
                ]
            },
            "name": "Access control: system scope subset",
            "description": "Full access, so only the system scopes limit this login.",
            "engine": "full-access"
        },
        {
            "id": "acss-policy-assignment",
            "resourceType": "AccessPolicyV2Assignment",
            "meta": {
                "tag": [
                    {
                        "code": "access-control-system-scope-subset"
                    }
                ]
            },
            "accessPolicy": {
                "reference": "AccessPolicyV2/acss-policy"
            },
            "link": {
                "reference": "ClientApplication/acss-client"
            }
        },
        {
            "id": "acss-client",
            "resourceType": "ClientApplication",
            "meta": {
                "tag": [
                    {
                        "code": "access-control-system-scope-subset"
                    }
                ]
            },
            "name": "Access control: system scope subset client",
            "grantType": [
                "client_credentials"
            ],
            "responseTypes": "token",
            "scope": "system/*.rs system/Observation.cud"
        }
    ],
    "fixture": [
        {
            "id": "fixture-acss-patient",
            "resource": {
                "reference": "#acss-patient"
            },
            "autocreate": false,
            "autodelete": false
        },
        {
            "id": "fixture-acss-observation",
            "resource": {
                "reference": "#acss-observation"
            },
            "autocreate": false,
            "autodelete": false
        },
        {
            "id": "fixture-acss-encounter",
            "resource": {
                "reference": "#acss-encounter"
            },
            "autocreate": false,
            "autodelete": false
        },
        {
            "id": "fixture-acss-practitioner",
            "resource": {
                "reference": "#acss-practitioner"
            },
            "autocreate": false,
            "autodelete": false
        },
        {
            "id": "fixture-acss-policy",
            "resource": {
                "reference": "#acss-policy"
            },
            "autocreate": false,
            "autodelete": false
        },
        {
            "id": "fixture-acss-policy-assignment",
            "resource": {
                "reference": "#acss-policy-assignment"
            },
            "autocreate": false,
            "autodelete": false
        },
        {
            "id": "fixture-acss-client",
            "resource": {
                "reference": "#acss-client"
            },
            "autocreate": false,
            "autodelete": false
        }
    ],
    "test": [
        {
            "id": "01-data",
            "name": "A patient with data of every type the tests use",
            "action": [
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "update"
                        },
                        "resource": "Patient",
                        "targetId": "fixture-acss-patient",
                        "sourceId": "fixture-acss-patient",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "description": "Patient/acss-patient is written",
                        "resource": "Patient",
                        "warningOnly": false
                    }
                },
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "update"
                        },
                        "resource": "Observation",
                        "targetId": "fixture-acss-observation",
                        "sourceId": "fixture-acss-observation",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "description": "Observation/acss-observation is written",
                        "resource": "Observation",
                        "warningOnly": false
                    }
                },
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "update"
                        },
                        "resource": "Encounter",
                        "targetId": "fixture-acss-encounter",
                        "sourceId": "fixture-acss-encounter",
                        "encodeRequestUrl": false,
                        "description": "Readable but not searchable: Encounter.r is requested."
                    }
                },
                {
                    "assert": {
                        "description": "Encounter/acss-encounter is written",
                        "resource": "Encounter",
                        "warningOnly": false
                    }
                },
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "update"
                        },
                        "resource": "Practitioner",
                        "targetId": "fixture-acss-practitioner",
                        "sourceId": "fixture-acss-practitioner",
                        "encodeRequestUrl": false,
                        "description": "Allowed by the wildcard but not requested."
                    }
                },
                {
                    "assert": {
                        "description": "Practitioner/acss-practitioner is written",
                        "resource": "Practitioner",
                        "warningOnly": false
                    }
                }
            ]
        },
        {
            "id": "02-login",
            "name": "The system-scope-subset login, its access policy and client",
            "action": [
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "update"
                        },
                        "resource": "AccessPolicyV2",
                        "targetId": "fixture-acss-policy",
                        "sourceId": "fixture-acss-policy",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "description": "AccessPolicyV2/acss-policy is written",
                        "resource": "AccessPolicyV2",
                        "warningOnly": false
                    }
                },
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "update"
                        },
                        "resource": "AccessPolicyV2Assignment",
                        "targetId": "fixture-acss-policy-assignment",
                        "sourceId": "fixture-acss-policy-assignment",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "description": "AccessPolicyV2Assignment/acss-policy-assignment is written",
                        "resource": "AccessPolicyV2Assignment",
                        "warningOnly": false
                    }
                },
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "update"
                        },
                        "resource": "ClientApplication",
                        "targetId": "fixture-acss-client",
                        "sourceId": "fixture-acss-client",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "description": "ClientApplication/acss-client is written",
                        "resource": "ClientApplication",
                        "warningOnly": false
                    }
                }
            ]
        },
        {
            "id": "03-indexed",
            "name": "The access policy can be found the way token issuance finds it",
            "action": [
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "search"
                        },
                        "resource": "AccessPolicyV2Assignment",
                        "params": "link=ClientApplication/acss-client",
                        "encodeRequestUrl": false,
                        "description": "Waits for indexing: token issuance finds access policies through search."
                    }
                },
                {
                    "assert": {
                        "description": "The assignment is found by its principal",
                        "expression": "Bundle.entry.resource.where(id = 'acss-policy-assignment').exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                }
            ]
        }
    ]
}
