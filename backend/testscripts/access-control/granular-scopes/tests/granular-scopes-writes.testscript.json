{
    "id": "access-control-granular-scopes-writes",
    "url": "https://haste.health/fhir/TestScript/access-control-granular-scopes-writes",
    "name": "Access Control Granular Scopes Writes",
    "title": "Granular scopes: writes",
    "status": "active",
    "description": "Run as the granular-scopes login. A granular scope grants reads and searches of the resources matching its parameters, whatever permissions it names: writes and history are refused.",
    "resourceType": "TestScript",
    "contained": [
        {
            "id": "acg-encounter-amb",
            "resourceType": "Encounter",
            "status": "finished",
            "class": {
                "system": "http://terminology.hl7.org/CodeSystem/v3-ActCode",
                "code": "AMB"
            },
            "subject": {
                "reference": "Patient/acg-patient"
            },
            "meta": {
                "tag": [
                    {
                        "code": "access-control-granular-scopes"
                    }
                ]
            }
        },
        {
            "id": "acg-encounter-new",
            "resourceType": "Encounter",
            "status": "finished",
            "class": {
                "system": "http://terminology.hl7.org/CodeSystem/v3-ActCode",
                "code": "AMB"
            },
            "subject": {
                "reference": "Patient/acg-patient"
            },
            "meta": {
                "tag": [
                    {
                        "code": "access-control-granular-scopes"
                    }
                ]
            }
        }
    ],
    "fixture": [
        {
            "id": "fixture-acg-encounter-amb",
            "resource": {
                "reference": "#acg-encounter-amb"
            },
            "autocreate": false,
            "autodelete": false
        },
        {
            "id": "fixture-acg-encounter-new",
            "resource": {
                "reference": "#acg-encounter-new"
            },
            "autocreate": false,
            "autodelete": false
        }
    ],
    "test": [
        {
            "id": "01-create",
            "name": "Creating is refused, although the granular scope carries c",
            "action": [
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "create"
                        },
                        "resource": "Encounter",
                        "sourceId": "fixture-acg-encounter-new",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "description": "The create is forbidden",
                        "expression": "OperationOutcome.issue.where(code = 'forbidden').exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                }
            ]
        },
        {
            "id": "02-update",
            "name": "Updating is refused, although the granular scope carries u",
            "action": [
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "update"
                        },
                        "resource": "Encounter",
                        "sourceId": "fixture-acg-encounter-amb",
                        "targetId": "fixture-acg-encounter-amb",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "description": "The update is forbidden",
                        "expression": "OperationOutcome.issue.where(code = 'forbidden').exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                }
            ]
        },
        {
            "id": "03-delete",
            "name": "Deleting is refused, although the granular scope carries d",
            "action": [
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "delete"
                        },
                        "resource": "Encounter",
                        "targetId": "fixture-acg-encounter-amb",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "description": "The delete is forbidden",
                        "expression": "OperationOutcome.issue.where(code = 'forbidden').exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                }
            ]
        },
        {
            "id": "04-history",
            "name": "History is refused under a granular scope",
            "action": [
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "history"
                        },
                        "resource": "Encounter",
                        "targetId": "fixture-acg-encounter-amb",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "description": "History is forbidden",
                        "expression": "OperationOutcome.issue.where(code = 'forbidden').exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                }
            ]
        },
        {
            "id": "05-still-there",
            "name": "The refused writes changed nothing",
            "action": [
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "read"
                        },
                        "resource": "Encounter",
                        "targetId": "fixture-acg-encounter-amb",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "description": "The ambulatory Encounter is still read",
                        "expression": "Encounter.id = 'acg-encounter-amb'",
                        "value": "true",
                        "warningOnly": false
                    }
                }
            ]
        }
    ]
}
