    "test": [
        {
            "id": "01-read-inside",
            "name": "A resource in a granted category is readable",
            "action": [
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "read"
                        },
                        "resource": "Observation",
                        "targetId": "fixture-acg-observation-lab",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "description": "The laboratory Observation is read",
                        "expression": "Observation.id = 'acg-observation-lab'",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "read"
                        },
                        "resource": "Observation",
                        "targetId": "fixture-acg-observation-vital",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "description": "The vital-signs Observation is read",
                        "expression": "Observation.id = 'acg-observation-vital'",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "read"
                        },
                        "resource": "Encounter",
                        "targetId": "fixture-acg-encounter-amb",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "description": "The ambulatory Encounter is read",
                        "expression": "Encounter.id = 'acg-encounter-amb'",
                        "value": "true",
                        "warningOnly": false
                    }
                }
            ]
        },
        {
            "id": "02-read-outside",
            "name": "A resource outside every granular scope reads as not found",
            "action": [
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "read"
                        },
                        "resource": "Observation",
                        "targetId": "fixture-acg-observation-survey",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "description": "The survey Observation is not found",
                        "expression": "OperationOutcome.issue.where(code = 'not-found').exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                },
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "read"
                        },
                        "resource": "Encounter",
                        "targetId": "fixture-acg-encounter-imp",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "description": "The inpatient Encounter is not found",
                        "expression": "OperationOutcome.issue.where(code = 'not-found').exists()",
                        "value": "true",
                        "warningOnly": false
                    }
                }
            ]
        },
        {
            "id": "03-read-plain-wins",
            "name": "A plain scope beside a granular one makes every resource of the type readable",
            "action": [
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "read"
                        },
                        "resource": "Condition",
                        "targetId": "fixture-acg-condition-encounter",
                        "encodeRequestUrl": false
                    }
                },
                {
                    "assert": {
                        "description": "The encounter-diagnosis Condition is read",
                        "expression": "Condition.id = 'acg-condition-encounter'",
                        "value": "true",
                        "warningOnly": false
                    }
                }
            ]
        }
    ]
