{
  "resourceType": "TestScript",
  "id": "sof-repeat-05",
  "url": "https://haste.health/fhir/TestScript/sof-repeat-05",
  "name": "sof-repeat-05",
  "title": "SQL on FHIR repeat: combined with forEach",
  "status": "active",
  "description": "Recursive traversal with repeat directive Suite test 5 of tests/repeat.json (repeat), tagged shareable, in https://github.com/FHIR/sql-on-fhir.js at 238d9b2be4ad.",
  "contained": [
    {
      "resourceType": "Parameters",
      "id": "run-parameters",
      "parameter": [
