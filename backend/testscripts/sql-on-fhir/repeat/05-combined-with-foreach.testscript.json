                        "type": "string"
                      }
                    ]
                  }
                ]
              },
              {
                "linkId": "g2",
                "text": "Group 2",
                "type": "display"
              }
            ]
          }
        },
        {
          "name": "resource",
          "resource": {
            "resourceType": "QuestionnaireResponse",
            "id": "qr1",
            "questionnaire": "http://example.com/Questionnaire/q1",
            "status": "completed",
            "item": [
              {
                "linkId": "1",
                "text": "Group 1",
                "item": [
                  {
                    "linkId": "1.1",
                    "text": "Question 1.1",
                    "answer": [
                      {
                        "valueString": "Answer 1.1",
                        "item": [
                          {
                            "linkId": "1.1.1",
                            "text": "Follow-up to 1.1"
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "linkId": "1.2",
                    "text": "Question 1.2",
                    "item": [
                      {
                        "linkId": "1.2.1",
                        "text": "Question 1.2.1"
                      }
                    ]
                  }
                ]
              },
              {
                "linkId": "2",
                "text": "Group 2"
              }
            ]
          }
        },
        {
          "name": "_format",
          "valueCode": "json"
        }
      ]
    }
  ],
  "fixture": [
    {
      "id": "run-parameters",
      "autocreate": false,
      "autodelete": false,
      "resource": {
        "reference": "#run-parameters"
      }
    }
  ],
  "test": [
    {
      "id": "run",
      "name": "combined with forEach",
      "action": [
        {
          "operation": {
            "type": {
              "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
              "code": "invoke"
            },
            "description": "Run the test's view over the test case's resources.",
            "url": "viewdefinition-run",
            "resource": "ViewDefinition",
            "sourceId": "run-parameters",
            "responseId": "result",
            "encodeRequestUrl": false
          }
        },
        {
          "assert": {
            "description": "The view runs.",
            "responseCode": "200",
            "operator": "equals",
            "warningOnly": false
          }
        },
        {
          "assert": {
            "description": "The result is JSON.",
            "expression": "Binary.contentType = 'application/json'",
            "value": "true",
            "warningOnly": false
          }
        },
        {
          "assert": {
            "description": "The rows the suite expects, 1 in all. [{\"id\": \"qr1\", \"linkId\": \"1.1\", \"answerValue\": \"Answer 1.1\"}]",
            "expression": "Binary.data = 'W3siaWQiOiJxcjEiLCJsaW5rSWQiOiIxLjEiLCJhbnN3ZXJWYWx1ZSI6IkFuc3dlciAxLjEifV0='",
            "value": "true",
            "warningOnly": false
          }
        }
      ]
    }
  ]
