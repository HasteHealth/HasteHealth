            "resourceType": "ViewDefinition",
            "resource": "QuestionnaireResponse",
            "status": "active",
            "select": [
              {
                "column": [
                  {
                    "name": "id",
                    "path": "id",
                    "type": "id"
                  }
                ]
              },
              {
                "repeat": [
                  "item"
                ],
                "select": [
                  {
                    "column": [
                      {
                        "name": "linkId",
                        "path": "linkId",
                        "type": "string"
                      }
                    ]
                  },
                  {
                    "forEach": "answer",
                    "column": [
                      {
                        "name": "answerValue",
                        "path": "value.ofType(string)",
                        "type": "string"
                      }
                    ]
                  }
                ]
              }
            ]
          }
        },
        {
          "name": "resource",
          "resource": {
            "resourceType": "Questionnaire",
            "id": "q1",
