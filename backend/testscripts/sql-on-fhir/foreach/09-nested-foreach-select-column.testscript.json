{
  "resourceType": "TestScript",
  "id": "sof-foreach-09",
  "url": "https://haste.health/fhir/TestScript/sof-foreach-09",
  "name": "sof-foreach-09",
  "title": "SQL on FHIR foreach: nested forEach: select & column",
  "status": "active",
  "description": "TBD Suite test 9 of tests/foreach.json (foreach), tagged shareable, in https://github.com/FHIR/sql-on-fhir.js at 238d9b2be4ad.",
  "contained": [
    {
      "resourceType": "Parameters",
      "id": "run-parameters",
      "parameter": [
        {
          "name": "viewResource",
          "resource": {
            "resourceType": "ViewDefinition",
            "resource": "Patient",
            "status": "active",
            "select": [
              {
                "column": [
                  {
                    "name": "id",
                    "path": "id",
                    "type": "id"
                  }
                ]
              },
              {
                "forEach": "contact",
                "column": [
                  {
                    "name": "contact_type",
                    "path": "telecom.system",
                    "type": "code"
                  }
                ],
                "select": [
                  {
                    "forEach": "name.given",
                    "column": [
                      {
                        "name": "name",
                        "path": "$this",
                        "type": "string"
                      }
                    ]
                  }
                ]
              }
            ]
          }
        },
        {
          "name": "resource",
          "resource": {
            "resourceType": "Patient",
            "id": "pt1",
            "name": [
              {
                "family": "F1.1"
              },
              {
                "family": "F1.2"
              }
            ],
            "contact": [
              {
                "telecom": [
                  {
                    "system": "phone"
                  }
                ],
                "name": {
                  "family": "FC1.1",
                  "given": [
                    "N1",
                    "N1`"
                  ]
                }
              },
              {
                "telecom": [
                  {
                    "system": "email"
                  }
                ],
                "gender": "unknown",
                "name": {
                  "family": "FC1.2",
                  "given": [
                    "N2"
                  ]
                }
              }
            ]
          }
        },
        {
          "name": "resource",
          "resource": {
            "resourceType": "Patient",
            "id": "pt2",
            "name": [
              {
                "family": "F2.1"
              },
              {
                "family": "F2.2"
              }
            ]
          }
        },
        {
          "name": "resource",
          "resource": {
            "resourceType": "Patient",
            "id": "pt3"
          }
        },
        {
          "name": "_format",
          "valueCode": "json"
        }
      ]
    }
  ],
  "fixture": [
    {
      "id": "run-parameters",
      "autocreate": false,
      "autodelete": false,
      "resource": {
        "reference": "#run-parameters"
      }
    }
  ],
  "test": [
    {
      "id": "run",
      "name": "nested forEach: select & column",
      "action": [
        {
          "operation": {
            "type": {
              "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
              "code": "invoke"
            },
            "description": "Run the test's view over the test case's resources.",
            "url": "viewdefinition-run",
            "resource": "ViewDefinition",
            "sourceId": "run-parameters",
            "responseId": "result",
            "encodeRequestUrl": false
          }
        },
        {
          "assert": {
            "description": "The view runs.",
            "responseCode": "200",
            "operator": "equals",
            "warningOnly": false
          }
        },
        {
          "assert": {
            "description": "The result is JSON.",
            "expression": "Binary.contentType = 'application/json'",
            "value": "true",
            "warningOnly": false
          }
        },
        {
          "assert": {
            "description": "The rows the suite expects, 3 in all. [{\"id\": \"pt1\", \"contact_type\": \"phone\", \"name\": \"N1\"}, {\"id\": \"pt1\", \"contact_type\": \"phone\", \"name\": \"N1`\"}, {\"id\": \"pt1\", \"contact_type\": \"email\", \"name\": \"N2\"}]",
            "expression": "Binary.data = 'W3siaWQiOiJwdDEiLCJjb250YWN0X3R5cGUiOiJwaG9uZSIsIm5hbWUiOiJOMSJ9LHsiaWQiOiJwdDEiLCJjb250YWN0X3R5cGUiOiJwaG9uZSIsIm5hbWUiOiJOMWAifSx7ImlkIjoicHQxIiwiY29udGFjdF90eXBlIjoiZW1haWwiLCJuYW1lIjoiTjIifV0='",
            "value": "true",
            "warningOnly": false
          }
        }
      ]
    }
  ]
}
