{
  "resourceType": "TestScript",
  "id": "sof-constant-04",
  "url": "https://haste.health/fhir/TestScript/sof-constant-04",
  "name": "sof-constant-04",
  "title": "SQL on FHIR constant: constant in unionAll",
  "status": "active",
  "description": "constant substitution Suite test 4 of tests/constant.json (constant), tagged shareable, in https://github.com/FHIR/sql-on-fhir.js at 238d9b2be4ad.",
  "contained": [
    {
      "resourceType": "Parameters",
      "id": "run-parameters",
      "parameter": [
        {
          "name": "viewResource",
          "resource": {
            "resourceType": "ViewDefinition",
            "resource": "Patient",
            "status": "active",
            "constant": [
              {
                "name": "use1",
                "valueString": "official"
              },
              {
                "name": "use2",
                "valueString": "usual"
              }
            ],
            "select": [
              {
                "unionAll": [
                  {
                    "forEach": "name.where(use = %use1)",
                    "column": [
                      {
                        "name": "name",
                        "path": "family",
                        "type": "string"
                      }
                    ]
                  },
                  {
                    "forEach": "name.where(use = %use2)",
                    "column": [
                      {
                        "name": "name",
                        "path": "family",
                        "type": "string"
                      }
                    ]
                  }
                ]
              }
            ]
          }
        },
        {
          "name": "resource",
          "resource": {
            "resourceType": "Patient",
            "id": "pt1",
            "name": [
              {
                "family": "Block",
                "use": "usual"
              },
              {
                "family": "Smith",
                "use": "official"
              }
            ]
          }
        },
        {
          "name": "resource",
          "resource": {
            "resourceType": "Patient",
            "id": "pt2",
            "deceasedBoolean": true,
            "name": [
              {
                "family": "Johnson",
                "use": "usual"
              },
              {
                "family": "Menendez",
                "use": "old"
              }
            ]
          }
        },
        {
          "name": "_format",
          "valueCode": "json"
        }
      ]
    }
  ],
  "fixture": [
    {
      "id": "run-parameters",
      "autocreate": false,
      "autodelete": false,
      "resource": {
        "reference": "#run-parameters"
      }
    }
  ],
  "test": [
    {
      "id": "run",
      "name": "constant in unionAll",
      "action": [
        {
          "operation": {
            "type": {
              "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
              "code": "invoke"
            },
            "description": "Run the test's view over the test case's resources.",
            "url": "viewdefinition-run",
            "resource": "ViewDefinition",
            "sourceId": "run-parameters",
            "responseId": "result",
            "encodeRequestUrl": false
          }
        },
        {
          "assert": {
            "description": "The view runs.",
            "responseCode": "200",
            "operator": "equals",
            "warningOnly": false
          }
        },
        {
          "assert": {
            "description": "The result is JSON.",
            "expression": "Binary.contentType = 'application/json'",
            "value": "true",
            "warningOnly": false
          }
        },
        {
          "assert": {
            "description": "The rows the suite expects, 3 in all. [{\"name\": \"Smith\"}, {\"name\": \"Block\"}, {\"name\": \"Johnson\"}]",
            "expression": "Binary.data = 'W3sibmFtZSI6IlNtaXRoIn0seyJuYW1lIjoiQmxvY2sifSx7Im5hbWUiOiJKb2huc29uIn1d'",
            "value": "true",
            "warningOnly": false
          }
        }
      ]
    }
  ]
}
