{
  "resourceType": "TestScript",
  "id": "sof-constant-07",
  "url": "https://haste.health/fhir/TestScript/sof-constant-07",
  "name": "sof-constant-07",
  "title": "SQL on FHIR constant: accessing an undefined constant",
  "status": "active",
  "description": "constant substitution Suite test 7 of tests/constant.json (constant), tagged shareable, in https://github.com/FHIR/sql-on-fhir.js at 238d9b2be4ad.",
  "contained": [
    {
      "resourceType": "Parameters",
      "id": "run-parameters",
      "parameter": [
        {
          "name": "viewResource",
          "resource": {
            "resourceType": "ViewDefinition",
            "resource": "Patient",
            "status": "active",
            "constant": [
              {
                "name": "name_use",
                "valueString": "official"
              }
            ],
            "select": [
              {
                "forEach": "name.where(use = %wrong_name)",
                "column": [
                  {
                    "name": "official_name",
                    "path": "family",
                    "type": "string"
                  }
                ]
              }
            ]
          }
        },
        {
          "name": "resource",
          "resource": {
            "resourceType": "Patient",
            "id": "pt1",
            "name": [
              {
                "family": "Block",
                "use": "usual"
              },
              {
                "family": "Smith",
                "use": "official"
              }
            ]
          }
        },
        {
          "name": "resource",
          "resource": {
            "resourceType": "Patient",
            "id": "pt2",
            "deceasedBoolean": true,
            "name": [
              {
                "family": "Johnson",
                "use": "usual"
              },
              {
                "family": "Menendez",
                "use": "old"
              }
            ]
          }
        },
        {
          "name": "_format",
          "valueCode": "json"
        }
      ]
    }
  ],
  "fixture": [
    {
      "id": "run-parameters",
      "autocreate": false,
      "autodelete": false,
      "resource": {
        "reference": "#run-parameters"
      }
    }
  ],
  "test": [
    {
      "id": "run",
      "name": "accessing an undefined constant",
      "action": [
        {
          "operation": {
            "type": {
              "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
              "code": "invoke"
            },
            "description": "Run the test's view over the test case's resources.",
            "url": "viewdefinition-run",
            "resource": "ViewDefinition",
            "sourceId": "run-parameters",
            "responseId": "result",
            "encodeRequestUrl": false
          }
        },
        {
          "assert": {
            "description": "The view is refused, and not by a server failure.",
            "responseCode": "500,501,502,503,504",
            "operator": "notIn",
            "warningOnly": false
          }
        },
        {
          "assert": {
            "description": "The response is an OperationOutcome reporting an error.",
            "expression": "OperationOutcome.issue.where(severity = 'error' or severity = 'fatal').exists()",
            "value": "true",
            "warningOnly": false
          }
        }
      ]
    }
  ]
}
