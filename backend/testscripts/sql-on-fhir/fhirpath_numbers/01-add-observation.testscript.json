{
  "resourceType": "TestScript",
  "id": "sof-fhirpath-numbers-01",
  "url": "https://haste.health/fhir/TestScript/sof-fhirpath-numbers-01",
  "name": "sof-fhirpath-numbers-01",
  "title": "SQL on FHIR fhirpath_numbers: add observation",
  "status": "active",
  "description": "fhirpath features Suite test 1 of tests/fhirpath_numbers.json (fhirpath_numbers), tagged shareable, in https://github.com/FHIR/sql-on-fhir.js at 238d9b2be4ad.",
  "contained": [
    {
      "resourceType": "Parameters",
      "id": "run-parameters",
      "parameter": [
        {
          "name": "viewResource",
          "resource": {
            "resourceType": "ViewDefinition",
            "resource": "Observation",
            "status": "active",
            "select": [
              {
                "column": [
                  {
                    "name": "id",
                    "path": "id",
                    "type": "id"
                  },
                  {
                    "name": "add",
                    "path": "value.ofType(Range).low.value + value.ofType(Range).high.value",
                    "type": "decimal"
                  },
                  {
                    "name": "sub",
                    "path": "value.ofType(Range).high.value - value.ofType(Range).low.value",
                    "type": "decimal"
                  },
                  {
                    "name": "mul",
                    "path": "value.ofType(Range).low.value * value.ofType(Range).high.value",
                    "type": "decimal"
                  },
                  {
                    "name": "div",
                    "path": "value.ofType(Range).high.value / value.ofType(Range).low.value",
                    "type": "decimal"
                  },
                  {
                    "name": "eq",
                    "path": "value.ofType(Range).high.value = value.ofType(Range).low.value",
                    "type": "boolean"
                  },
                  {
                    "name": "gt",
                    "path": "value.ofType(Range).high.value > value.ofType(Range).low.value",
                    "type": "boolean"
                  },
                  {
                    "name": "ge",
                    "path": "value.ofType(Range).high.value >= value.ofType(Range).low.value",
                    "type": "boolean"
                  },
                  {
                    "name": "lt",
                    "path": "value.ofType(Range).high.value < value.ofType(Range).low.value",
                    "type": "boolean"
                  },
                  {
                    "name": "le",
                    "path": "value.ofType(Range).high.value <= value.ofType(Range).low.value",
                    "type": "boolean"
                  }
                ]
              }
            ]
          }
        },
        {
          "name": "resource",
          "resource": {
            "resourceType": "Observation",
            "id": "o1",
            "code": {
              "text": "code"
            },
            "status": "final",
            "valueRange": {
              "low": {
                "value": 2
              },
              "high": {
                "value": 3
              }
            }
          }
        },
        {
          "name": "_format",
          "valueCode": "json"
        }
      ]
    }
  ],
  "fixture": [
    {
      "id": "run-parameters",
      "autocreate": false,
      "autodelete": false,
      "resource": {
        "reference": "#run-parameters"
      }
    }
  ],
  "test": [
    {
      "id": "run",
      "name": "add observation",
      "action": [
        {
          "operation": {
            "type": {
              "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
              "code": "invoke"
            },
            "description": "Run the test's view over the test case's resources.",
            "url": "viewdefinition-run",
            "resource": "ViewDefinition",
            "sourceId": "run-parameters",
            "responseId": "result",
            "encodeRequestUrl": false
          }
        },
        {
          "assert": {
            "description": "The view runs.",
            "responseCode": "200",
            "operator": "equals",
            "warningOnly": false
          }
        },
        {
          "assert": {
            "description": "The result is JSON.",
            "expression": "Binary.contentType = 'application/json'",
            "value": "true",
            "warningOnly": false
          }
        },
        {
          "assert": {
            "description": "The rows the suite expects, 1 in all. [{\"id\": \"o1\", \"add\": 5.0, \"sub\": 1.0, \"mul\": 6.0, \"div\": 1.5, \"eq\": false, \"gt\": true, \"ge\": true, \"lt\": false, \"le\": false}]",
            "expression": "Binary.data = 'W3siaWQiOiJvMSIsImFkZCI6NS4wLCJzdWIiOjEuMCwibXVsIjo2LjAsImRpdiI6MS41LCJlcSI6ZmFsc2UsImd0Ijp0cnVlLCJnZSI6dHJ1ZSwibHQiOmZhbHNlLCJsZSI6ZmFsc2V9XQ=='",
            "value": "true",
            "warningOnly": false
          }
        }
      ]
    }
  ]
}
