            "name": [
              {
                "family": "f2.1"
              },
              {
                "family": "f2.2",
                "use": "official"
              }
            ],
            "active": false
          }
        },
        {
          "name": "resource",
          "resource": {
            "resourceType": "Patient",
            "id": "pt3"
          }
        },
        {
          "name": "_format",
          "valueCode": "json"
        }
      ]
    }
  ],
  "fixture": [
    {
      "id": "run-parameters",
      "autocreate": false,
      "autodelete": false,
      "resource": {
        "reference": "#run-parameters"
      }
    }
  ],
  "test": [
    {
      "id": "run",
      "name": "nested exists",
      "action": [
        {
          "operation": {
            "type": {
              "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
              "code": "invoke"
            },
            "description": "Run the test's view over the test case's resources.",
            "url": "viewdefinition-run",
            "resource": "ViewDefinition",
            "sourceId": "run-parameters",
            "responseId": "result",
            "encodeRequestUrl": false
          }
        },
        {
          "assert": {
            "description": "The view runs.",
            "responseCode": "200",
            "operator": "equals",
            "warningOnly": false
          }
        },
        {
          "assert": {
            "description": "The result is JSON.",
            "expression": "Binary.contentType = 'application/json'",
            "value": "true",
            "warningOnly": false
          }
        },
        {
          "assert": {
            "description": "The rows the suite expects, 3 in all. [{\"id\": \"pt1\", \"has_given\": true}, {\"id\": \"pt2\", \"has_given\": false}, {\"id\": \"pt3\", \"has_given\": false}]",
            "expression": "Binary.data = 'W3siaWQiOiJwdDEiLCJoYXNfZ2l2ZW4iOnRydWV9LHsiaWQiOiJwdDIiLCJoYXNfZ2l2ZW4iOmZhbHNlfSx7ImlkIjoicHQzIiwiaGFzX2dpdmVuIjpmYWxzZX1d'",
            "value": "true",
            "warningOnly": false
          }
        }
      ]
    }
