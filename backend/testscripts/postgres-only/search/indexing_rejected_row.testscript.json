{
    "id": "search-indexing-rejected-row",
    "url": "https://haste.health/fhir/TestScript/search-indexing-rejected-row",
    "name": "Search Indexing Rejected Row Test",
    "title": "A resource Postgres cannot index is parked, not retried",
    "status": "active",
    "description": "A ValueSet whose url is longer than a B-tree entry may be (the uri index is over the whole value) cannot be written to the search index. The indexing worker parks that resource in the failed-indexing list, which $indexing-errors reports, and keeps indexing the project: resources created after it are searchable. Postgres only: Elasticsearch indexes the value.",
    "extension": [
        {
            "url": "https://haste.health/fhir/StructureDefinition/testscript-search-backend",
            "valueCode": "postgres"
        }
    ],
    "resourceType": "TestScript",
    "contained": [
        {
            "id": "rejected-bundle",
            "resourceType": "Bundle",
            "type": "transaction",
            "entry": [
                {
                    "fullUrl": "urn:uuid:4e5c1a2e-7d1b-4f0a-9b1c-0d3e2f1a5b6c",
                    "request": {
                        "method": "PUT",
                        "url": "ValueSet/indexing-rejected-row-valueset"
                    },
                    "resource": {
                        "id": "indexing-rejected-row-valueset",
                        "resourceType": "ValueSet",
                        "meta": {
                            "tag": [
                                {
                                    "code": "indexing-rejected-row-test"
                                }
                            ]
                        },
                        "url": "https://haste.health/fhir/ValueSet/indexing-rejected-",
                        "name": "IndexingRejectedRow",
                        "status": "active"
                    }
                }
            ]
        },
        {
            "id": "indexed-after-valueset",
            "resourceType": "ValueSet",
            "meta": {
                "tag": [
                    {
                        "code": "indexing-rejected-row-test"
                    }
                ]
            },
            "url": "https://haste.health/fhir/ValueSet/indexing-rejected-row-after",
            "name": "IndexedAfter",
            "status": "active"
        },
        {
            "id": "indexed-later-valueset",
            "resourceType": "ValueSet",
            "meta": {
                "tag": [
                    {
                        "code": "indexing-rejected-row-test"
                    }
                ]
            },
            "url": "https://haste.health/fhir/ValueSet/indexing-rejected-row-later",
            "name": "IndexedLater",
            "status": "active"
        },
        {
            "id": "no-parameters",
            "resourceType": "Parameters"
        }
    ],
    "fixture": [
        {
            "id": "fixture-rejected-bundle",
            "resource": {
                "reference": "#rejected-bundle"
            },
            "autocreate": false,
            "autodelete": false
        },
        {
            "id": "fixture-indexed-after",
            "resource": {
                "reference": "#indexed-after-valueset"
            },
            "autocreate": false,
            "autodelete": false
        },
        {
            "id": "fixture-indexed-later",
            "resource": {
                "reference": "#indexed-later-valueset"
            },
            "autocreate": false,
            "autodelete": false
        },
        {
            "id": "fixture-no-parameters",
            "resource": {
                "reference": "#no-parameters"
            },
            "autocreate": false,
            "autodelete": false
        }
    ],
    "test": [
        {
            "id": "01-rejected-row-is-parked",
            "name": "The rejected resource is parked and later writes are indexed",
            "description": "The rejected ValueSet is written in a transaction, which the runner does not wait on. Two more ValueSets are then created and each searched for in turn: the second search proves a later indexing pass ran, and a pass commits the previous pass's parked resources before it starts.",
            "action": [
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "transaction"
                        },
                        "encodeRequestUrl": false,
                        "sourceId": "fixture-rejected-bundle",
                        "responseId": "rejected-response",
                        "description": "A ValueSet whose url no B-tree entry can hold."
                    }
                },
                {
                    "assert": {
                        "expression": "Bundle.entry.resource.id = 'indexing-rejected-row-valueset'",
                        "warningOnly": false,
                        "description": "The repository accepts it.",
                        "value": "true"
                    }
                },
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "create"
                        },
                        "encodeRequestUrl": false,
                        "resource": "ValueSet",
                        "sourceId": "fixture-indexed-after",
                        "responseId": "after-response"
                    }
                },
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "search"
                        },
                        "encodeRequestUrl": false,
                        "resource": "ValueSet",
                        "params": "_tag=indexing-rejected-row-test",
                        "description": "Waits for the ValueSet created after the rejected one."
                    }
                },
                {
                    "assert": {
                        "expression": "Bundle.entry.count()",
                        "warningOnly": false,
                        "description": "Only the indexable ValueSet is found.",
                        "operator": "equals",
                        "value": "1"
                    }
                },
                {
                    "assert": {
                        "expression": "Bundle.entry.resource.url = 'https://haste.health/fhir/ValueSet/indexing-rejected-row-after'",
                        "warningOnly": false,
                        "value": "true"
                    }
                },
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "create"
                        },
                        "encodeRequestUrl": false,
                        "resource": "ValueSet",
                        "sourceId": "fixture-indexed-later",
                        "responseId": "later-response"
                    }
                },
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "search"
                        },
                        "encodeRequestUrl": false,
                        "resource": "ValueSet",
                        "params": "_tag=indexing-rejected-row-test",
                        "description": "Waits for a later indexing pass."
                    }
                },
                {
                    "assert": {
                        "expression": "Bundle.entry.count()",
                        "warningOnly": false,
                        "description": "Indexing went on past the rejected resource.",
                        "operator": "equals",
                        "value": "2"
                    }
                },
                {
                    "operation": {
                        "type": {
                            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                            "code": "invoke"
                        },
                        "encodeRequestUrl": false,
                        "url": "indexing-errors",
                        "sourceId": "fixture-no-parameters",
                        "responseId": "errors-response",
                        "description": "$indexing-errors lists the parked resource."
                    }
                },
                {
                    "assert": {
                        "expression": "Parameters.parameter.where(name = 'errors').where(part.where(name = 'id').value = 'indexing-rejected-row-valueset').exists()",
                        "warningOnly": false,
                        "description": "The rejected ValueSet is parked.",
                        "value": "true"
                    }
                },
                {
                    "assert": {
                        "expression": "Parameters.parameter.where(name = 'errors').where(part.where(name = 'id').value = 'indexing-rejected-row-valueset' and part.where(name = 'resource_type').value = 'ValueSet' and part.where(name = 'error_message').value.exists()).exists()",
                        "warningOnly": false,
                        "description": "As a ValueSet, with the database's reason.",
                        "value": "true"
                    }
                }
            ]
        }
    ],
    "teardown": {
        "action": [
            {
                "operation": {
                    "type": {
                        "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
                        "code": "deleteCondMultiple"
                    },
                    "encodeRequestUrl": false,
                    "resource": "ValueSet",
                    "params": "_tag=indexing-rejected-row-test",
                    "description": "Delete data created during test."
                }
            }
        ]
    }
}
