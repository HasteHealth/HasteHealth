{
  "name": "@haste-health/lang-fp",
  "version": "0.130.7",
  "description": "FHIRPath language support for CodeMirror. Includes syntax highlighting and parsing.",
  "scripts": {
    "lezer": "lezer-generator src/syntax.grammar -o src/syntax.grammar.js",
    "prepare": "pnpm lezer && rollup -c",
    "build": "pnpm prepare",
    "prepublishOnly": "pnpm build"
  },
  "type": "module",
  "main": "lib/index.cjs",
  "module": "lib/index.js",
  "exports": {
    "import": "./lib/index.js",
    "require": "./lib/index.cjs"
  },
  "types": "lib/index.d.ts",
  "sideEffects": false,
  "dependencies": {
    "@codemirror/language": "^6.10.8",
    "@lezer/common": "^1.5.5",
    "@lezer/highlight": "^1.2.5",
    "@lezer/lr": "^1.4.12"
  },
  "devDependencies": {
    "@lezer/generator": "^1.8.1",
    "@rollup/plugin-typescript": "^12.3.1",
    "mocha": "^12.0.3",
    "rollup": "^4.68.2",
    "rollup-plugin-dts": "^6.5.1",
    "tslib": "^2.9.1",
    "typescript": "^4.9.5"
  },
  "license": "MIT"
}