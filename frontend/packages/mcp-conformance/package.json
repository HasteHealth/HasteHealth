{
  "name": "@haste-health/mcp-conformance",
  "version": "0.126.33",
  "private": true,
  "type": "module",
  "description": "Checks the Haste Health MCP server against the MCP specification and exercises every tool it lists.",
  "scripts": {
    "test": "node --test --test-concurrency=1 --test-skip-pattern='known gap' 'tests/*.test.mjs'",
    "test:gaps": "node --test --test-concurrency=1 --test-name-pattern='known gap' 'tests/*.test.mjs'"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "ajv": "^8.20.0"
  }
}
