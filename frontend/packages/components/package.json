{
  "name": "@haste-health/components",
  "version": "0.130.5",
  "homepage": "https://haste.health",
  "repository": {
    "type": "git",
    "url": "https://github.com/HasteHealth/HasteHealth.git"
  },
  "description": "Haste Health React component library",
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/types.d.ts",
  "scripts": {
    "build": "rollup -c --bundleConfigAsCjs && pnpm postcss --config postcss.config.js -o dist/index.css src/index.css",
    "storybook": "storybook dev -p 6006",
    "wrangler": "pnpm build-storybook && wrangler deploy",
    "remove": "wrangler delete",
    "build-storybook": "storybook build",
    "watch-js": "rollup --watch -c --bundleConfigAsCjs",
    "watch-css": "postcss --watch --config postcss.config.js -o dist/index.css src/index.css",
    "prepublishOnly": "pnpm build"
  },
  "peerDependencies": {
    "@codemirror/autocomplete": ">=6.0.0",
