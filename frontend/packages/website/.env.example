DOCS_CLIENT_ID=haste-website-questionnaire-form
DOCS_API_BASE_URI=https://api.haste.health

# The local Haste Health server `pnpm generate` snapshots (the `server` step:
# CapabilityStatement, OperationDefinitions and MCP tools). The client is a
# client-credentials ClientApplication in that project, for example one made
# with `haste-health admin client create --grant-type client-credentials`.
HASTE_HEALTH_URL=http://localhost:3000
HASTE_HEALTH_TENANT=my-health
HASTE_HEALTH_PROJECT=system
HASTE_HEALTH_CLIENT_ID=cli
HASTE_HEALTH_CLIENT_SECRET=testing
