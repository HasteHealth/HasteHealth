{"name":"Identifier","kind":"complex-type","url":"http://hl7.org/fhir/StructureDefinition/Identifier","source":"hl7","definition":"An identifier - identifies some entity uniquely and unambiguously. Typically this is used for business identifiers.","status":"normative","hl7":"https://hl7.org/fhir/R4/datatypes.html","raw":"/fhir/R4/Identifier.json","elements":[{"path":"Identifier.id","min":0,"max":"1","types":[{"code":"string","href":"/docs/reference/fhir/model/types/string"}],"short":"Unique id for inter-element referencing","inherited":true},{"path":"Identifier.extension","min":0,"max":"*","types":[{"code":"Extension","href":"/docs/reference/fhir/model/types/Extension"}],"short":"Additional content defined by implementations","inherited":true},{"path":"Identifier.use","min":0,"max":"1","types":[{"code":"code","href":"/docs/reference/fhir/model/types/code"}],"short":"usual | official | temp | secondary | old (If known)","modifier":true,"summary":true,"binding":{"strength":"required","valueSet":"http://hl7.org/fhir/ValueSet/identifier-use"}},{"path":"Identifier.type","min":0,"max":"1","types":[{"code":"CodeableConcept","href":"/docs/reference/fhir/model/types/CodeableConcept"}],"short":"Description of identifier","summary":true,"binding":{"strength":"extensible","valueSet":"http://hl7.org/fhir/ValueSet/identifier-type"}},{"path":"Identifier.system","min":0,"max":"1","types":[{"code":"uri","href":"/docs/reference/fhir/model/types/uri"}],"short":"The namespace for the identifier value","summary":true},{"path":"Identifier.value","min":0,"max":"1","types":[{"code":"string","href":"/docs/reference/fhir/model/types/string"}],"short":"The value that is unique","summary":true},{"path":"Identifier.period","min":0,"max":"1","types":[{"code":"Period","href":"/docs/reference/fhir/model/types/Period"}],"short":"Time period when id is/was valid for use","summary":true},{"path":"Identifier.assigner","min":0,"max":"1","types":[{"code":"Reference","href":"/docs/reference/fhir/model/ty