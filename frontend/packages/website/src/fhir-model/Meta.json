{"name":"Meta","kind":"complex-type","url":"http://hl7.org/fhir/StructureDefinition/Meta","source":"hl7","definition":"The metadata about a resource. This is content in the resource that is maintained by the infrastructure. Changes to the content might not always be associated with version changes to the resource.","status":"normative","hl7":"https://hl7.org/fhir/R4/datatypes.html","raw":"/fhir/R4/Meta.json","elements":[{"path":"Meta.id","min":0,"max":"1","types":[{"code":"string","href":"/docs/reference/fhir/model/types/string"}],"short":"Unique id for inter-element referencing","inherited":true},{"path":"Meta.extension","min":0,"max":"*","types":[{"code":"Extension","href":"/docs/reference/fhir/model/types/Extension"}],"short":"Additional content defined by implementations","inherited":true},{"path":"Meta.versionId","min":0,"max":"1","types":[{"code":"id","href":"/docs/reference/fhir/model/types/id"}],"short":"Version specific identifier","summary":true},{"path":"Meta.lastUpdated","min":0,"max":"1","types":[{"code":"instant","href":"/docs/reference/fhir/model/types/instant"}],"short":"When the resource version last changed","summary":true},{"path":"Meta.source","min":0,"max":"1","types":[{"code":"uri","href":"/docs/reference/fhir/model/types/uri"}],"short":"Identifies where the resource comes from","summary":true},{"path":"Meta.profile","min":0,"max":"*","types":[{"code":"canonical","href":"/docs/reference/fhir/model/types/canonical","targets":[{"name":"StructureDefinition","href":"/docs/reference/fhir/model/resources/StructureDefinition"}]}],"short":"Profiles this resource claims to conform to","summary":true},{"path":"Meta.security","min":0,"max":"*","types":[{"code":"Coding","href":"/docs/reference/fhir/model/types/Coding"}],"short":"Security Labels applied to this resource","summary":true,"binding":{"strength":"extensible","valueSet":"http://hl7.org/fhir/ValueSet/security-labels"}},{"path":"Meta.tag","min":0,"max":"*","types":[{"code":"Coding","href":"/docs/reference/fhir/model/types/Coding"}],"short":"Tags applied to this resource","summary":true,"binding":{"strength":"example","valueSet":"http://hl7.org/fhir/ValueSet/common-tags"}}]}