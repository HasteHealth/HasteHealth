{"name":"Address","kind":"complex-type","url":"http://hl7.org/fhir/StructureDefinition/Address","source":"hl7","definition":"An address expressed using postal conventions (as opposed to GPS or other location definition formats).  This data type may be used to convey addresses for use in delivering mail as well as for visiting locations which might not be valid for mail delivery.  There are a variety of postal address formats defined around the world.","status":"normative","hl7":"https://hl7.org/fhir/R4/datatypes.html","raw":"/fhir/R4/Address.json","elements":[{"path":"Address.id","min":0,"max":"1","types":[{"code":"string","href":"/docs/reference/fhir/model/types/string"}],"short":"Unique id for inter-element referencing","inherited":true},{"path":"Address.extension","min":0,"max":"*","types":[{"code":"Extension","href":"/docs/reference/fhir/model/types/Extension"}],"short":"Additional content defined by implementations","inherited":true},{"path":"Address.use","min":0,"max":"1","types":[{"code":"code","href":"/docs/reference/fhir/model/types/code"}],"short":"home | work | temp | old | billing - purpose of this address","modifier":true,"summary":true,"binding":{"strength":"required","valueSet":"http://hl7.org/fhir/ValueSet/address-use"}},{"path":"Address.type","min":0,"max":"1","types":[{"code":"code","href":"/docs/reference/fhir/model/types/code"}],"short":"postal | physical | both","summary":true,"binding":{"strength":"required","valueSet":"http://hl7.org/fhir/ValueSet/address-type"}},{"path":"Address.text","min":0,"max":"1","types":[{"code":"string","href":"/docs/reference/fhir/model/types/string"}],"short":"Text representation of the address","summary":true},{"path":"Address.line","min":0,"max":"*","types":[{"code":"string","href":"/docs/reference/fhir/model/types/string"}],"short":"Street name, number, direction & P.O. Box etc.","summary":true},{"path":"Address.city","min":0,"max":"1","types":[{"code":"string","href":"/docs/reference/fhir/model/types/string"}],"short":"Name of city, town etc.","summary":true},{"path":"Address.district","min":0,"max":"1","types":[{"code":"string","href":"/docs/reference/fhir/model/types/string"}],"short":"District name (aka county)","summary":true},{"path":"Address.state","min":0,"max":"1","types":[{"code":"string","href":"/docs/reference/fhir/model/types/string"}],"short":"Sub-unit of country (abbreviations ok)","summary":true},{"path":"Address.postalCode","min":0,"max":"1","types":[{"code":"string","href":"/docs/reference/fhir/model/types/string"}],"short":"Postal code for area","summary":true},{"path":"Address.country","min":0,"max":"1","types":[{"code":"string","href":"/docs/reference/fhir/model/types/string"}],"short":"Country (e.g. can be ISO 3166 2 or 3 letter code)","summary":true},{"path":"Address.period","min":0,"max":"1","types":[{"code":"Period","href":"/docs/reference/fhir/model/types/Period"}],"short":"Time period when address was/is in use","summary":true}]}