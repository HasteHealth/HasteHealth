{"name":"Signature","kind":"complex-type","url":"http://hl7.org/fhir/StructureDefinition/Signature","source":"hl7","definition":"A signature along with supporting context. The signature may be a digital signature that is cryptographic in nature, or some other signature acceptable to the domain. This other signature may be as simple as a graphical image representing a hand-written signature, or a signature ceremony Different signature approaches have different utilities.","status":"trial-use","hl7":"https://hl7.org/fhir/R4/datatypes.html","raw":"/fhir/R4/Signature.json","elements":[{"path":"Signature.id","min":0,"max":"1","types":[{"code":"string","href":"/docs/reference/fhir/model/types/string"}],"short":"Unique id for inter-element referencing","inherited":true},{"path":"Signature.extension","min":0,"max":"*","types":[{"code":"Extension","href":"/docs/reference/fhir/model/types/Extension"}],"short":"Additional content defined by implementations","inherited":true},{"path":"Signature.type","min":1,"max":"*","types":[{"code":"Coding","href":"/docs/reference/fhir/model/types/Coding"}],"short":"Indication of the reason the entity signed the object(s)","summary":true,"binding":{"strength":"preferred","valueSet":"http://hl7.org/fhir/ValueSet/signature-type"}},{"path":"Signature.when","min":1,"max":"1","types":[{"code":"instant","href":"/docs/reference/fhir/model/types/instant"}],"short":"When the signature was created","summary":true},{"path":"Signature.who","min":1,"max":"1","types":[{"code":"Reference","href":"/docs/reference/fhir/model/types/Reference","targets":[{"name":"Practitioner","href":"/docs/reference/fhir/model/resources/Practitioner"},{"name":"PractitionerRole","href":"/docs/reference/fhir/model/resources/PractitionerRole"},{"name":"RelatedPerson","href":"/docs/reference/fhir/model/resources/RelatedPerson"},{"name":"Patient","href":"/docs/reference/fhir/model/resources/Patient"},{"name":"Device","href":"/docs/reference/fhir/model/resources/Device"},{"name":"O