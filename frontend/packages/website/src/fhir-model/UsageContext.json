{"name":"UsageContext","kind":"complex-type","url":"http://hl7.org/fhir/StructureDefinition/UsageContext","source":"hl7","definition":"Specifies clinical/business/etc. metadata that can be used to retrieve, index and/or categorize an artifact. This metadata can either be specific to the applicable population (e.g., age category, DRG) or the specific context of care (e.g., venue, care setting, provider of care).","status":"trial-use","hl7":"https://hl7.org/fhir/R4/datatypes.html","raw":"/fhir/R4/UsageContext.json","elements":[{"path":"UsageContext.id","min":0,"max":"1","types":[{"code":"string","href":"/docs/reference/fhir/model/types/string"}],"short":"Unique id for inter-element referencing","inherited":true},{"path":"UsageContext.extension","min":0,"max":"*","types":[{"code":"Extension","href":"/docs/reference/fhir/model/types/Extension"}],"short":"Additional content defined by implementations","inherited":true},{"path":"UsageContext.code","min":1,"max":"1","types":[{"code":"Coding","href":"/docs/reference/fhir/model/types/Coding"}],"short":"Type of context being specified","summary":true,"binding":{"strength":"extensible","valueSet":"http://hl7.org/fhir/ValueSet/usage-context-type"}},{"path":"UsageContext.value[x]","min":1,"max":"1","types":[{"code":"CodeableConcept","href":"/docs/reference/fhir/model/types/CodeableConcept"},{"code":"Quantity","href":"/docs/reference/fhir/model/types/Quantity"},{"code":"Range","href":"/docs/reference/fhir/model/types/Range"},{"code":"Reference","href":"/docs/reference/fhir/model/types/Reference","targets":[{"name":"PlanDefinition","href":"/docs/reference/fhir/model/resources/PlanDefinition"},{"name":"ResearchStudy","href":"/docs/reference/fhir/model/resources/ResearchStudy"},{"name":"InsurancePlan","href":"/docs/reference/fhir/model/resources/InsurancePlan"},{"name":"HealthcareService","href":"/docs/reference/fhir/model/resources/HealthcareService"},{"name":"Group","href":"/docs/reference/fhir/model/resources/Group"},{"name":"Location","href":"/docs/reference/fhir/model/resources/Location"},{"name":"Organization","href":"/docs/reference/fhir/model/resources/Organization"}]}],"short":"Value that defines the context","summary":true,"binding":{"strength":"example","valueSet":"http://hl7.org/fhir/ValueSet/use-context"}}]}