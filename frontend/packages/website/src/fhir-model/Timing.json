{"name":"Timing","kind":"complex-type","url":"http://hl7.org/fhir/StructureDefinition/Timing","source":"hl7","definition":"Specifies an event that may occur multiple times. Timing schedules are used to record when things are planned, expected or requested to occur. The most common usage is in dosage instructions for medications. They are also used when planning care of various kinds, and may be used for reporting the schedule to which past regular activities were carried out.","status":"normative","hl7":"https://hl7.org/fhir/R4/datatypes.html","raw":"/fhir/R4/Timing.json","elements":[{"path":"Timing.id","min":0,"max":"1","types":[{"code":"string","href":"/docs/reference/fhir/model/types/string"}],"short":"Unique id for inter-element referencing","inherited":true},{"path":"Timing.extension","min":0,"max":"*","types":[{"code":"Extension","href":"/docs/reference/fhir/model/types/Extension"}],"short":"Additional content defined by implementations","inherited":true},{"path":"Timing.modifierExtension","min":0,"max":"*","types":[{"code":"Extension","href":"/docs/reference/fhir/model/types/Extension"}],"short":"Extensions that cannot be ignored even if unrecognized","modifier":true,"summary":true,"inherited":true},{"path":"Timing.event","min":0,"max":"*","types":[{"code":"dateTime","href":"/docs/reference/fhir/model/types/dateTime"}],"short":"When the event occurs","summary":true},{"path":"Timing.repeat","min":0,"max":"1","types":[{"code":"Element","href":"/docs/reference/fhir/model/types/Element"}],"short":"When the event is to occur","summary":true},{"path":"Timing.repeat.id","min":0,"max":"1","types":[{"code":"string","href":"/docs/reference/fhir/model/types/string"}],"short":"Unique id for inter-element referencing","inherited":true},{"path":"Timing.repeat.extension","min":0,"max":"*","types":[{"code":"Extension","href":"/docs/reference/fhir/model/types/Extension"}],"short":"Additional content defined by implementations","inherited":true},{"path":"Timing.repeat.bounds[x]","min":0,"max":"1","types":[{"code":"Duration","href":"/docs/reference/fhir/model/types/Duration"},{"code":"Range","href":"/docs/reference/fhir/model/types/Range"},{"code":"Period","href":"/docs/reference/fhir/model/types/Period"}],"short":"Length/Range of lengths, or (Start and/or end) limits","summary":true},{"path":"Timing.repeat.count","min":0,"max":"1","types":[{"code":"positiveInt","href":"/docs/reference/fhir/model/types/positiveInt"}],"short":"Number of times to repeat","summary":true},{"path":"Timing.repeat.countMax","min":0,"max":"1","types":[{"code":"positiveInt","href":"/docs/reference/fhir/model/types/positiveInt"}],"short":"Maximum number of times to repeat","summary":true},{"path":"Timing.repeat.duration","min":0,"max":"1","types":[{"code":"decimal","href":"/docs/reference/fhir/model/types/decimal"}],"short":"How long when it happens","summary":true},{"path":"Timing.repeat.durationMax","min":0,"max":"1","types":[{"code":"decimal","href":"/docs/reference/fhir/model/types/decimal"}],"short":"How long when it happens (Max)","summary":true},{"path":"Timing.repeat.durationUnit","min":0,"max":"1","types":[{"code":"code","href":"/docs/reference/fhir/model/types/code"}],"short":"s | min | h | d | wk | mo | a - unit of time (UCUM)","summary":true,"binding":{"strength":"required","valueSet":"http://hl7.org/fhir/ValueSet/units-of-time"}},{"path":"Timing.repeat.frequency","min":0,"max":"1","types":[{"code":"positiveInt","href":"/docs/reference/fhir/model/types/positiveInt"}],"short":"Event occurs frequency times per period","summary":true},{"path":"Timing.repeat.frequencyMax","min":0,"max":"1","types":[{"code":"positiveInt","href":"/docs/reference/fhir/model/types/positiveInt"}],"short":"Event occurs up to frequencyMax times per period","summary":true},{"path":"Timing.repeat.period","min":0,"max":"1","types":[{"code":"decimal","href":"/docs/reference/fhir/model/types/decimal"}],"short":"Event occurs frequency times per period","summary":true},{"path":"Timing.re