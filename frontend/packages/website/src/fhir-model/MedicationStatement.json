gres":"pass","elasticsearch":"pass"}},{"code":"code","type":"token","description":"Return statements of this medication code","expression":"(MedicationStatement.medication.ofType(CodeableConcept))","coverage":{"postgres":"pass","elasticsearch":"pass"}},{"code":"context","type":"reference","description":"Returns statements for a specific context (episode or episode of Care).","expression":"MedicationStatement.context","coverage":{"postgres":"pass","elasticsearch":"pass"}},{"code":"effective","type":"date","description":"Date when patient was taking (or not taking) the medication","expression":"MedicationStatement.effective","coverage":{"postgres":"pass","elasticsearch":"pass"}},{"code":"identifier","type":"token","description":"Return statements with this external identifier","expression":"MedicationStatement.identifier","coverage":{"postgres":"pass","elasticsearch":"pass"}},{"code":"medication","type":"reference","description":"Return statements of this medication reference","expression":"(MedicationStatement.medication.ofType(Reference))","coverage":{"postgres":"pass","elasticsearch":"pass"}},{"code":"part-of","type":"reference","description":"Returns statements that are part of another event.","expression":"MedicationStatement.partOf","coverage":{"postgres":"pass","elasticsearch":"pass"}},{"code":"patient","type":"reference","description":"Returns statements for a specific patient.","expression":"MedicationStatement.subject.where(resolve() is Patient)","coverage":{"postgres":"pass","elasticsearch":"pass"}},{"code":"source","type":"reference","description":"Who or where the information in the statement came from","expression":"MedicationStatement.informationSource","coverage":{"postgres":"pass","elasticsearch":"pass"}},{"code":"status","type":"token","description":"Return statements that match the given status","expression":"MedicationStatement.status","coverage":{"postgres":"pass","elasticsearch":"pass"}},{"code":"subject","type":"reference","description":"The ide