FROM node:23-slim  AS node

# The pnpm workspace lives in frontend/ but its artifact packages sit in
# artifacts/, so both have to keep their repo-relative positions here.
COPY ./artifacts /src/artifacts
COPY ./frontend /src/frontend
WORKDIR /src/frontend
ENV CI=true
RUN corepack enable
RUN pnpm install
RUN pnpm -r run build

FROM nginx:1.31.6-alpine

RUN apk upgrade --no-cache

COPY docker/admin-app/nginx.conf.template /etc/nginx/templates/default.conf.template
COPY --from=node  /src/frontend/packages/admin-app/dist /usr/share/nginx/html

EXPOSE 80
