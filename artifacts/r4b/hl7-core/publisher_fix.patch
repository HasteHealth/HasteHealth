+        "name": "ContractPublicationStatus",
+        "status": "draft",
+        "experimental": true,
+        "date": "2017-02-13",
+        "publisher": "HL7 International",
+        "contact": [
+          {
+            "name": "FHIR project team",
+            "telecom": [
