<td>Provisional</td>\n          \n          \n          <td>This is a tentative diagnosis - still a candidate that is under consideration.</td>\n        \n        \n        </tr>\n        \n        \n        <tr>\n          \n          \n          <td>2</td>\n          \n          \n          <td style=\"white-space:nowrap\">  differential\n            \n            \n            <a name=\"condition-ver-status-differential\"> </a>\n          \n          \n          </td>\n          \n          \n          <td>Differential</td>\n          \n          \n          <td>One of a set of potential (and typically mutually exclusive) diagnoses asserted to further guide the diagnostic process and preliminary treatment.</td>\n        \n        \n        </tr>\n        \n        \n        <tr>\n          \n          \n          <td>1</td>\n          \n          \n          <td style=\"white-space:nowrap\">confirmed\n            \n            \n            <a name=\"condition-ver-status-confirmed\"> </a>\n          \n          \n          </td>\n          \n          \n          <td>Confirmed</td>\n          \n          \n          <td>There is sufficient diagnostic and/or clinical evidence to treat this as a confirmed condition.</td>\n        \n        \n        </tr>\n        \n        \n        <tr>\n          \n          \n          <td>1</td>\n          \n          \n          <td style=\"white-space:nowrap\">refuted\n            \n            \n            <a name=\"condition-ver-status-refuted\"> </a>\n          \n          \n          </td>\n          \n          \n          <td>Refuted</td>\n          \n          \n          <td>This condition has been ruled out by diagnostic and clinical evidence.</td>\n        \n        \n        </tr>\n        \n        \n        <tr>\n          \n          \n          <td>1</td>\n          \n          \n          <td style=\"white-space:nowrap\">entered-in-error\n            \n            \n            <a name=\"condition-ver-status